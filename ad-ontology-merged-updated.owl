        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">midbrain tegmentum</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001948 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000073"/>
