    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_02000122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_02000122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_02500031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_02000121"/>
            </owl:Restriction>
