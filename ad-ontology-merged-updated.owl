        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A wax that is naturally synthesized by a plant or animal.</obo:IAO_0000115>
        <dc:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cjm</dc:creator>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">natural wax</rdfs:label>
