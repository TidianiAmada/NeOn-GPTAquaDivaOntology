        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertebra endochondral element</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertebral endochondral element</oboInOwl:hasNarrowSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertebral element</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010959 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010959">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014892"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any muscle organ that is part of either the head or the neck.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">muscle of head or neck</oboInOwl:hasExactSynonym>
