            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hydrological process that results in the drainage of water from peatlands</obo:IAO_0000115>
        <obo:IAO_0000232 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Typically a part of a peat extraction process</obo:IAO_0000232>
