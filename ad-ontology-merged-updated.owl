        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the unique bone located in the glans penis of most mammals except humans; it is used for copulation and varies in size and shape by species</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">baculum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">os baculum</oboInOwl:hasExactSynonym>
