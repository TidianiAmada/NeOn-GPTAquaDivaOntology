        <ad-ontology-merged:P97>Sources of information such as libraries, databases, and websites.</ad-ontology-merged:P97>
        <rdfs:label>Information Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16203 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C43431"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Activity</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical or Research Activity</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1516654</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical_or_Research_Activity</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any specific activity undertaken during the course of a clinical study or research protocol.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C16203</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical or Research Activity</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16608 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16608">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21049"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genetic Function</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene Expression</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0017262</Thesaurus:P207>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The process by which a gene gets turned on in a cell to make RNA and proteins. Gene expression may be measured by looking at the RNA, or the protein made from the RNA, or what the protein does in a cell.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene_Expression</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expressed</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expression</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Typically involves transcription of genetically encoded information into an intermediary message (messenger RNA) and subsequent translation into a functional protein.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C16608</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene Expression</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16612 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SO_0001411"/>
        <owl:disjointWith rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17828"/>
        <owl:disjointWith rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C1908"/>
        <owl:disjointWith rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C20181"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/NCIT_C20189"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/NCIT_C26548"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/NCIT_C43431"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene or Genome</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0017337</Thesaurus:P207>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The functional and physical unit of heredity passed from parent to offspring. Genes are pieces of DNA, and most genes contain the information for making a specific protein.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genes</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A functional unit of heredity which occupies a specific position on a particular chromosome and serves as the template for a product that contributes to a phenotype or a biological function.</Thesaurus:P97>
        <Thesaurus:P98 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The gene as a functional unit consists of a discrete segment of a giant DNA molecule containing the purine (adenine and guanine) and pyrimidine (cytosine and thymine) bases in the ordered and correct sequence that encodes a specific functional product (i.e., a protein or RNA molecule).</Thesaurus:P98>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C16612</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17050 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17050">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C18102"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Natural Phenomenon or Process</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic Radiation</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0034519</Thesaurus:P207>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiation that has both electric and magnetic fields and travels in waves. It comes from natural and man-made sources. Electromagnetic radiation can vary in strength from low energy to high energy. It includes radio waves, microwaves, infrared light, visible light, ultraviolet light, x-rays, and gamma rays.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic_Radiation</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMR</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiation</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiation, Electromagnetic</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiation-Total</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">radiation (unspecified type)</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The radiation of energy as transverse waves produced by moving charges.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C17050</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic Radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17053 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17053">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17050"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Natural Phenomenon or Process</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nonionizing Radiation</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0034539</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nonionizing_Radiation</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiation Non-Ionizing, Other</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiation, Non-Ionizing</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiation, Nonionizing</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiation-Non-Ionizing Total</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Electromagnetic radiation which does not produce ions in matter through which it passes. Its wavelengths are generally greater than those of far ultraviolet radiation and range through the longest radio waves.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C17053</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nonionizing Radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C171091 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C171091">
        <owl:equivalentClass rdf:resource="http://www.aquadiva.uni-jena.de/ad-ontology/ad-ontology.0.0/ad-ontology-entities.owl#StructuralProperty"/>
