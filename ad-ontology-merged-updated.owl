        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The cortical collecting duct is the portion of the collecting duct that resides in the renal cortex</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney cortex collecting duct</oboInOwl:hasExactSynonym>
