        <ad-ontology-merged:NHC0>C15426</ad-ontology-merged:NHC0>
        <ad-ontology-merged:P106>Intellectual Product</ad-ontology-merged:P106>
        <ad-ontology-merged:P108>Database</ad-ontology-merged:P108>
        <ad-ontology-merged:P207>C0242356</ad-ontology-merged:P207>
        <ad-ontology-merged:P322>CDISC-GLOSS</ad-ontology-merged:P322>
        <ad-ontology-merged:P325>A collection of data or information, typically organized for ease and speed of search and retrieval.</ad-ontology-merged:P325>
        <ad-ontology-merged:P366>Database</ad-ontology-merged:P366>
        <ad-ontology-merged:P90>DB</ad-ontology-merged:P90>
        <ad-ontology-merged:P90>Data Bank</ad-ontology-merged:P90>
        <ad-ontology-merged:P90>Database</ad-ontology-merged:P90>
        <ad-ontology-merged:P90>Database, Electronic</ad-ontology-merged:P90>
        <ad-ontology-merged:P90>database</ad-ontology-merged:P90>
        <ad-ontology-merged:P97>An information set with a regular structure.  Although it can be applied to any set of information the term was invented to refer to computerized data, and is used almost exclusively in computing.</ad-ontology-merged:P97>
        <rdfs:label>Database</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16048 -->

