        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">choroid plexus telencephalic ventricle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lateral ventricle chorioid plexus of cerebral hemisphere</oboInOwl:hasExactSynonym>
