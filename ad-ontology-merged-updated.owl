        <obo:IAO_0000232 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AR: Grant isn&apos;t a plan specification, it has a part which is a plan specification. See tracker: https://sourceforge.net/tracker/?func=detail&amp;aid=3483338&amp;group_id=177891&amp;atid=886178</obo:IAO_0000232>
        <rdfs:label xml:lang="en">grant</rdfs:label>
    </owl:Class>
    


