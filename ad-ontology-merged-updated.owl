        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">muscle structure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0005095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005095">
