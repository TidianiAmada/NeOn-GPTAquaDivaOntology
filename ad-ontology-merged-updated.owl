        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004733"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rostral segment of the hindbrain that has as its parts the pons (where present) and the cerebellum[WP,modified].</obo:IAO_0000115>
