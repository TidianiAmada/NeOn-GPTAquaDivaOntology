    <!-- http://purl.obolibrary.org/obo/UBERON_0009847 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009847">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000077"/>
