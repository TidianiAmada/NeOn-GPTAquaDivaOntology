        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Types_of_volcanic_eruptions</oboInOwl:hasDbXref>
    </owl:Axiom>
    


