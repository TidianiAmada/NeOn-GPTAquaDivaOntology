    <!-- http://purl.obolibrary.org/obo/ENVO_00000134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00001998"/>
