        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bohla et al., (September 2014). &quot;A functional insulator screen identifies NURF and dREAM components to be required for enhancer-blocking.&quot; PLoS One 9(9):e107765. doi: 10.1371/journal.pone.0107765.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
