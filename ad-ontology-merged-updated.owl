        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">secondary nodular lymphoid tissue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001746 -->

