        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">alveolar system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0006534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007685"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any region of a nephron tubule that is convoluted. Examples: distal convoluted tubule, proximal convoluted tuble.</obo:IAO_0000115>
