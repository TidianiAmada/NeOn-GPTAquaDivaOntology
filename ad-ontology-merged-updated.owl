                                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000990"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
