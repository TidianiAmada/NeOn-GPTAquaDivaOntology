        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002186"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the last conducting structure of non-respiratory bronchioles; after this point, the airways have alveoli in their walls</obo:IAO_0000115>
