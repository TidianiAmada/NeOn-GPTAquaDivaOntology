        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015021"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bone that is part of a forelimb region. Examples: humerus, any of the phalanges. Counter-example: scapula (a bone of the pectoral girdle). Note that we consider the forelimb to end at the shoulder.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">free forelimb bone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wing bone</oboInOwl:hasNarrowSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">forelimb bone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0008969 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005087"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The dental follicle is a sac containing the developing tooth and its odontogenic organ. The dental follicle (DF) differentiates into the periodontal ligament. In addition, it may be the precursor of other cells of the periodontium, including osteoblasts, cementoblasts and fibroblasts. They develop into the alveolar bone, the cementum with Sharpey&apos;s fibers and the periodontal ligament fibers respectively.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dental sac</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tooth follicle</oboInOwl:hasRelatedSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dental follicle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0008987 -->

