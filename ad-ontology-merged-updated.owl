    <!-- http://purl.obolibrary.org/obo/ENVO_00000473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000473">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
