        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ENVO:02000026</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">chyme</rdfs:label>
    </owl:Class>
