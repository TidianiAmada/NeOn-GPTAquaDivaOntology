        <obo:IAO_0000119 xml:lang="en">OBI, OBIB</obo:IAO_0000119>
        <dc:source xml:lang="en">Biobank</dc:source>
        <rdfs:label xml:lang="en">specimen family creation</rdfs:label>
    </owl:Class>
    


