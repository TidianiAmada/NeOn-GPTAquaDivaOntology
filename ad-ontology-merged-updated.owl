        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007832"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The organism subdivision that includes the pelvic girdle skeleton and associated soft tissue. Note that this includes both the skeletal elements and associated tissues (integument, muscle, etc). Examples: There are only two instances in an organism, right and left pectoral girdle regions.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">girdle - pelvic</oboInOwl:hasRelatedSynonym>
