    <!-- http://purl.obolibrary.org/obo/UBERON_0013526 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0013526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002553"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007473"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A anatomical cavity that is part of a ear vesicle.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lumen of otocyst</oboInOwl:hasExactSynonym>
