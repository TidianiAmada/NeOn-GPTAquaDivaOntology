        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBI</obo:IAO_0000119>
        <rdfs:label xml:lang="en">unplanned occurrence effecting an investigation</rdfs:label>
    </owl:Class>
    


