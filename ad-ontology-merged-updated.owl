                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0400079"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0400082"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000397"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">image cytometer</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The most common current application of image cytometry is for DNA analysis, followed by quantitation of immunohistochemical staining.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">An image_cytometer is an instrument for image-based study or measurement of cells.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Melanie Courtot</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">http://web.mit.edu/solab/Research/ImageCytometry.html</obo:IAO_0000119>
        <rdfs:label xml:lang="en">image cytometer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0400137 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0400137">
