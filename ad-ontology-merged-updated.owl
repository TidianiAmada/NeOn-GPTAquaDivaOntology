    <!-- http://purl.obolibrary.org/obo/UBERON_0002186 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000117"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the conducting airway of the lungs found terminal to the bronchi; these structures contain neither cartilage nor mucous-secreting glands; the epithelium of the bronchioles becomes thinner with each branching</obo:IAO_0000115>
