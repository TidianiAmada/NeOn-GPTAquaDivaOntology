        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">preparative chromatography</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The use of gas chromatography in order separate out from an input sample of eggs a fraction that would be enriched for pesticides.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">the use of a biomaterial&apos;s preferential affinity for either the mobile phase or the stationary phase to separate it from other materials of differing affinity</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy; Bjoern Peters</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
