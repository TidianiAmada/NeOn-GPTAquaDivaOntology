        <obo:IAO_0000112 xml:lang="en">The DNA fragment encoding the p35 gene from Mycobacterium avium complex was inserted into pcDNAII and expressed in E coli in order to study p35.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
