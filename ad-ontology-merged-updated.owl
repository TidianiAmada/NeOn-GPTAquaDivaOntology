        <ad-ontology-merged:definition>&lt;ncicp:ComplexDefinition xmlns:ncicp=&quot;http://ncicb.nci.nih.gov/xml/owl/EVS/ComplexProperties.xsd#&quot;&gt;&lt;ncicp:def-definition&gt;A technique used for incubating mixtures in an assay.&lt;/ncicp:def-definition&gt;&lt;/ncicp:ComplexDefinition&gt;</ad-ontology-merged:definition>
