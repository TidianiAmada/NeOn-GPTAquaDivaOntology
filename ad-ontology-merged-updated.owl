    <!-- http://purl.obolibrary.org/obo/OBI_0000834 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000834">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001051"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high molecular weight DNA extract</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extraction of chromosomal DNA from mammalian cells by first isolating nucei</obo:IAO_0000112>
