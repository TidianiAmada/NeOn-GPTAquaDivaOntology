    <!-- http://purl.obolibrary.org/obo/UBERON_0001282 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003704"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014716"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the tubules located between the bile canaliculi and interlobular bile ducts near the outer edge of a classic liver lobule</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">canal of Herring</oboInOwl:hasExactSynonym>
