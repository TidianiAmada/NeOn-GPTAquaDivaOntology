        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The His-Purkinje system receives signals from the AV node and is composed of the fibers that regulate cardiac muscle contraction in the ventricles</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HPS</oboInOwl:hasExactSynonym>
