    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034925">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000465"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A collection of anatomical structures that are alike in terms of their morphology or developmental origin.</obo:IAO_0000115>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anatomical collection</rdfs:label>
