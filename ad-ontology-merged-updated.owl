        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rodent care  is the process by which rodents are being provided with a controlled living environment while kept in captivity for the purpose of research.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PPPB branch</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PPPB branch</obo:IAO_0000119>
