        <obo:IAO_0000111 xml:lang="en">genotyping assay</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">High-throughput genotyping of oncogenic human papilloma viruses with MALDI-TOF mass spectrometry. Clin Chem. 2008 Jan;54(1):86-92. Epub 2007 Nov 2.PMID: 17981923</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">an assay which generates data about a genotype from a specimen of genomic DNA. A variety of
techniques and instruments can be used to produce information about sequence variation at particular genomic positions.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Philippe Rocca-Serra</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">genotype profiling, SNP genotyping</obo:IAO_0000118>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBI Biomaterial</obo:IAO_0000119>
        <obo:OBI_0001847 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SNP analysis</obo:OBI_0001847>
        <rdfs:label xml:lang="en">genotyping assay</rdfs:label>
    </owl:Class>
    


