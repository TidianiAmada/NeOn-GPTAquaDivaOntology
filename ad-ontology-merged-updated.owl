        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a reference participant role which is realized by making the reference to qualities at the start of the study or intervention</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Person: Jennifer Fostel</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">baseline participant</obo:IAO_0000118>
        <rdfs:label xml:lang="en">baseline participant role</rdfs:label>
    </owl:Class>
    


