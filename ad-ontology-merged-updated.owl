    <!-- http://purl.obolibrary.org/obo/UBERON_0011108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002217"/>
