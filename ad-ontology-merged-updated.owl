        <oboInOwl:hasDefinition>A battery is a power source that serves as a central source of electrical energy for more than one circuit.  It can also pertain to the use of a single electrical power source to energize more than one circuit, component, equipment, or system.</oboInOwl:hasDefinition>
        <rdfs:label rdf:datatype="http://www.aquadiva.uni-jena.de/ad-ontology/ad-ontology.0.0/string">battery</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/CSP/0418-1882 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/CSP/0418-1882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A human being&apos;s gut microbiota contains tens of trillions of microorganisms, including at least 1000 different species of known bacteria with more than 3 million genes (150 times more than human genes). Microbiota can, in total, weigh up to 2 kg. One third of our gut microbiota is common to most people, while two thirds are specific to each one of us. In other words, the microbiota in your intestine is like an individual identity card. URL: http://www.gutmicrobiotaforhealth.com/en/about-gut-microbiota-info/ A microbiome located in a human gut.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biological signal transduction</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biological system</rdfs:synonym>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sensor (biological)</rdfs:synonym>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/MESH/C094886 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/MESH/C094886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_46662"/>
        <ad-ontology-merged:FR>486</ad-ontology-merged:FR>
        <ad-ontology-merged:HM>D008903</ad-ontology-merged:HM>
        <ad-ontology-merged:HM>D058085</ad-ontology-merged:HM>
        <ad-ontology-merged:MDA>19950831</ad-ontology-merged:MDA>
        <ad-ontology-merged:MMR>20100625</ad-ontology-merged:MMR>
        <ad-ontology-merged:RN>1310-14-1</ad-ontology-merged:RN>
        <ad-ontology-merged:SC>1</ad-ontology-merged:SC>
        <ad-ontology-merged:SRC>Exp Cell Res 1995 Jul;219(1):137-45</ad-ontology-merged:SRC>
        <ad-ontology-merged:TERMUI>T279934</ad-ontology-merged:TERMUI>
        <ad-ontology-merged:TERMUI>T674626</ad-ontology-merged:TERMUI>
        <ad-ontology-merged:TH>NLM (1995)</ad-ontology-merged:TH>
        <ad-ontology-merged:TH>NLM (2006)</ad-ontology-merged:TH>
        <rdfs:label>Goethite</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/MESH/D001669 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/MESH/D001669">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/MESH/D055598"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The chemical processes, enzymatic activities, and pathways of living things and related temporal, dimensional, qualitative, and quantitative concepts.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biochemical Phenomena</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biochemical Processes</rdfs:synonym>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/MESH/D013499 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/MESH/D013499">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25336"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Characteristics or attributes of the outer boundaries of objects, including molecules.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surface property</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/MESH/D055598 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/MESH/D055598">
        <rdfs:subClassOf rdf:resource="http://sweetontology.net/phen/Phenomena"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The physical phenomena and properties underlying the structure of atoms and molecules, and their reaction and interaction processes.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemical Phenomena</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical chemistry</rdfs:synonym>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/MESH/D055601 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/MESH/D055601">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/MESH/D055598"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The conformation, properties, reaction processes, and the properties of the reactions of organic carbon compounds.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organic Chemistry Phenomena</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/MESH/D055669 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/MESH/D055669">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/MESH/D001669"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ecological and environmental entities, characteristics, properties, relationships and processes.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ecological and Environmental Phenomena</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ecological and Environmental Concepts</rdfs:synonym>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/MESH/D058440 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/MESH/D058440">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/MESH/D058458"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nitrate reduction process generally mediated by anaerobic bacteria by which nitrogen available to plants is converted to a gaseous form and lost from the soil or water column. It is a part of the nitrogen cycle</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Denitrifications</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/MESH/D058458 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/MESH/D058458">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/MESH/D001669"/>
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/MESH/D055601"/>
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/MESH/D055669"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25555"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002434"/>
                <owl:someValuesFrom rdf:resource="http://www.aquadiva.uni-jena.de/ad-ontology/ad-ontology.0.0/ad-ontology-entities.owl#GroundWater"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The circulation of nitrogen in nature, consisting of a cycle of biochemical reactions in which atmospheric nitrogen is compounded, dissolved in rain, and deposited in the soil, where it is assimilated and metabolized by animals, plants, bacteria, and fungi, eventually returning to the atmosphere by bacterial decomposition of organic matter.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nitrogen cycle</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N cycle</rdfs:synonym>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">N-cycle</rdfs:synonym>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nitrogen-cycle</rdfs:synonym>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/MESH/D058465 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/MESH/D058465">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/MESH/D058458"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process facilitated by specialized bacteria involving the oxidation of ammonium to nitrite and nitrate</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nitrifications</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/npo#NPO_1405 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/npo#NPO_1405">
        <rdfs:subClassOf rdf:resource="http://purl.bioontology.org/ontology/npo#NPO_1406"/>
        <ad-ontology-merged:DesignNote rdf:datatype="http://www.aquadiva.uni-jena.de/ad-ontology/ad-ontology.0.0/string">[DGT, June 10, 2010]: Description for a specific type of technique could contain the following types of information: 1) principle used in the technique (e.g. NMR for NMR spectroscopy), 2) description of the principle if the term that describes the principle is not represented in the ontology, 3) tool used in a technique (e.g., scanning electron microscope in scanning electron miroscopy), 4) applications of the technique, and 5) information on how to use the technique for each type of application.</ad-ontology-merged:DesignNote>
        <ad-ontology-merged:code>NPO_1405</ad-ontology-merged:code>
        <ad-ontology-merged:definition>&gt;&lt;ncicp:ComplexDefinition&gt;&lt;ncicp:def-definition&gt;A systematic procedure or a practical method which is used for accomplishing a task.&lt;/ncicp:def-definition&gt;&lt;/ncicp:ComplexDefinition&gt;</ad-ontology-merged:definition>
        <ad-ontology-merged:preferred_Name rdf:datatype="http://www.aquadiva.uni-jena.de/ad-ontology/ad-ontology.0.0/string">technique</ad-ontology-merged:preferred_Name>
        <rdfs:label>technique</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.bioontology.org/ontology/npo#NPO_1406 -->

    <owl:Class rdf:about="http://purl.bioontology.org/ontology/npo#NPO_1406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <ad-ontology-merged:code rdf:datatype="http://www.aquadiva.uni-jena.de/ad-ontology/ad-ontology.0.0/string">NPO_1406</ad-ontology-merged:code>
        <ad-ontology-merged:definition>&lt;ncicp:ComplexDefinition xmlns:ncicp=&quot;http://ncicb.nci.nih.gov/xml/owl/EVS/ComplexProperties.xsd#&quot;&gt;&lt;ncicp:def-definition&gt;A process which is an established way of doing something.&lt;/ncicp:def-definition&gt;&lt;/ncicp:ComplexDefinition&gt;</ad-ontology-merged:definition>
        <ad-ontology-merged:preferred_Name rdf:datatype="http://www.aquadiva.uni-jena.de/ad-ontology/ad-ontology.0.0/string">procedure</ad-ontology-merged:preferred_Name>
        <ad-ontology-merged:synonym rdf:datatype="http://www.aquadiva.uni-jena.de/ad-ontology/ad-ontology.0.0/string">method</ad-ontology-merged:synonym>
        <rdfs:label rdf:datatype="http://www.aquadiva.uni-jena.de/ad-ontology/ad-ontology.0.0/string">procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.dataone.org/odo/ECSO_00000306 -->

    <owl:Class rdf:about="http://purl.dataone.org/odo/ECSO_00000306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0100026"/>
        <obo:IAO_0000115>An organism that consist of more than one cell</obo:IAO_0000115>
        <obo:IAO_0000119>http://en.wikipedia.org/wiki/Multicellular_organism</obo:IAO_0000119>
        <dc:contributor rdf:resource="http://orcid.org/0000-0002-5896-7295"/>
        <oboInOwl:hasExactSynonym xml:lang="en">multi-cellular organism; whole organism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">animal</oboInOwl:hasNarrowSynonym>
        <rdfs:label>Multi-Celled Organism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.dataone.org/odo/ECSO_00000501 -->

    <owl:Class rdf:about="http://purl.dataone.org/odo/ECSO_00000501">
        <rdfs:subClassOf rdf:resource="http://purl.dataone.org/odo/ECSO_00000306"/>
        <obo:IAO_0000115>In botany, a tree is a perennial plant with an elongated stem, or trunk, supporting branches and leaves in most species.</obo:IAO_0000115>
        <obo:IAO_0000119>http://en.wikipedia.org/wiki/Tree</obo:IAO_0000119>
        <dc:creator rdf:resource="http://orcid.org/0000-0002-1693-8322"/>
        <dc:description>a tall perennial woody plant having a main trunk and branches forming a distinct elevated crown; includes both gymnosperms and angiosperms</dc:description>
        <rdfs:label>Tree</rdfs:label>
        <rdfs:seeAlso>sapling</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.dataone.org/odo/ECSO_00000549 -->

    <owl:Class rdf:about="http://purl.dataone.org/odo/ECSO_00000549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Domain protocol for measuring the diameter of a tree. Measured at a specified, average distance from the ground, eg 4.5 ft (or average person&apos;s breast height). May be measured as circumference, then divided by pi.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tree diameter at breast height</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DBH</rdfs:synonym>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diameter at breast height</rdfs:synonym>
    </owl:Class>
    


    <!-- http://purl.dataone.org/odo/ECSO_00000629 -->

    <owl:Class rdf:about="http://purl.dataone.org/odo/ECSO_00000629">
        <rdfs:subClassOf rdf:resource="http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#MeasurementType"/>
        <obo:IAO_0000115>any contrast of two quantities, one with another-- e.g. to express seeing 222 rabbits per every 10 coyotes, you could use:
222/10
222:10
22.2</obo:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0003-0632-7576"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-09-14T22:51:05Z</dc:date>
        <rdfs:label xml:lang="en">ratio measurement type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.dataone.org/odo/ECSO_00001102 -->

    <owl:Class rdf:about="http://purl.dataone.org/odo/ECSO_00001102">
        <rdfs:subClassOf rdf:resource="http://purl.dataone.org/odo/ECSO_00000629"/>
        <obo:IAO_0000115>the quotient obtained when the magnitude of a part is divided by the magnitude of the whole, or the ratio obtained in the contrast of two values, where the value of the numerator is added together with that of the contrasting value in the denominator</obo:IAO_0000115>
        <dc:creator rdf:resource="http://orcid.org/0000-0002-5896-7295"/>
        <rdfs:label>proportion_measurementType</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.dataone.org/odo/ECSO_00001138 -->

    <owl:Class rdf:about="http://purl.dataone.org/odo/ECSO_00001138">
        <rdfs:subClassOf rdf:resource="http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#MeasurementType"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25555"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27594"/>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carbon-nitrogen ratio</Thesaurus:P90>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carbon-to-nitrogen ratio is a ratio of the mass of carbon to the mass of nitrogen in a substance. It can, amongst other things, be used in analysing sediments and compost. A useful application for C/N ratios is as a proxy for paleoclimate research, having different uses whether the sediment cores are terrestrial-based or marine-based. Carbon-to-nitrogen ratios are an indicator for nitrogen limitation of plants and other organisms and can identify whether molecules found in the sediment under study come from land-based or algal plants. Further, they can distinguish between different land-based plants, depending on the type of photosynthesis they undergo.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carbon to nitrogen ratio</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C to N ratio</rdfs:synonym>
    </owl:Class>
    


    <!-- http://purl.dataone.org/odo/ECSO_00001156 -->

    <owl:Class rdf:about="http://purl.dataone.org/odo/ECSO_00001156">
        <rdfs:subClassOf rdf:resource="http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#MeasurementType"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000047"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leaf area index (LAI) is a dimensionless quantity that characterizes plant canopies. It is defined as the one-sided green leaf area per unit ground surface area (LAI = leaf area / ground area, m2 / m2) in broadleaf canopies.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leaf area index</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LAI</rdfs:synonym>
    </owl:Class>
    


    <!-- http://purl.dataone.org/odo/ECSO_00001198 -->

    <owl:Class rdf:about="http://purl.dataone.org/odo/ECSO_00001198">
        <rdfs:subClassOf rdf:resource="http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#MeasurementType"/>
        <obo:IAO_0000115>The density, or more precisely, the volumetric mass density, of a substance is its mass per unit volume.</obo:IAO_0000115>
        <obo:IAO_0000119>Adapted from
http://en.wikipedia.org/wiki/Density</obo:IAO_0000119>
        <rdfs:label>Mass Density Measurement Type</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.dataone.org/odo/ECSO_00001207 -->

    <owl:Class rdf:about="http://purl.dataone.org/odo/ECSO_00001207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001595"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Depth of soil, which is a mixture of minerals, organic matter, gases, liquids, and countless organisms that together support life on Earth.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Soil depth</rdfs:label>
    </owl:Class>
    


