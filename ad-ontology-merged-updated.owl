        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">URL:http://www.cdc.gov/oralhealth/infectioncontrol/glossary.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


