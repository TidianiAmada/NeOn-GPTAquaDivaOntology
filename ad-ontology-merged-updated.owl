        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A site at the terminus of a liquid conveyance conduit where the liquid carried is discharged into the sea or a river.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">overfall</oboInOwl:hasBroadSynonym>
        <rdfs:label xml:lang="en">mouth of liquid discharge conduit</rdfs:label>
    </owl:Class>
