    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001013"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Connective tissue consisting of fat-storing cells and arranged in lobular groups or along minor blood vessels[MP,modified]</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adipocytus unigutturalis</oboInOwl:hasExactSynonym>
