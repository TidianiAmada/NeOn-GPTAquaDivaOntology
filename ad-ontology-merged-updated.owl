    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010996 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010996">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001994"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A thin layer of cartilage, usually hyaline, on the articular surface of bones in synovial joints.</obo:IAO_0000115>
