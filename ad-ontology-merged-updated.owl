    <!-- http://purl.obolibrary.org/obo/UBERON_0034921 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034921">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010000"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An multicellular anatomical structure that has subparts of multiple organs as a part.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anatomical cluster</oboInOwl:hasRelatedSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">multi organ part structure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0034922 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034922">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010000"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cluster of cells, largely surrounded by a morphological boundary.</obo:IAO_0000115>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell cluster</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0034923 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034923">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000465"/>
