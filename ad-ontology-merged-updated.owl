        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subdivision of skeleton which which consists of all the skeletal elements in in the pectoral and pelvic appendage complexes[cjm].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">appendicular skeleton</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">entire appendicular skeleton</oboInOwl:hasExactSynonym>
