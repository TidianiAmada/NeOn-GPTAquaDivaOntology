            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">experimental disease induction</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">the injection of mice with LCM virus iv to establish an LCMV infection. Witholding food from animals to induce starvation syndrome.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">a protocol application to induce a specific disease in an organism</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PlanAndPlannedProcess Branch</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <obo:IAO_0000232 xml:lang="en">could be defined class</obo:IAO_0000232>
        <rdfs:label xml:lang="en">experimental disease induction</rdfs:label>
    </owl:Class>
    


