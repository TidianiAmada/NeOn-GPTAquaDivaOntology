        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">conjunctiva</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001817 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001817">
