            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluorescein</obo:IAO_0000111>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A xanthene dye that is highly fluorescent, detectable even when present in minute quantities. Used forensically to detect traces of blood, in analytical chemistry as an indicator in silver nitrate titrations and in microscopy.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/chebi.owl"/>
