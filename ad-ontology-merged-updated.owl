        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">A packed column is a chromatography column where the particles of the solid stationary phase or the support coated with a liquid stationary phase may fill the whole inside volume of the tube.</obo:IAO_0000115>
