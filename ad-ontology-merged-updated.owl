        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">concentrate</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Evaporation of the solution containing DNA to increase the concentration of the DNA molecules</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">a protocol application to create an output material with an increased density of a material of interest that is part of the input material by separating other parts of the input material</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <rdfs:label xml:lang="en">concentrate</rdfs:label>
    </owl:Class>
    


