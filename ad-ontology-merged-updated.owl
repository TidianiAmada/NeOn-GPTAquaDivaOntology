        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007844"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010913"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The cartilaginous form of a vertebral element, a skeletal element that forms around the notochord and is part of the vertebral column.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertebral cartilage condensation</oboInOwl:hasExactSynonym>
