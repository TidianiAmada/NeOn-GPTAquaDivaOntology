    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0400114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001033"/>
        <rdfs:subClassOf>
            <owl:Restriction>
