    <!-- http://purl.obolibrary.org/obo/OBI_0100016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0100016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000953"/>
