        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prostate duct</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002493 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001190"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005156"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010192"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015212"/>
