        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">selection by survival</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The insertion of a gene for antibiotic resistance into a cell population and subsequent growth in the presence of the antibiotic to select for those cells which were successfully transfected</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">the use of environmental conditions to select for the organism or cells that have a certain trait</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <rdfs:label xml:lang="en">selection by survival</rdfs:label>
    </owl:Class>
    


