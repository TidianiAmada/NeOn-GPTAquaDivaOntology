            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">solute role</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">PMID: 18380397.Pharmazie. 2008 Feb;63(2):113-21.Deviations of drug solubility in water-cosolvent mixtures from the Jouyban-Acree model--effect of solute structure.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">solute role is a role played by a chemical entity which is dissolved by another chemical entity (the solvent) when creating a solution</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Philippe Rocca-Serra</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adapted from wikipedia (http://en.wikipedia.org/wiki/Solute)</obo:IAO_0000119>
        <rdfs:label xml:lang="en">solute role</rdfs:label>
    </owl:Class>
    


