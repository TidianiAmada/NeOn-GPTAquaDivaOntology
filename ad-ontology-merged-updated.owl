        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exocrine gland acinus</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acinus of exocrine gland</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011860 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000476"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collection of collagen fibrils</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011861 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011860"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The connective tissue bundles in the extracellular matrix of aorta tissue that are composed of collagen, and play a role in tissue strength and elasticity</obo:IAO_0000115>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aorta collagen fibril</rdfs:label>
