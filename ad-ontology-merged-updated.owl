        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An experiment that tests  if inducing an epitope specific immune response in an organism has an effect, such as the ability to prevent, treat or excarbate diseases in the organism.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bjoern Peters</obo:IAO_0000117>
        <obo:OBI_9991118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">efficacy of in vivo intervention</obo:OBI_9991118>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">efficacy of epitope intervention experiment</rdfs:label>
    </owl:Class>
    


