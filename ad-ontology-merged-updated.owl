    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000729">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000430"/>
