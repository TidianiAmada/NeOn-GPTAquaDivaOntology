        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diencephalon</oboInOwl:hasRelatedSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diencephalon</rdfs:label>
