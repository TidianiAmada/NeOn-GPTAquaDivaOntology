        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vitreous humour</oboInOwl:hasRelatedSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vitreous humor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001798 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003566"/>
