        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">olfactory bulb</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002268">
