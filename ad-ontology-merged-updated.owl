    <!-- http://purl.obolibrary.org/obo/UBERON_0002529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010538"/>
