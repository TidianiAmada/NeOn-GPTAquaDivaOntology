        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">Hardware_testing_objective is a methodology_testing_objective role describing a study designed to examine the effects of using different hardware, e.g. scanner.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Jennifer Fostel</obo:IAO_0000117>
        <rdfs:label xml:lang="en">hardware testing objective</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000136 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0002089"/>
