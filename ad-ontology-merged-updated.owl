        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portal venous tree organ part</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portal vein</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006915"/>
