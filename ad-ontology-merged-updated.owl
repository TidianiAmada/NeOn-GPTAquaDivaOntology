        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesenchyme from splanchnopleure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010380 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010380">
