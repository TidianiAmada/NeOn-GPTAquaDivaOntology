            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An effusive eruption is a volcanic eruption during which lava flows onto the ground.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:datatype="http://www.w3.org/2001/XMLSchema#string">environmental_hazards</oboInOwl:inSubset>
        <rdfs:label xml:lang="en">effusive eruption</rdfs:label>
    </owl:Class>
