                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000744"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A solar panel array that is integrated into the power system of a human dwelling.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">domestic photovoltaic panel array</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">domestic solar panel array</rdfs:label>
    </owl:Class>
    


