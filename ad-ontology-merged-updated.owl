    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21049 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21049">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C28498"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genetic Function</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene Expression Process</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1517486</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene_Expression_Process</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any subcellular or molecular event or process specifically, primarily, and directly designed for and involved in the production of mature functional biomolecular products encoded by a gene.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C21049</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene Expression Process</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21079 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21079">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C28498"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000079"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0100026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any subcellular or molecular process involved in translocation of a biological entity, such as a macromolecule, from one site or compartment to another.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C21079</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transport process</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular transport</rdfs:synonym>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transport Reaction</rdfs:synonym>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21198 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21198">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C19536"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phenomenon or Process</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intermediary Metabolic Process</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0025519</Thesaurus:P207>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The chemical changes that take place in a cell or an organism. These changes make energy and the materials cells and organisms need to grow, reproduce, and stay healthy. Metabolism also helps get rid of toxic substances.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intermediary_Metabolism</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intermediary Metabolism</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Metabolism</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">All the reactions in an organism concerned with storing and generating metabolic energy and with the biosynthesis of low-molecular weight compounds, energy-storage compounds, and basic materials needed for important life processes. It does not include nucleic acid and protein synthesis.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C21198</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intermediary Metabolic Process</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21240 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21240">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16612"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R37"/>
                <owl:someValuesFrom rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C30022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene or Genome</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Translation Process Gene</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1336806</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Translation_Process_Gene</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genes that encode products which participate in translation, a complex mechanism that occurs on ribosomes. During this process, a peptide or protein is synthesized by utilizing an mRNA transcript to specify the sequence of amino acids in the resulting polypeptide. There are numerous translation process genes, as the synthesis of polypeptides requires ribosomal RNA, transfer RNA, GTP and proteins involved specifically in the activation of amino acids, initiation of synthesis, elongation and termination of synthesis.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C21240</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Translation Process Gene</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21599 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21599">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12219"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conceptual Entity</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microanatomic Structure</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1513264</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microanatomy</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microanatomy</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microscopic Anatomy</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Those anatomic structures that are generally only visible through the use of microscopy.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C21599</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microanatomic Structure</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25198 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25198">
