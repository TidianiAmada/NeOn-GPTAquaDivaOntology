    <!-- http://purl.obolibrary.org/obo/UBERON_0005432 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001637"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>
