    <!-- http://purl.obolibrary.org/obo/IAO_0000326 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000314"/>
        <obo:IAO_0000111 xml:lang="en">supplementary material to a document</obo:IAO_0000111>
