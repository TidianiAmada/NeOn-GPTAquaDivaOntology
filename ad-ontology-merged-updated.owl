        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">layer of retina</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001782 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000957"/>
