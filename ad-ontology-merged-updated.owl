        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Superkingdom</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1883221</Thesaurus:P207>
