        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bone collagen fibril</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011864 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011864">
