    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12508 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12508">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21599"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell</Thesaurus:P106>
        <Thesaurus:P107 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Types</Thesaurus:P107>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0007634</Thesaurus:P207>
        <Thesaurus:P322 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCUM</Thesaurus:P322>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The individual unit that makes up all of the tissues of the body. All living things are made up of one or more cells.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Type</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Types</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cells</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cellular</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Normal Cell</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{Cells}</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The smallest units of living structure capable of independent existence, composed of a membrane-enclosed mass of protoplasm and containing a nucleus or nucleoid.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C12508</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13197 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13197">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14135"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R82"/>
                <owl:someValuesFrom rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C43596"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nucleus</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0007610</Thesaurus:P207>
        <Thesaurus:P322 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CDISC</Thesaurus:P322>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A body within the cell, surrounded by a membrane, within which lie the chromosomes, one or more nucleoli, combined with proteins, and exhibits mitosis. (NCI)</Thesaurus:P325>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In biology, the structure in a cell that contains the chromosomes. The nucleus has a membrane around it, and is where RNA is made from the DNA in the chromosomes.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nucleus</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Nucleus</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nucleic</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A body within the cell, surrounded by a membrane, within which lie the chromosomes, one or more nucleoli, combined with proteins, and exhibits mitosis.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13197</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13201 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13201">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C34070"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R82"/>
                <owl:someValuesFrom rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13197"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromatin</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0008546</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromatin</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The genetic material of the nucleus, consisting of deoxyribonucleoprotein, which occurs in two forms during the phase between mitotic divisions: 1) as heterochromatin, seen as condensed, readily stainable clumps; 2) as euchromatin, dispersed lightly staining or nonstaining material. During mitotic division the chromatin condenses into chromosomes.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13201</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromatin</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13202 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13202">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13404"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R82"/>
                <owl:someValuesFrom rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13201"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromosome</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0008633</Thesaurus:P207>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Part of a cell that contains genetic information. Except for sperm and eggs, all human cells contain 46 chromosomes.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromosome</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromosomal</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One of the bodies in the cell nucleus that is the bearer of genes, has the form of a delicate chromatin filament during interphase, contracts to form a compact cylinder segmented into two arms by the centromere during metaphase and anaphase stages of cell division, and is capable of reproducing its physical and chemical structure through successive cell divisions.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13202</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromosome</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13226 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13226">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14135"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R82"/>
                <owl:someValuesFrom rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C43596"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cytoplasm</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0010834</Thesaurus:P207>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The fluid inside a cell but outside the cell&apos;s nucleus.  Most chemical reactions in a cell take place in the cytoplasm.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cytoplasm</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cytoplasmic</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">That portion of the cell contained within the plasma membrane but excluding the nucleus.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13226</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cytoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13230 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13230">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C33089"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Endoplasmic Reticulum</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0014239</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Endoplasmic_Reticulum</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ER</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The endoplasmic reticulum is a network of tubular membranes within the cytoplasm of the cell, occurring either with a smooth surface (smooth endoplasmic reticulum) or studded with ribosomes (rough endoplasmic reticulum), involved in the transport of materials. (Infoplease Dictionary)</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13230</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Endoplasmic Reticulum</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13269 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13269">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C34070"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R82"/>
                <owl:someValuesFrom rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13226"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cytoplasmic Organelle</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1179962</Thesaurus:P207>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A small structure in a cell that is surrounded by a membrane and has a specific function. Examples of organelles are the nucleus (a structure that contains the cell&apos;s chromosomes and is where RNA is made), mitochondria (structures that make energy for the cell), and lysosomes (sac-like containers filled with enzymes that digest and help recycle molecules in the cell).</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cytoplasmic_Organelle</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organelle</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell part which consists of macromolecules aggregated into discrete structures in the protoplasm. (Digital Anatomist Foundational Model)</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13269</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cytoplasmic Organelle</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13274 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13274">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C33174"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R82"/>
                <owl:someValuesFrom rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13329"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribosome</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0035553</Thesaurus:P207>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In biology, a structure found inside cells that is involved in making proteins. Ribosomes help link amino acids together to form proteins.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribosome</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribosomal</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribosomes are small organelles composed of ribosomal RNA (rRNA) and 80 some different proteins. rRNA is synthesized in the nucleolus and the ribosomal subunits are assembled there from rRNA and imported cytoplasmic made proteins. Once assembled, the subunits pass through the nuclear pores to the cytoplasm where they take part in protein synthesis. Some ribosomes are free in the cytoplasm and can be recruited to a polyribosomal structure when a messenger RNA (mRNA) strand is to be translated into a cytoplasmic protein. Other ribosomes are attached to the endoplasmic reticulum where the protein is formed within the interior to the endoplasmic reticulum. These proteins are destined for secretion, storage or incorporation into membranes.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13274</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribosome</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13282 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13282">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14135"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subcellular Structure</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0729605</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subcellular_Structure</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intracellular Structure</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An anatomical element found within cells or tissues that are smaller than cells and are at or below the size that can be resolved by light microscopy.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13282</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subcellular Structure</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13329 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13329">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13230"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rough Endoplasmic Reticulum</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0230779</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rough_Endoplasmic_Reticulum</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ergastoplasm</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Granular Endoplasmic Reticulum</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rough ER</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rough-Surfaced Endoplasmic Reticulum</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rER</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Membrane organelle of eukaryotes that forms sheets and tubules. Contains the receptor for the signal receptor particle and binds ribosomes engaged in translating mRNA for secreted proteins and the majority of transmembrane proteins. Also a site of membrane lipid synthesis. The membrane is very similar to the nuclear outer membrane. The lumen contains a number of proteins that possess the C terminal signal KDEL.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13329</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rough Endoplasmic Reticulum</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13377 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13377">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13446"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R82"/>
                <owl:someValuesFrom rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13202"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromosome Structure</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0729606</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromosome_Structure</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromosomal Organization</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromosomal Structure</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromosome Organization</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The 3-D organization of histones and other proteins on chromosomal DNA in the nucleus and allow for its form and function during cellular growth and division.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13377</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chromosome Structure</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13404 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13404">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14134"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemical Viewed Structurally</Thesaurus:P106>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nucleotide Sequence</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA Structure</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1511699</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA_Structure</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The structure of a DNA molecule, consisting of its primary nucleotide sequence as well as its secondary and tertiary arrangement in space.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13404</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA Structure</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13445 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13445">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13377"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene or Genome</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene Feature</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1517495</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene_Structure</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene Organization</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene Structure</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene Structure/Organization</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Seq Feature</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sequence Feature</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The structural elements that comprise a gene or transcription unit. Gene structures include the transcription initiation site, the protein coding sequences, intervening sequences, and the transcription termination or polyadenylation sites as well as the regulatory elements (enhancers, silencers, and the promoter) that lie outside the boundaries of the transcribed unit.</Thesaurus:P97>
        <Thesaurus:P98 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Represents, in general, what would be a GenBank Feature Table annotation for a sequence. (caMAGE)</Thesaurus:P98>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13445</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gene Feature</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13446 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13446">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13282"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cell Component</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nuclear Structure</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1518439</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nuclear_Structure</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any structures that are enclosed within nucleus are considered nuclear structure, including any macromolecular structures. (NCI)</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C13446</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nuclear Structure</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14134 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14134">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C21599"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spatial Concept</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Macromolecular Structure</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0026383</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Macromolecular_Structure</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular Structure</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any very large complex molecule including, proteins, nucleic acids and carbohydrates, especially refering to the particular arrangement of its component atoms and groups.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C14134</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Macromolecular Structure</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14135 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C14135">
