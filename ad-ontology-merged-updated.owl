        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A community species diversity that exists in a microbiome ecosystem where different microbial species are found.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microbial diversity</oboInOwl:hasExactSynonym>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A community species diversity that exists in a microbiome ecosystem where different microbial species are found.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Microbial species diversity</rdfs:label>
    </owl:Class>
    


