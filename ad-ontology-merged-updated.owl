        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007589"/>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">glandular part of endometrium</oboInOwl:hasExactSynonym>
