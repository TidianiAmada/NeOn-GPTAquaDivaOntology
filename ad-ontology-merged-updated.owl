            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The external elements and conditions which surround, influence, and affect the life and development of an organism or population. This should become a material entity with the role of environment</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environmental factor</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Environment factor</rdfs:synonym>
    </owl:Class>
    


