        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aqueous humor of eyeball</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001797 -->

