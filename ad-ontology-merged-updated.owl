    <!-- http://purl.obolibrary.org/obo/ENVO_1000749 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_1000749">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000221"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An island created when a continent is rifted.</obo:IAO_0000115>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&quot;Examples are Madagascar and Socotra off Africa, the Kerguelen Islands, New Caledonia, New Zealand, and some of the Seychelles.&quot; https://en.wikipedia.org/wiki/Island</rdfs:comment>
        <rdfs:label xml:lang="en">microcontinental island</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_1000749"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
