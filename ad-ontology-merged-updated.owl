        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034705"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An epithelium that is undergoing proliferation to provide large numbers of neuronal cells.</obo:IAO_0000115>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proliferating neuroepithelium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0034707 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034707">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034705"/>
