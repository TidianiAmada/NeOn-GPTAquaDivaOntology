    <!-- http://purl.obolibrary.org/obo/UBERON_0001956 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001956">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003603"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The hyaline cartilaginous structures that support the bronchi, present as irregular rings in the larger bronchi (and not as regular as in the trachea), and as small plates and islands in the smaller bronchi; as the branching continues through the bronchial tree, the amount of hyaline cartilage in the walls decreases until it is absent in the smallest bronchioles[MP].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bronchi cartilage</oboInOwl:hasExactSynonym>
