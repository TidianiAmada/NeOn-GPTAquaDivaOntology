    <!-- http://purl.obolibrary.org/obo/ENVO_00000197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000020"/>
