                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000456"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vaccine preparation</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The production of B. pertussis vaccine.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vaccine preparation is a planned  process with specified output a vaccine</obo:IAO_0000115>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBI</obo:IAO_0000119>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vaccine preparation</rdfs:label>
