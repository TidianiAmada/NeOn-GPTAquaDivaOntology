        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pancreas dorsal primordium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010376 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001048"/>
