        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012275"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The first segment of the nephron lying just downstream from the loop of Henle, immediately after the macula densa.</obo:IAO_0000115>
