    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001744 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001744">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034769"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Portion of connective tissue with various types of white blood cells enmeshed in it, most numerous being the lymphocytes[WP].</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lymphatic tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lymphocytic tissue</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lymphoid tissue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001745 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001745">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000444"/>
