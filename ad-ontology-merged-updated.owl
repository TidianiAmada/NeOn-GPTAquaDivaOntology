                                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_1110083"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
