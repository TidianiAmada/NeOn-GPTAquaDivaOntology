        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thorax nerve trunk of sympathetic nervous system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thorax nerve trunk of sympathetic part of autonomic division of nervous system</oboInOwl:hasExactSynonym>
