    <!-- http://purl.obolibrary.org/obo/UBERON_0002240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000489"/>
