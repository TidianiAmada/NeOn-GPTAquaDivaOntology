            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An island that does not sit on a continental shelf, and is of volcanic origin.</obo:IAO_0000115>
