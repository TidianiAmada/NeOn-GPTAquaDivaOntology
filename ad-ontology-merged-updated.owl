    <!-- http://purl.obolibrary.org/obo/OBI_0001144 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001144">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001536"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001548"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001571"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001581"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001583"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001603"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0001605"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001181"/>
        <obo:IAO_0000111 xml:lang="en">binding constant</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">The predicted or measured binding affinity of a peptide to a MHC molecule can be captured in the binding constants &quot;IC50 = 12 nM&quot; or &quot;t 1/2 = 30 minutes&quot;.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">A binding datum about the disposition of two or more material entities to form complexes which comes in the form of a scalar and unit that are utilized in equations that model the binding process</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10/6/11 BP: The distinction between binding datum and binding constant is based on the later being part of an equation. That should be captured in the logical definition here, and used to make it to a defined class.</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">PERSON: Bjoern Peters, Randi Vita, Jason Greenbaum</obo:IAO_0000117>
        <rdfs:label xml:lang="en">binding constant</rdfs:label>
    </owl:Class>
    


