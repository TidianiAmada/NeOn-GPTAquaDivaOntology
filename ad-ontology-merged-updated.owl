        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sesamoid bone of manus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0008000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001479"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005899"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011141"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sesamoid bone that is part of a pes.</obo:IAO_0000115>
