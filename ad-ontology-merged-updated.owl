        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The pre-cartilaginous form of a vertebral element, a skeletal element that forms around the notochord and is part of the vertebral column.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertebral pre-cartilage condensation</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertebra pre-cartilage condensation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011107">
