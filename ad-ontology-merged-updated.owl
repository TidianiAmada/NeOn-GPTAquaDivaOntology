        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prosomere</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0014776 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0014776">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004731"/>
