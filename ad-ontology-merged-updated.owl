        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ventral horn of spinal cord</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002261 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002261">
