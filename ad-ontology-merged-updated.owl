                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">oligonucleotide synthesizer</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Automated Multiplex Oligonucleotide Synthesizer</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">An instrument used to chemically synthesize oligonucleotides.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Trish Whetzel</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">MO</obo:IAO_0000119>
        <rdfs:label xml:lang="en">oligonucleotide synthesizer</rdfs:label>
    </owl:Class>
    


