        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000832"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000453"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">spectrophotometer</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Helios Gamma Spectrophotometer</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A spectrophotometer is an instrument that measures the intensity of light as a function of the color, or more specifically, the wavelength of light, transmitted by a substance.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Melanie Courtot</obo:IAO_0000117>
        <obo:IAO_0000117 xml:lang="en">Trish Whetzel</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">MO</obo:IAO_0000119>
        <rdfs:label xml:lang="en">spectrophotometer</rdfs:label>
    </owl:Class>
    


