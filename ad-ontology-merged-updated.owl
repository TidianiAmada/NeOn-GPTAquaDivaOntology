        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015796"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wide thin-walled blood vessels in the liver. In mammals they have neither veinous or arterial markers.</obo:IAO_0000115>
