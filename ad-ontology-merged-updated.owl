        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/NCIT_C43431"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classification</Thesaurus:P106>
