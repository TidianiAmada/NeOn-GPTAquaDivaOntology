        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The zone of an ocean from the surface to where photosynthesis can occur, due to the penetration of light.</obo:IAO_0000115>
