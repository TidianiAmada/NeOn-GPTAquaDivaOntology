        <obo:IAO_0000111 xml:lang="en">RNA stability design</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">A study design that examines the stability and/or decay of RNA transcripts.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Person: Chris Stoeckert, Jie Zheng</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">MO_553 RNA_stability_design</obo:IAO_0000119>
        <rdfs:label xml:lang="en">RNA stability design</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001307 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0400148"/>
        <obo:IAO_0000111 xml:lang="en">tiling microarray</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a DNA microarray which has short fragments of nucleic acid immobilized on a substrate. These are designed to cover the whole genome of the target species. Tiling arrays are used to determine genome binding in ChIP assays or to identify transcribed regions.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Person: Helen Parkinson</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">genome tiling array</obo:IAO_0000118>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EFO_0002704: tiling array</obo:IAO_0000119>
        <rdfs:label xml:lang="en">tiling microarray</rdfs:label>
    </owl:Class>
    


