    <!-- http://purl.obolibrary.org/obo/OBI_0000552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0600058"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom>
                    <owl:Class>
