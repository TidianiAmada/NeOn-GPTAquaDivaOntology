        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stratum basale of epidermis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003055"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013754"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the outer layer of the epidermis, consisting of several layers of flat keratinized non-nucleated cells</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">horny layer</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">keratinized squame layer</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stratum corneum</oboInOwl:hasBroadSynonym>
