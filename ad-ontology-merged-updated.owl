        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">venous sinus of red pulp of spleen</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spleen venous sinus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0009969 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009969">
