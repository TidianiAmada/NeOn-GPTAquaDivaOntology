        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002217"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003657"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any synovial joint that is part of a (free) limb.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synovial joint of free limb segment</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synovial limb joint</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010911"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ossicle that is part of the appendicular skeleton.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ossicle of appendicular skeleton</oboInOwl:hasExactSynonym>
