        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sympathetic nerve trunk of thorax</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sympathetic nervous system nerve trunk of thorax</oboInOwl:hasExactSynonym>
