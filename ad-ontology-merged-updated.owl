    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C44445">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17053"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Natural Phenomenon or Process</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solar Radiation</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0037605</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solar_Radiation</Thesaurus:P366>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C44445</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Solar Radiation</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C449 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C449">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C706"/>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A long linear double-stranded polymer formed from nucleotides attached to a deoxyribose backbone and found in the nucleus of a cell; associated with the transmission of genetic information.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C449</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DNA</rdfs:label>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D</rdfs:synonym>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Deoxyribonucleic acid</rdfs:synonym>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Double-stranded DNA</rdfs:synonym>
        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dsDNA</rdfs:synonym>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45276 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45276">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C40098"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conceptual Entity</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kingdom</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1708611</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kingdom_Taxon</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The highest taxonomic rank, immediately above phylum or division. There are five biological kingdoms (Monera, Protista, Plantae, Fungi, Animalia) into which organisms are grouped, based on common characteristics.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C45276</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kingdom</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45277 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45277">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C40098"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conceptual Entity</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phylum</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1709533</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phylum_Taxon</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A major division of a biological kingdom, consisting of closely-related classes; represents a basic fundamental pattern of organization and, presumably, a common descent.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C45277</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phylum</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45280 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45280">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C40098"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conceptual Entity</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Class</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1705943</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Class_Taxon</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A collection of taxonomic subdivisions directly under Phylum. It is a major group of organisms, e.g. Mammalia, Reptilia, Gastropoda, Insecta, etc that contains a large number of different sublineages, but have shared characteristics in common (e.g. warm-blooded, fur, six legs etc).</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C45280</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Class</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45287 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45287">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C40098"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conceptual Entity</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Order</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1705177</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Order_Taxon</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A taxonomic category between Class and Family.  It is group of organisms that although differing quite a bit among themselves still have a large degree of characteristics in common.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C45287</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Order</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45290 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45290">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C40098"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conceptual Entity</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Family</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1704727</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Family_Taxon</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A taxonomic category between Order and Genus. It consists of a group of organisms among which the differences are quite minor, e.g. Equiidae - horses and their relatives.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C45290</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Family</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45292 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45292">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C40098"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conceptual Entity</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genus</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1708235</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genus_Taxon</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A taxonomic category ranking below a family (or Subfamily) and above a species and generally consisting of a group of species exhibiting similar characteristics.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C45292</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genus</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45293 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45293">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C40098"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Conceptual Entity</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Species</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1705920</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Species_Taxon</Thesaurus:P366>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A group of organisms that differ from all other groups of organisms and that are capable of breeding and producing fertile offspring.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C45293</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Species</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45306 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45306">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C20181"/>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any matter of defined composition that has discrete existence, whose origin may be biological, mineral or chemical.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C45306</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Substance</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45559 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45559">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C84268"/>
        <ad-ontology-merged:NHC0>C45559</ad-ontology-merged:NHC0>
        <ad-ontology-merged:P106>Idea or Concept</ad-ontology-merged:P106>
        <ad-ontology-merged:P108>Term</ad-ontology-merged:P108>
        <ad-ontology-merged:P207>C1705313</ad-ontology-merged:P207>
        <ad-ontology-merged:P322>CDISC-GLOSS</ad-ontology-merged:P322>
        <ad-ontology-merged:P325>One or more words designating something. NOTE: In a controlled vocabulary, terms are considered to refer to an underlying concept having a single meaning. Concepts may be linked to several synonymous terms.</ad-ontology-merged:P325>
        <ad-ontology-merged:P366>Term_Word</ad-ontology-merged:P366>
        <ad-ontology-merged:P90>Term</ad-ontology-merged:P90>
        <ad-ontology-merged:P90>Word</ad-ontology-merged:P90>
        <ad-ontology-merged:P90>term</ad-ontology-merged:P90>
        <ad-ontology-merged:P97>A word or expression used for some particular thing.</ad-ontology-merged:P97>
        <rdfs:label>Term</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45997 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45997">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C18102"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phenomenon or Process</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pH</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C2363150</Thesaurus:P207>
        <Thesaurus:P322 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CDISC</Thesaurus:P322>
        <Thesaurus:P322 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UCUM</Thesaurus:P322>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The negative logarithm (base 10) of the concentration of hydronium ions, which is used as a measure of the acidity or alkalinity of a fluid.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pH</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">[pH]</Thesaurus:P90>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">potential of Hydrogen</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quantity of dimension one used to express on a scale from 0 to 14 the amount-of-substance concentration of hydrogen ion of dilute aqueous solution, calculated as the logarithm of the reciprocal of hydrogen-ion concentration in gram atoms per liter.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C45997</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pH</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45998 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C45998">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C18102"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Natural Phenomenon or Process</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oxidation-Reduction Potential</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1709375</Thesaurus:P207>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oxidation-Reduction_Potential</Thesaurus:P366>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Redox Potential</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The potential developed by a metallic electrode when placed in a solution containing a species in two different oxidation states.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C45998</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oxidation-Reduction Potential</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C46003 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C46003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/NCIT_C20189"/>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The quality of being unlike or dissimilar.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C46003</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Difference</rdfs:label>
