        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desublimation is a process in which a portion of some gas undergoes a phase transition into a portion of some solid.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Deposition_(phase_transition)</oboInOwl:hasDbXref>
    </owl:Axiom>
    


