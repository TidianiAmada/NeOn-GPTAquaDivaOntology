        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">appendicular skeleton</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002092 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002363"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003547"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The fibrous membrane forming the outer of the three coverings that surrounds the brain within the cranial cavity; consists of two layers including the periosteal layer and the meningeal layer.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cranial dura mater</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dura mater cranialis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dura mater encephali</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dura mater of brain</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">brain dura mater</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0002093 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002363"/>
