        <obo:IAO_0000111 xml:lang="en">assay bead</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Dynabeads are commercially available magnetic beads which are precoated with antibodies specific for select cellular receptors and are used to separate cell populations.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">A globular or round particle of defined physicochemical properties and size which can be exploited as either the primary substance for detection or as a secondary solid platform for the attachment of bioactive molecules.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">DS: Probably better modeled as a role.</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">OBI</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">bead</obo:IAO_0000118>
        <rdfs:label xml:lang="en">assay bead</rdfs:label>
    </owl:Class>
    


