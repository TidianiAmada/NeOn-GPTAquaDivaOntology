    <!-- http://purl.obolibrary.org/obo/ENVO_01000862 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_01000862">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00010504"/>
