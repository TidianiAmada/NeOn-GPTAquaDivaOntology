        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The layers of the laminar structure of the hippocampus.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cytoarchitectural fields of hippocampal formation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hippocampus layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hippocampus proper layer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">layer of cornu ammonis</oboInOwl:hasRelatedSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">layer of hippocampus</rdfs:label>
    </owl:Class>
    


