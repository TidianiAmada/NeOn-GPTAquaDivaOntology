            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">synthesis</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">making cDNA from nucleotides using RNA as a template</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">the construction of a biomaterial from simpler biomaterials</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">This probably needs breaking down into more specific applications. The example given is already covered in reverse_transcription</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">PERSON:Kevin Clancy</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">synthesize</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
