            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000370"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">supernatant collection system harvesting frame</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">a device that is designed for collecting 90% of the supernatant in a microplate well and separating the living cell with no stress, eliminating centrifugation and other similar techniques. It can be used in a variety of release assays with different radioactive isotopes, such as Cr51 or I125.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Daniel Schober</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">google</obo:IAO_0000119>
        <rdfs:label xml:lang="en">supernatant collection system harvesting frame</rdfs:label>
    </owl:Class>
    


