            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AB SOLiD System</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID: 19336255. RNA-Seq-quantitative measurement of expression through massively parallel RNA-sequencing. Wilhelm BT, Landry JR. Methods. 2009 Jul;48(3):249-57.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is a DNA sequencer which is manufactured by Applied Biosystems and which enable DNA sequencing by ligation</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Philippe Rocca-Serra</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applied Biosystems</obo:IAO_0000119>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AB SOLiD System</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000697 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000697">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000734"/>
