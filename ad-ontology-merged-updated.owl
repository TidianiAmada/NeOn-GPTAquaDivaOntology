        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">a reference subject  role which inheres in an organism or entity of organismal origin so that the characteristics or responses of the participant playing the reference participant role are used for comparison or reference</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">Jennifer Fostel</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reference participant</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">OBI</obo:IAO_0000119>
        <rdfs:label xml:lang="en">reference subject role</rdfs:label>
