    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C812 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C812">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C706"/>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biologically Active Substance</Thesaurus:P106>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nucleic Acid, Nucleoside, or Nucleotide</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribonucleic Acid</Thesaurus:P108>
        <Thesaurus:P175 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">77461</Thesaurus:P175>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0035668</Thesaurus:P207>
        <Thesaurus:P210 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">63231-63-0</Thesaurus:P210>
        <Thesaurus:P322 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CDISC</Thesaurus:P322>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One of two types of nucleic acid made by cells. Ribonucleic acid contains information that has been copied from DNA (the other type of nucleic acid). Cells make several different forms of ribonucleic acid, and each form has a specific job in the cell. Many forms of ribonucleic acid have functions related to making proteins. Ribonucleic acid is also the genetic material of some viruses instead of DNA. Ribonucleic acid can be made in the laboratory and used in research studies.</Thesaurus:P325>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-stranded long chain of nucleotides containing ribose. It is the end product of DNA transcription by the enzyme RNA polymerase. It is essential in protein synthesis.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribonucleic_Acid</Thesaurus:P366>
        <Thesaurus:P368 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:33697</Thesaurus:P368>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RNA</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Single-stranded long chain of nucleotides containing ribose. It is the end product of DNA transcription by the enzyme RNA polymerase. It is essential in protein synthesis.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C812</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribonucleic Acid</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C814 -->

    <owl:Class rdf:about="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C814">
        <rdfs:subClassOf rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C26549"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R46"/>
                <owl:someValuesFrom rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C13274"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#R54"/>
                <owl:someValuesFrom rdf:resource="http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C95943"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biologically Active Substance</Thesaurus:P106>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nucleic Acid, Nucleoside, or Nucleotide</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribosomal RNA</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0035701</Thesaurus:P207>
        <Thesaurus:P322 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CDISC</Thesaurus:P322>
        <Thesaurus:P325 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An RNA molecule that does not contain protein-coding sequence information and constitutes the majority of the cellular RNA (~80%). This nucleic acid associates with multiple proteins to form ribosomes, which are the organelles that drive mRNA-directed protein synthesis.</Thesaurus:P325>
        <Thesaurus:P366 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribosomal_RNA</Thesaurus:P366>
        <Thesaurus:P368 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CHEBI:18111</Thesaurus:P368>
        <Thesaurus:P90 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rRNA</Thesaurus:P90>
        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An RNA molecule that does not contain protein-coding sequence information and constitutes the majority of the cellular RNA (~80%). This nucleic acid associates with multiple proteins to form ribosomes, which are the organelles that drive mRNA-directed protein synthesis.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C814</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ribosomal RNA</rdfs:label>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C84268 -->

