    <!-- http://purl.obolibrary.org/obo/UBERON_0011143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000477"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subdivision of urinary system which consists of the kidney and the ureters.</obo:IAO_0000115>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">upper urinary tract</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011148">
