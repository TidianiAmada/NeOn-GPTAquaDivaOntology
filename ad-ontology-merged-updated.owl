        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010314"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A jaw muscle that arises from cranial mesenchyme and is innervated by cranial nerves.</obo:IAO_0000115>
