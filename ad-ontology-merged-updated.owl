    <!-- http://purl.obolibrary.org/obo/ENVO_00000351 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000351">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000094"/>
