            </owl:Restriction>
        </rdfs:subClassOf>
        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genetic Function</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RNA Synthesis</Thesaurus:P108>
        <Thesaurus:P207 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C1623415</Thesaurus:P207>
