    <!-- http://www.ebi.ac.uk/efo/EFO_0000469 -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/EFO_0000469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
