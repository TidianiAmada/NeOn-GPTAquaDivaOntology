        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lake which forms as a result of subsidence along a geological fault in the Earth&apos;s tectonic plates.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Lake#Types_of_lakes</oboInOwl:hasDbXref>
