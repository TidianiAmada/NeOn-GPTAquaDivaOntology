    <!-- http://purl.obolibrary.org/obo/OBI_0000054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
