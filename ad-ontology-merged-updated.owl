        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Polidoro, Silvia, et al. &quot;Effects of bisphosphonate treatment on DNA methylation in osteonecrosis of the jaw.&quot; Mutation Research/Genetic Toxicology and Environmental Mutagenesis 757.2 (2013): 104-113. PMID: 23892139</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A methylation BeadChip which is manufactured by the Illumina corporation. Built upon BeadChip tehcnology, the array interrogates ~ 27,000 CpG sites per sample at single-nucleotide resolution.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PERSON: Venkat Malladi, Chris Stoeckert, Jie Zheng, Alan Ruttenberg</obo:IAO_0000117>
        <obo:IAO_0000118 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Illumina Infinium Human Methylation 27K BeadChip</obo:IAO_0000118>
