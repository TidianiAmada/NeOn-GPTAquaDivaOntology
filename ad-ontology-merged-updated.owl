    <!-- http://purl.obolibrary.org/obo/OBI_0000213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000111 xml:lang="en">fluorescence compensation matrix</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">((1.053096, -0.22476), (-0.24877, 1.053096))</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A fluorescence compensation matrix is a square matrix which is used as the left multiplier of the vector of fluorescence values while performing digital fluorescence compensation. Also, fluorescence compensation matrix is the inverse of the fluorescence spillover matrix.</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">person:Chris Stoeckert</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">group:Flow Cytometry community</obo:IAO_0000119>
        <rdfs:label xml:lang="en">fluorescence compensation matrix</rdfs:label>
    </owl:Class>
    


