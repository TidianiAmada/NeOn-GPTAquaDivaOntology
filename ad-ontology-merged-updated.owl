        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SALT PAN</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">USGS:SDTS</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
