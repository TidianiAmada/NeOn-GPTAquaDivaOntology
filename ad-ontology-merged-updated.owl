    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001945 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001940"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom>
                    <owl:Class>
