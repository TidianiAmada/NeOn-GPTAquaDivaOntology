        <Thesaurus:P97 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The biosynthesis of new (often sets of distinct, functionally related) protein products, usually involving new mRNA transcripts, typically in response to an activating stimulus.</Thesaurus:P97>
        <Thesaurus:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C18966</Thesaurus:code>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protein Expression</rdfs:label>
    </owl:Class>
    


