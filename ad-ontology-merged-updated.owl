    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00000267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000169"/>
        <rdfs:subClassOf>
            <owl:Restriction>
