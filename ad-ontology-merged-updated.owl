http://sourceforge.net/p/obi/obi-terms/707/</obo:IAO_0000232>
        <rdfs:label xml:lang="en">ChIP assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001955 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001955">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000064"/>
        <obo:IAO_0000111 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">competitive binding reference ligand role</obo:IAO_0000111>
        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The role of a radiolabeled peptide that is known to bind to the MHC molecule HLA-A*02:01 with high affinity when it is used in a competitive binding assay in which another peptide of interest is tested for its ability to outcompete binding of the labeled peptide in a dose dependent fashion.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A positive reference substance role that inheres in a material entity that is known to bind to a target entity, and that is realized in a competitive binding assay that has as specified input the target entity, an evaluant and the positive reference substance, where the binding of the evaluant to the target is measured based on the evaluant&apos;s ability to compete with the positive reference substance for binding to the target.</obo:IAO_0000115>
        <obo:IAO_0000117 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bjoern Peters, Randi Vita, James A. Overton</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bjoern Peters</obo:IAO_0000119>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">competitive binding reference ligand role</rdfs:label>
    </owl:Class>
    


