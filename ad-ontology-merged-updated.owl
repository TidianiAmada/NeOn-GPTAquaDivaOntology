        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sheath of cells</oboInOwl:hasRelatedSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell layer</rdfs:label>
    </owl:Class>
    


