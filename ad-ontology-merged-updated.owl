        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_00000411"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ford</owl:annotatedTarget>
