        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001277"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An epithelium that is part of a crypt of Lieberkuhn.</obo:IAO_0000115>
