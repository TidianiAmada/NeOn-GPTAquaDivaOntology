    <!-- http://purl.obolibrary.org/obo/OBI_0600004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0600004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001928"/>
        <rdfs:subClassOf>
            <owl:Restriction>
