        <obo:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Person:Alan Ruttenberg</obo:IAO_0000119>
        <obo:IAO_0000232 xml:lang="en">Really of interest to developers only</obo:IAO_0000232>
