        <ad-ontology-merged:P106>Geographic Area</ad-ontology-merged:P106>
        <ad-ontology-merged:P108>Facility</ad-ontology-merged:P108>
        <ad-ontology-merged:P207>C1547538</ad-ontology-merged:P207>
        <ad-ontology-merged:P366>Facility</ad-ontology-merged:P366>
        <ad-ontology-merged:P90>Facility</ad-ontology-merged:P90>
        <ad-ontology-merged:P97>Services and space and equipment provided for a particular purpose; a building or place that provides a particular service or is used for a particular industry.</ad-ontology-merged:P97>
        <rdfs:label>Facility</rdfs:label>
    </owl:Class>
    


