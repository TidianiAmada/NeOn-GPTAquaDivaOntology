        <obo:IAO_0000111 xml:lang="en">cap analysis of gene expression</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">5&apos; end-centered expression profiling using cap-analysis gene expression and next-generation sequencing.
Takahashi H, Lassmann T, Murata M, Carninci P.
Nat Protoc. 2012 Feb 23;7(3):542-61. doi: 10.1038/nprot.2012.005.
PMID: 22362160</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">An assay which aims at monitoring RNA transcript abundances in biological samples by extracting 5&apos; ends of capped transcripts, RTPCR and sequence those. Copy numbers of CAGE tags provide  a way of quantification and provide a measure of expression of the transcriptome</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PERSON:Philippe Rocca-Serra; Marcus Chibucos</obo:IAO_0000117>
        <obo:IAO_0000118 xml:lang="en">CAGE</obo:IAO_0000118>
        <obo:IAO_0000119 xml:lang="en">PMID:14663149</obo:IAO_0000119>
        <rdfs:label xml:lang="en">cap analysis of gene expression</rdfs:label>
    </owl:Class>
    


