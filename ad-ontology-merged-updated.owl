        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney outer medulla outer stripe</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0004203 -->

