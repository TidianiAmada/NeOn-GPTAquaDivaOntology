        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sebaceous follicle</oboInOwl:hasRelatedSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sebaceous gland</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001823 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001823">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002418"/>
