        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acinus that is part of a lacrimal gland.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lacrimal gland acinus</oboInOwl:hasExactSynonym>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acinus of lacrimal gland</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011858 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011858">
