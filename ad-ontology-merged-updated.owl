    <!-- http://purl.obolibrary.org/obo/UBERON_0000119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000957"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Portion of tissue, that consists of single layer of cells connected to each other by cell junctions. Examples: layer of glial cells; epithelium.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">layer</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">layer of cells</oboInOwl:hasExactSynonym>
