            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111 xml:lang="en">agarose gel</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Performance comparison of capillary and agarose gel electrophoresis for the identification and characterization of monoclonal immunoglobulins. Am J Clin Pathol. 2008 Mar;129(3):451-8. PMID: 18285269</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
