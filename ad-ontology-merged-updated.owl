        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Methylation 27K BeadChip</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002006 -->

