        <obo:IAO_0000112 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The presentation of a flashing light to a monkey during reward training</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
