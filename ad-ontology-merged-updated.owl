        <obo:IAO_0000111 xml:lang="en">data encoding</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">storage of measurement results from an assay into a text file, such as</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115 xml:lang="en">a documenting process to encode an information entity into a digital document</obo:IAO_0000115>
        <obo:IAO_0000117 xml:lang="en">PlanAndPlannedProcess Branch</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <obo:IAO_0000232 xml:lang="en">We (protocol application branch) placed this term because it kept getting bounced from data transformation and DENRIE</obo:IAO_0000232>
        <rdfs:label xml:lang="en">data encoding</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000231 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000231">
