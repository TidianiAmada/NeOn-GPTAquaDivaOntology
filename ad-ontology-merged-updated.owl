        <rdfs:synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Differences of</rdfs:synonym>
    </owl:Class>
    


    <!-- http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C47905 -->

