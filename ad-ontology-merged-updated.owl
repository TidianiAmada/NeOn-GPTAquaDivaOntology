                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ENVO_00002011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Snowmelt is a hydrological process in which water is produced by the melting of snow and becomes part of the hydrological surface runoff.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The assertion that the output is freshwater seems reasonable; however, this can certianly be changed if a counter example is provided.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">snowmelt</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ENVO_01000719"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Snowmelt is a hydrological process in which water is produced by the melting of snow and becomes part of the hydrological surface runoff.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://en.wikipedia.org/wiki/Snowmelt</oboInOwl:hasDbXref>
    </owl:Axiom>
    


