        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neural tube lateral wall mantle layer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0005891 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000483"/>
