        <Thesaurus:P106 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Genetic Function</Thesaurus:P106>
        <Thesaurus:P108 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Protein Expression</Thesaurus:P108>
