            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An environmental process in which coral expels the symbiotic algae living in its tissue as a result of stress, causing the coral to turn white.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Add relations to coral organisms in NCBI taxonomy.</obo:IAO_0000116>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">orcid.org/0000-0001-8369-8114</oboInOwl:created_by>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coral bleaching</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">coral bleaching process</rdfs:label>
    </owl:Class>
    <owl:Axiom>
