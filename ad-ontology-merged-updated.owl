        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The connective tissue bundles in the extracellular matrix of tendon tissue that are composed of collagen, and play a role in tissue strength and elasticity</obo:IAO_0000115>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tendon collagen fibril</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011865 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010313"/>
