        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">any exocrine gland whose secretion consists of its own disintegrated secretory cells along with its secretory product; holocrine secretions are produced in the cytoplasm of the cell and released by the rupture of the plasma membrane, which destroys the cell and results in the secretion of the product into the lumen.</obo:IAO_0000115>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">holocrine gland</rdfs:label>
    </owl:Class>
    


