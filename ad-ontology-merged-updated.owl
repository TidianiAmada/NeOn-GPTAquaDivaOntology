        <obo:IAO_0000111 xml:lang="en">specimen family creation</obo:IAO_0000111>
        <obo:IAO_0000112 xml:lang="en">Aliquoting one specimen to multiple tubes, slicing a tissue specimen into multiple sections, processing blood into buffy coat, red cells, and serum.</obo:IAO_0000112>
