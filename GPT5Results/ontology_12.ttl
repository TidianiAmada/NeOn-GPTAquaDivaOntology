        owl:TransitiveProperty .

:hasMember a owl:ObjectProperty,
        owl:TransitiveProperty .

:isAncestorOf a owl:ObjectProperty,
        owl:TransitiveProperty .

:isCausedBy a owl:ObjectProperty,
        owl:TransitiveProperty .

