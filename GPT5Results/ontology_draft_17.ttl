# Fix applied: added the missing rdfs:label to the owl:class defined by owl:unionOf (CompositeUnit, DerivedUnit, PrefixedUnit)
# This satisfies the SHACL requirement that the union class must have at least one rdfs:label.

@prefix : <http://example.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Unit a owl:Class ;
    rdfs:label "Unit" .

:CompositeUnit a owl:Class ;
    rdfs:label "Composite Unit" .

:DerivedUnit a owl:Class ;
    rdfs:label "Derived Unit" .

:PrefixedUnit a owl:Class ;
    rdfs:label "Prefixed Unit" .

:UnitUnionClass a owl:Class ;
    owl:unionOf ( :CompositeUnit :DerivedUnit :PrefixedUnit ) ;
    rdfs:label "Composite, Derived, or Prefixed Unit" .