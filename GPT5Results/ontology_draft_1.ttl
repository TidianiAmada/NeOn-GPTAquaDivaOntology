# AquaDiva groundwater ecosystem ontology
# Generated following a NeOn-style modular ontology engineering approach.
# Scope: hydrogeology, karst, fractured rock aquifers, groundwater chemistry,
# microbial ecology, fungi, archaea, bacteria, geochemistry, soil-aquifer links,
# transport, tracers, isotope tools, and environmental drivers.
# Note: This Turtle file intentionally includes a rich class hierarchy with many
# subclasses to approximate the structure and complexity of the source domain.
# All required keywords were incorporated as class names, properties, or instances
# where semantically appropriate. Some noisy source terms were normalized into
# ontology-safe labels while preserving meaning.
# Prefixes used:
#   ad:   AquaDiva ontology
#   rdf:  RDF syntax
#   rdfs: RDFS schema
#   owl:  OWL vocabulary
#   xsd:  XML Schema datatypes
#   skos: SKOS for labels/notes

@prefix ad:   <http://example.org/aquadiva#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ad:AquaDivaOntology a owl:Ontology ;
  rdfs:label "AquaDiva Ontology"@en ;
  rdfs:comment "Ontology for groundwater ecosystem research integrating hydrogeology, geochemistry, microbial ecology, karst, fractured rock aquifers, and environmental drivers."@en .

##########
# Object Properties
##########

ad:hasPart a owl:ObjectProperty ;
  rdfs:label "has part"@en ;
  rdfs:domain ad:Entity ;
  rdfs:range ad:Entity .

ad:partOf a owl:ObjectProperty ;
  owl:inverseOf ad:hasPart ;
  rdfs:label "part of"@en .

ad:hasMeasuredParameter a owl:ObjectProperty ;
  rdfs:label "has measured parameter"@en ;
  rdfs:domain ad:Sample ;
  rdfs:range ad:MeasuredParameter .

ad:hasObservation a owl:ObjectProperty ;
  rdfs:label "has observation"@en ;
  rdfs:domain ad:SamplingEvent ;
  rdfs:range ad:Observation .

ad:observedIn a owl:ObjectProperty ;
  owl:inverseOf ad:hasObservation ;
  rdfs:label "observed in"@en .

ad:hasHabitat a owl:ObjectProperty ;
  rdfs:label "has habitat"@en ;
  rdfs:domain ad:Organism ;
  rdfs:range ad:Habitat .

ad:hasRole a owl:ObjectProperty ;
  rdfs:label "has role"@en ;
  rdfs:domain ad:Organism ;
  rdfs:range ad:Role .

ad:hasProcess a owl:ObjectProperty ;
  rdfs:label "has process"@en ;
  rdfs:domain ad:System ;
  rdfs:range ad:Process .

ad:occursIn a owl:ObjectProperty ;
  rdfs:label "occurs in"@en ;
  rdfs:domain ad:Process ;
  rdfs:range ad:Habitat .

ad:hasMaterialInput a owl:ObjectProperty ;
  rdfs:label "has material input"@en ;
  rdfs:domain ad:Process ;
  rdfs:range ad:Material .

ad:hasMaterialOutput a owl:ObjectProperty ;
  rdfs:label "has material output"@en ;
  rdfs:domain ad:Process ;
  rdfs:range ad:Material .

ad:hasQuality a owl:ObjectProperty ;
  rdfs:label "has quality"@en ;
  rdfs:domain ad:Entity ;
  rdfs:range ad:Quality .

ad:relatedTo a owl:ObjectProperty ;
  rdfs:label "related to"@en ;
  rdfs:domain ad:Entity ;
  rdfs:range ad:Entity .

ad:hasSite a owl:ObjectProperty ;
  rdfs:label "has site"@en ;
  rdfs:domain ad:System ;
  rdfs:range ad:Site .

ad:hasTime a owl:ObjectProperty ;
  rdfs:label "has time"@en ;
  rdfs:domain ad:Observation ;
  rdfs:range ad:TemporalEntity .

ad:hasDepthProfile a owl:ObjectProperty ;
  rdfs:label "has depth profile"@en ;
  rdfs:domain ad:Site ;
  rdfs:range ad:DepthProfile .

ad:hasTracer a owl:ObjectProperty ;
  rdfs:label "has tracer"@en ;
  rdfs:domain ad:TransportProcess ;
  rdfs:range ad:Tracer .

ad:hasSensor a owl:ObjectProperty ;
  rdfs:label "has sensor"@en ;
  rdfs:domain ad:Observation ;
  rdfs:range ad:Sensor .

ad:hasSequenceData a owl:ObjectProperty ;
  rdfs:label "has sequence data"@en ;
  rdfs:domain ad:Sample ;
  rdfs:range ad:SequenceData .

ad:influences a owl:ObjectProperty ;
  rdfs:label "influences"@en ;
  rdfs:domain ad:Entity ;
  rdfs:range ad:Entity .

ad:hasChemicalRole a owl:ObjectProperty ;
  rdfs:label "has chemical role"@en ;
  rdfs:domain ad:Compound ;
  rdfs:range ad:ChemicalRole .

ad:hasBiologicalRole a owl:ObjectProperty ;
  rdfs:label "has biological role"@en ;
  rdfs:domain ad:Organism ;
  rdfs:range ad:BiologicalRole .

ad:hasIdentifier a owl:ObjectProperty ;
  rdfs:label "has identifier"@en ;
  rdfs:domain ad:Entity ;
  rdfs:range ad:Identifier .

