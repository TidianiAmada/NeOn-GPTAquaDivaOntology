##########
# Class axioms and semantic links
##########

ad:GroundwaterSystem rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:hasPart ;
  owl:someValuesFrom ad:Aquifer
] .

ad:Aquifer rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:hasQuality ;
  owl:someValuesFrom ad:WaterChemistry
] .

ad:MicrobialCommunity rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:hasPart ;
  owl:someValuesFrom ad:Microorganism
] .

ad:MicrobialCommunity rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:hasHabitat ;
  owl:someValuesFrom ad:Subsurface
] .

ad:GroundwaterSample rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:observedIn ;
  owl:someValuesFrom ad:GroundwaterSystem
] .

ad:Hydrochemistry rdfs:subClassOf ad:GroundwaterChemistry .
ad:GroundwaterChemistry rdfs:subClassOf ad:WaterChemistry .
ad:GroundwaterPhysiochemicalParameters rdfs:subClassOf ad:WaterChemistry .
ad:AquiferMicrobe rdfs:subClassOf ad:Microorganism .
ad:AquiferFungus rdfs:subClassOf ad:Fungi .
ad:AquaticMicrobe rdfs:subClassOf ad:Microorganism .
ad:AquaticFungus rdfs:subClassOf ad:Fungi .
ad:GroundwaterContamination rdfs:subClassOf ad:GroundwaterQualityAquifer .
ad:GroundwaterProtection rdfs:subClassOf ad:GroundwaterManagement .
ad:GroundwaterManagement a owl:Class ; rdfs:subClassOf ad:ManagementAction ; rdfs:label "groundwater management"@en .

ad:MicrobialFunctionalGuild rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:hasRole ;
  owl:someValuesFrom ad:BiologicalRole
] .

ad:Denitrifier rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:hasRole ;
  owl:someValuesFrom ad:BiologicalRole
] .

ad:AmmoniaOxidiser rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:hasProcess ;
  owl:someValuesFrom ad:NitrogenCycling
] .

ad:GroundwaterSystem rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:hasSite ;
  owl:someValuesFrom ad:Site
] .

ad:Site rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:hasDepthProfile ;
  owl:someValuesFrom ad:DepthProfile
] .

ad:WaterChemistry rdfs:subClassOf [
  a owl:Restriction ;
  owl:onProperty ad:hasMeasuredParameter ;
  owl:someValuesFrom ad:MeasuredParameter
] .

