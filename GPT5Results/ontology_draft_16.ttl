# AquaDiva ontology refinement
# This Turtle file extends the ontology with a deeper hierarchical structure and richer object-property organization
# aligned to groundwater ecosystems, microbial ecology, hydrogeology, karst systems, and geochemistry.
# The object properties below are modeled to reflect the provided competency-question pattern and domain relations.

@prefix : <http://example.org/aquadiva#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/aquadiva>
    a owl:Ontology ;
    rdfs:label "AquaDiva ontology"@en ;
    rdfs:comment "Ontology for groundwater ecosystems, microbial ecology, hydrogeology, karst systems, and geochemistry."@en .

#################################################################
# Core upper structure
#################################################################

:Entity a owl:Class ;
    rdfs:label "Entity"@en .

:Characteristic a owl:Class ;
    rdfs:label "Characteristic"@en ;
    rdfs:subClassOf :Entity .

:MeasuredCharacteristic a owl:Class ;
    rdfs:label "Measured Characteristic"@en ;
    rdfs:subClassOf :Characteristic .

:CharacteristicQualifier a owl:Class ;
    rdfs:label "Characteristic Qualifier"@en ;
    rdfs:subClassOf :Entity .

:BaseCharacteristicQualifier a owl:Class ;
    rdfs:label "Base Characteristic Qualifier"@en ;
    rdfs:subClassOf :CharacteristicQualifier .

:CompositeCharacteristicQualifier a owl:Class ;
    rdfs:label "Composite Characteristic Qualifier"@en ;
    rdfs:subClassOf :CharacteristicQualifier .

:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:subClassOf :Entity .

:ObservationCollection a owl:Class ;
    rdfs:label "Observation Collection"@en ;
    rdfs:subClassOf :Entity .

:ObservationRelation a owl:Class ;
    rdfs:label "Observed Relation"@en ;
    rdfs:subClassOf :Entity .

:Measurement a owl:Class ;
    rdfs:label "Measurement"@en ;
    rdfs:subClassOf :Entity .

:MeasurementType a owl:Class ;
    rdfs:label "Measurement Type"@en ;
    rdfs:subClassOf :Entity .

:MeasuredValue a owl:Class ;
    rdfs:label "Measured Value"@en ;
    rdfs:subClassOf :Entity .

:Protocol a owl:Class ;
    rdfs:label "Protocol"@en ;
    rdfs:subClassOf :Entity .

:Standard a owl:Class ;
    rdfs:label "Standard"@en ;
    rdfs:subClassOf :Entity .

:Unit a owl:Class ;
    rdfs:label "Unit"@en ;
    rdfs:subClassOf :Entity .

:BaseUnit a owl:Class ;
    rdfs:label "Base Unit"@en ;
    rdfs:subClassOf :Unit .

:DerivedUnit a owl:Class ;
    rdfs:label "Derived Unit"@en ;
    rdfs:subClassOf :Unit .

:PrefixedUnit a owl:Class ;
    rdfs:label "Prefixed Unit"@en ;
    rdfs:subClassOf :Unit .

:CompositeUnit a owl:Class ;
    rdfs:label "Composite Unit"@en ;
    rdfs:subClassOf :Unit .

:UnitConversion a owl:Class ;
    rdfs:label "Unit Conversion"@en ;
    rdfs:subClassOf :Entity .

#################################################################
# Domain specialization for AquaDiva
#################################################################

:EnvironmentalEntity a owl:Class ;
    rdfs:label "Environmental Entity"@en ;
    rdfs:subClassOf :Entity .

:HydrogeologicalEntity a owl:Class ;
    rdfs:label "Hydrogeological Entity"@en ;
    rdfs:subClassOf :EnvironmentalEntity .

:KarstFeature a owl:Class ;
    rdfs:label "Karst Feature"@en ;
    rdfs:subClassOf :HydrogeologicalEntity .

:Aquifer a owl:Class ;
    rdfs:label "Aquifer"@en ;
    rdfs:subClassOf :HydrogeologicalEntity .

:GroundwaterBody a owl:Class ;
    rdfs:label "Groundwater Body"@en ;
    rdfs:subClassOf :HydrogeologicalEntity .

:Spring a owl:Class ;
    rdfs:label "Spring"@en ;
    rdfs:subClassOf :HydrogeologicalEntity .

:Cave a owl:Class ;
    rdfs:label "Cave"@en ;
    rdfs:subClassOf :KarstFeature .

:Sinkhole a owl:Class ;
    rdfs:label "Sinkhole"@en ;
    rdfs:subClassOf :KarstFeature .

:Sediment a owl:Class ;
    rdfs:label "Sediment"@en ;
    rdfs:subClassOf :EnvironmentalEntity .

:WaterSample a owl:Class ;
    rdfs:label "Water Sample"@en ;
    rdfs:subClassOf :Entity .

:MicrobialEntity a owl:Class ;
    rdfs:label "Microbial Entity"@en ;
    rdfs:subClassOf :Entity .

:MicrobialCommunity a owl:Class ;
    rdfs:label "Microbial Community"@en ;
    rdfs:subClassOf :MicrobialEntity .

:Microorganism a owl:Class ;
    rdfs:label "Microorganism"@en ;
    rdfs:subClassOf :MicrobialEntity .

:GeochemicalEntity a owl:Class ;
    rdfs:label "Geochemical Entity"@en ;
    rdfs:subClassOf :Entity .

:ChemicalConcentration a owl:Class ;
    rdfs:label "Chemical Concentration"@en ;
    rdfs:subClassOf :GeochemicalEntity .

:RedoxCondition a owl:Class ;
    rdfs:label "Redox Condition"@en ;
    rdfs:subClassOf :GeochemicalEntity .

#################################################################
# Object properties from competency questions
#################################################################

:characteristicFor a owl:ObjectProperty ;
    rdfs:label "characteristicFor"@en ;
    rdfs:domain :Characteristic ;
    rdfs:range :Entity ;
    rdfs:comment "Associates a characteristic with the entity it characterizes."@en .

:entityRelated a owl:ObjectProperty ;
    rdfs:label "entityRelated"@en ;
    rdfs:domain :Observation ;
    rdfs:range :Observation ;
    rdfs:comment "Relates observations involving entities in different contexts."@en .

:hasBaseQualifier a owl:ObjectProperty ;
    rdfs:label "hasBaseQualifier"@en ;
    rdfs:domain :CompositeCharacteristicQualifier ;
    rdfs:range :BaseCharacteristicQualifier ;
    rdfs:comment "Links a composite qualifier to its base qualifier."@en .

:hasContext a owl:ObjectProperty ;
    rdfs:label "hasContext"@en ;
    rdfs:domain :Observation ;
    rdfs:range :Observation ;
    rdfs:comment "Identifies the observation that provides context for another observation."@en .

:hasMeasurement a owl:ObjectProperty ;
    rdfs:label "hasMeasurement"@en ;
    rdfs:domain :Observation ;
    rdfs:range :Measurement ;
    rdfs:comment "Links an observation to its associated measurement."@en .

:hasMember a owl:ObjectProperty ;
    rdfs:label "hasMember"@en ;
    rdfs:domain :ObservationCollection ;
    rdfs:range :Observation ;
    rdfs:comment "Relates an observation collection to its member observations."@en .

:hasNextQualifier a owl:ObjectProperty ;
    rdfs:label "hasNextQualifier"@en ;
    rdfs:domain :CompositeCharacteristicQualifier ;
    rdfs:range :CharacteristicQualifier ;
    rdfs:comment "Links a composite qualifier to the next qualifier in the chain."@en .

:hasObservedRelation a owl:ObjectProperty ;
    rdfs:label "hasObservedRelation"@en ;
    rdfs:domain :Observation ;
    rdfs:range :ObservationRelation ;
    rdfs:comment "Specifies an observed relation within an observation."@en .

:hasQualifier a owl:ObjectProperty ;
    rdfs:label "hasQualifier"@en ;
    rdfs:domain :MeasuredCharacteristic ;
    rdfs:range :CharacteristicQualifier ;
    rdfs:comment "Associates a measured characteristic with a qualifier."@en .

:hasSourceUnit a owl:ObjectProperty ;
    rdfs:label "hasSourceUnit"@en ;
    rdfs:domain :UnitConversion ;
    rdfs:range :Unit ;
    rdfs:comment "Identifies the source unit in a unit conversion."@en .

:hasTargetUnit a owl:ObjectProperty ;
    rdfs:label "hasTargetUnit"@en ;
    rdfs:domain :UnitConversion ;
    rdfs:range :Unit ;
    rdfs:comment "Identifies the target unit in a unit conversion."@en .

:hasUnit a owl:ObjectProperty ;
    rdfs:label "hasUnit"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :CompositeUnit :DerivedUnit :PrefixedUnit ) ] ;
    rdfs:range :BaseUnit ;
    rdfs:comment "Associates a composite, derived, or prefixed unit with its underlying unit."@en .

:hasValue a owl:ObjectProperty ;
    rdfs:label "hasValue"@en ;
    rdfs:domain :Measurement ;
    rdfs:range :MeasuredValue ;
    rdfs:comment "Links a measurement to its measured value."@en .

:measurementFor a owl:ObjectProperty ;
    rdfs:label "measurementFor"@en ;
    rdfs:domain :Measurement ;
    rdfs:range :Observation ;
    rdfs:comment "Indicates the observation that a measurement belongs to."@en .

:measuresCharacteristic a owl:ObjectProperty ;
    rdfs:label "measuresCharacteristic"@en ;
    rdfs:domain :MeasurementType ;
    rdfs:range :Characteristic ;
    rdfs:comment "Indicates which characteristic a measurement type measures."@en .

:measuresEntity a owl:ObjectProperty ;
    rdfs:label "measuresEntity"@en ;
    rdfs:domain :MeasurementType ;
    rdfs:range :Entity ;
    rdfs:comment "Indicates which entity a measurement type measures."@en .

:measuresUsingProtocol a owl:ObjectProperty ;
    rdfs:label "measuresUsingProtocol"@en ;
    rdfs:domain :MeasurementType ;
    rdfs:range :Protocol ;
    rdfs:comment "Indicates the protocol used by a measurement type."@en .

:measuresUsingStandard a owl:ObjectProperty ;
    rdfs:label "measuresUsingStandard"@en ;
    rdfs:domain :MeasurementType ;
    rdfs:range :Standard ;
    rdfs:comment "Indicates the standard used by a measurement type."@en .

:ofCharacteristic a owl:ObjectProperty ;
    rdfs:label "ofCharacteristic"@en ;
    rdfs:domain :Measurement ;
    rdfs:range :Characteristic ;
    rdfs:comment "Indicates the characteristic represented by a measurement."@en .

:ofEntity a owl:ObjectProperty ;
    rdfs:label "ofEntity"@en ;
    rdfs:domain :Observation ;
    rdfs:range :Entity ;
    rdfs:comment "Indicates the entity observed in an observation."@en .

:usesProtocol a owl:ObjectProperty ;
    rdfs:label "usesProtocol"@en ;
    rdfs:domain :Measurement ;
    rdfs:range :Protocol ;
    rdfs:comment "Indicates the protocol used in a measurement."@en .

:usesStandard a owl:ObjectProperty ;
    rdfs:label "usesStandard"@en ;
    rdfs:domain :Measurement ;
    rdfs:range :Standard ;
    rdfs:comment "Indicates the standard used in a measurement."@en .

#################################################################
# Additional hierarchical relations to enrich the domain model
#################################################################

:observedIn a owl:ObjectProperty ;
    rdfs:label "observedIn"@en ;
    rdfs:domain :Observation ;
    rdfs:range :EnvironmentalEntity ;
    rdfs:comment "Links an observation to the environmental entity or setting in which it was made."@en .

:hasSample a owl:ObjectProperty ;
    rdfs:label "hasSample"@en ;
    rdfs:domain :Observation ;
    rdfs:range :WaterSample ;
    rdfs:comment "Links an observation to a sample used in the observation."@en .

:containsMicrobialCommunity a owl:ObjectProperty ;
    rdfs:label "containsMicrobialCommunity"@en ;
    rdfs:domain :WaterSample ;
    rdfs:range :MicrobialCommunity ;
    rdfs:comment "Indicates that a sample contains a microbial community."@en .

:containsMicroorganism a owl:ObjectProperty ;
    rdfs:label "containsMicroorganism"@en ;
    rdfs:domain :MicrobialCommunity ;
    rdfs:range :Microorganism ;
    rdfs:comment "Indicates that a microbial community contains a microorganism."@en .

:hasGeochemicalFeature a owl:ObjectProperty ;
    rdfs:label "hasGeochemicalFeature"@en ;
    rdfs:domain :EnvironmentalEntity ;
    rdfs:range :GeochemicalEntity ;
    rdfs:comment "Links an environmental entity to a geochemical feature."@en .

:hasHydrogeologicalFeature a owl:ObjectProperty ;
    rdfs:label "hasHydrogeologicalFeature"@en ;
    rdfs:domain :EnvironmentalEntity ;
    rdfs:range :HydrogeologicalEntity ;
    rdfs:comment "Links an environmental entity to a hydrogeological feature."@en .

#################################################################
# Example individuals for structural completeness
#################################################################

:obs1 a :Observation ;
    rdfs:label "Example observation 1"@en .

:obs2 a :Observation ;
    rdfs:label "Example observation 2"@en .

:meas1 a :Measurement ;
    rdfs:label "Example measurement 1"@en .

:val1 a :MeasuredValue ;
    rdfs:label "Example measured value 1"@en .

:unit1 a :BaseUnit ;
    rdfs:label "Example base unit 1"@en .

:sample1 a :WaterSample ;
    rdfs:label "Example water sample 1"@en .

:obs1 :hasMeasurement :meas1 ;
      :ofEntity :sample1 ;
      :hasContext :obs2 .

:meas1 :hasValue :val1 ;
       :measurementFor :obs1 ;
       :usesProtocol :protocol1 ;
       :usesStandard :standard1 .

:protocol1 a :Protocol ;
    rdfs:label "Example protocol"@en .

:standard1 a :Standard ;
    rdfs:label "Example standard"@en .

#################################################################
# SHACL shapes for minimal structural constraints
#################################################################

:ObservationShape a sh:NodeShape ;
    sh:targetClass :Observation ;
    sh:property [
        sh:path :hasMeasurement ;
        sh:class :Measurement ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :ofEntity ;
        sh:class :Entity ;
        sh:minCount 0 ;
    ] .

:MeasurementShape a sh:NodeShape ;
    sh:targetClass :Measurement ;
    sh:property [
        sh:path :hasValue ;
        sh:class :MeasuredValue ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :measurementFor ;
        sh:class :Observation ;
        sh:minCount 0 ;
    ] .