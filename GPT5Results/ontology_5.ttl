    rdfs:subClassOf aqua:MicrobialCommunity .

aqua:OrganicMatter a owl:Class ;
    rdfs:label "Organic matter"@en ;
    rdfs:subClassOf aqua:MaterialEntity .

aqua:SamplingMethod a owl:Class ;
    rdfs:label "Sampling method"@en ;
    rdfs:subClassOf aqua:ObservationMethod .

aqua:entityRelated a owl:ObjectProperty ;
    rdfs:label "entity related"@en ;
    rdfs:domain aqua:Entity ;
    rdfs:range aqua:Entity .

aqua:CharacteristicQualifier a owl:Class ;
    rdfs:label "Characteristic qualifier"@en ;
    rdfs:subClassOf aqua:Entity .

aqua:EnvironmentalSetting a owl:Class ;
    rdfs:label "Environmental setting"@en ;
    rdfs:subClassOf aqua:SpatialEntity .

aqua:GeologicalFormation a owl:Class ;
    rdfs:label "Geological formation"@en ;
    rdfs:subClassOf aqua:SpatialEntity .

aqua:Protocol a owl:Class ;
    rdfs:label "Protocol"@en ;
    rdfs:subClassOf aqua:Entity .

aqua:Standard a owl:Class ;
    rdfs:label "Standard"@en ;
    rdfs:subClassOf aqua:Entity .

aqua:Water a owl:Class ;
    rdfs:label "Water"@en ;
    rdfs:subClassOf aqua:MaterialEntity .

aqua:FunctionalGuild a owl:Class ;
    rdfs:label "Functional guild"@en ;
    rdfs:subClassOf aqua:MicrobialGuild .

aqua:Measurement a owl:Class ;
    rdfs:label "Measurement"@en ;
    rdfs:subClassOf aqua:Entity .

aqua:MeasurementType a owl:Class ;
    rdfs:label "Measurement type"@en ;
    rdfs:subClassOf aqua:Entity .

aqua:PhysicochemicalParameter a owl:Class ;
    rdfs:label "Physicochemical parameter"@en ;
    rdfs:subClassOf aqua:Characteristic .

aqua:Microorganism a owl:Class ;
    rdfs:label "Microorganism"@en ;
    rdfs:subClassOf aqua:MaterialEntity .

aqua:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:subClassOf aqua:Entity .

aqua:Characteristic a owl:Class ;
    rdfs:label "Characteristic"@en ;
    rdfs:subClassOf aqua:Entity .

aqua:MaterialEntity a owl:Class ;
    rdfs:label "Material entity"@en ;
    rdfs:subClassOf aqua:Entity .

aqua:SpatialEntity a owl:Class ;
    rdfs:label "Spatial entity"@en ;
    rdfs:subClassOf aqua:Entity .

aqua:Aquifer a owl:Class ;
    rdfs:label "Aquifer"@en ;
    rdfs:subClassOf aqua:SpatialEntity .

aqua:Process a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:subClassOf aqua:Entity .

aqua:Entity a owl:Class ;
    rdfs:label "Entity"@en .

