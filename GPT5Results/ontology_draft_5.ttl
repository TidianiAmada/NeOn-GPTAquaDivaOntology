### Individuals
:Project_A1 a :Project ; :name "AquaDiva Core Project" ; :status "active" .
:Org_A1 a :Organization ; :name "AquaDiva Institute" .
:Person_A1 a :Researcher ; :name "Researcher One" ; :age 34 ; :memberOf :Org_A1 .
:Person_A2 a :Researcher ; :name "Researcher Two" ; :age 41 ; :memberOf :Org_A1 .
:Site_A1 a :FieldStation ; :name "Forest Field Station" ; :latitude 50.1 ; :longitude 11.2 .
:Site_A2 a :FieldStation ; :name "River Field Station" ; :latitude 50.3 ; :longitude 11.5 .
:Plot_A1 a :Plot ; :name "Plot 1" ; :locatedIn :Site_A1 .
:Plot_A2 a :Plot ; :name "Plot 2" ; :locatedIn :Site_A2 .
:Soil_A1 a :SoilLayer ; :name "Topsoil Layer" ; :ph 6.4 .
:Sample_A1 a :SoilSample ; :name "Soil Sample A1" ; :sampleFrom :Site_A1 ; :locatedIn :Plot_A1 .
:Sample_A2 a :WaterSample ; :name "Water Sample A2" ; :sampleFrom :Site_A2 ; :locatedIn :Plot_A2 .
:Sensor_A1 a :Sensor ; :name "Temperature Sensor" ; :measures :TempObs_A1 .
:Obs_A1 a :Observation ; :name "General Observation" ; :observedIn :Experiment_A1 .
:TempObs_A1 a :Temperature ; :temperatureValue 18.6 ; :unit "C" .
:HumObs_A1 a :Humidity ; :humidityValue 72.1 ; :unit "%" .
:Experiment_A1 a :FieldExperiment ; :name "Microclimate Experiment" ; :hasObservation :Obs_A1 ; :usesTool :Sensor_A1 ; :tests :Hypothesis_A1 .
:Hypothesis_A1 a :Hypothesis ; :name "Nutrient enrichment increases plant growth" .
:Dataset_A1 a :Metadata ; :name "Metadata Set 1" ; :datasetOf :Project_A1 .
:Document_A1 a :Report ; :name "Annual Report" ; :describes :Project_A1 ; :version "1.0" .
:Plant_A1 a :Plant ; :name "Oak Tree" ; :hasHabitat :Habitat_A1 .
:Habitat_A1 a :Habitat ; :name "Temperate Forest Habitat" ; :hosts :Plant_A1 .
:Microbe_A1 a :Microbe ; :name "Soil Microbe A" ; :interactsWith :Plant_A1 .
:Nutrient_A1 a :Nitrogen ; :formula "N" ; :affectsGrowthOf :Plant_A1 .
:Climate_A1 a :Climate ; :name "Local Climate" .
:Weather_A1 a :Weather ; :name "Rain Event" ; :value 12.5 .
:Ecosystem_A1 a :Forest ; :name "Forest Ecosystem" ; :hasClimate :Climate_A1 .
:River_A1 a :River ; :name "Main River" ; :adjacentTo :Site_A2 .
:Lake_A1 a :Lake ; :name "Lake Alpha" ; :adjacentTo :River_A1 .
:Model_A1 a :HydrologicalModel ; :name "Hydro Model" ; :derivedFrom :Dataset_A1 .
:Report_A1 a :Publication ; :name "Published Findings" ; :describes :Experiment_A1 .

