# Conceptual ontology model capturing entities, properties, and their relations as subject-predicate-object triples.
# This Turtle document is intentionally structured as a compact, regularized representation of a large ontology.
# It includes:
# - Classes representing entities and property concepts
# - Object properties and datatype properties
# - Individuals
# - Extensive subclass hierarchy to reflect a high subclass count
# - Links among entities, properties, and individuals
# The ontology is self-contained and valid Turtle syntax.

@prefix : <http://example.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology ;
  rdfs:label "Conceptual Ontology Model"@en .

#################################################################
# Core meta-classes
#################################################################

:Entity a owl:Class ;
  rdfs:label "Entity"@en .

:PropertyConcept a owl:Class ;
  rdfs:label "Property Concept"@en .

:IndividualConcept a owl:Class ;
  rdfs:label "Individual Concept"@en .

:ClassConcept a owl:Class ;
  rdfs:label "Class Concept"@en .

:ObjectPropertyConcept a owl:Class ;
  rdfs:subClassOf :PropertyConcept ;
  rdfs:label "Object Property Concept"@en .

:DatatypePropertyConcept a owl:Class ;
  rdfs:subClassOf :PropertyConcept ;
  rdfs:label "Datatype Property Concept"@en .

#################################################################
# Top-level taxonomy
#################################################################

:RootEntity a owl:Class ;
  rdfs:subClassOf :Entity ;
  rdfs:label "Root Entity"@en .

:DomainEntity a owl:Class ;
  rdfs:subClassOf :RootEntity ;
  rdfs:label "Domain Entity"@en .

:AbstractEntity a owl:Class ;
  rdfs:subClassOf :RootEntity ;
  rdfs:label "Abstract Entity"@en .

:ConcreteEntity a owl:Class ;
  rdfs:subClassOf :DomainEntity ;
  rdfs:label "Concrete Entity"@en .

#################################################################
# Reified model for ontology components
#################################################################

:OntologyClass a owl:Class ;
  rdfs:subClassOf :ClassConcept ;
  rdfs:label "Ontology Class"@en .

:OntologyObjectProperty a owl:Class ;
  rdfs:subClassOf :ObjectPropertyConcept ;
  rdfs:label "Ontology Object Property"@en .

:OntologyDatatypeProperty a owl:Class ;
  rdfs:subClassOf :DatatypePropertyConcept ;
  rdfs:label "Ontology Datatype Property"@en .

:OntologyIndividual a owl:Class ;
  rdfs:subClassOf :IndividualConcept ;
  rdfs:label "Ontology Individual"@en .

#################################################################
# Property vocabulary
#################################################################

:hasSubject a owl:ObjectProperty ;
  rdfs:domain :Triple ;
  rdfs:range :Entity ;
  rdfs:label "has subject"@en .

:hasPredicate a owl:ObjectProperty ;
  rdfs:domain :Triple ;
  rdfs:range :PropertyConcept ;
  rdfs:label "has predicate"@en .

:hasObject a owl:ObjectProperty ;
  rdfs:domain :Triple ;
  rdfs:range :Entity ;
  rdfs:label "has object"@en .

:tripleOf a owl:ObjectProperty ;
  rdfs:domain :Triple ;
  rdfs:range :Ontology ;
  rdfs:label "triple of"@en .

:definesClass a owl:ObjectProperty ;
  rdfs:domain :Ontology ;
  rdfs:range :OntologyClass ;
  rdfs:label "defines class"@en .

:definesObjectProperty a owl:ObjectProperty ;
  rdfs:domain :Ontology ;
  rdfs:range :OntologyObjectProperty ;
  rdfs:label "defines object property"@en .

:definesDatatypeProperty a owl:ObjectProperty ;
  rdfs:domain :Ontology ;
  rdfs:range :OntologyDatatypeProperty ;
  rdfs:label "defines datatype property"@en .

:definesIndividual a owl:ObjectProperty ;
  rdfs:domain :Ontology ;
  rdfs:range :OntologyIndividual ;
  rdfs:label "defines individual"@en .

:subClassOfConcept a owl:ObjectProperty ;
  rdfs:subPropertyOf rdfs:subClassOf ;
  rdfs:label "subclass of concept"@en .

:relatedToConcept a owl:ObjectProperty ;
  rdfs:domain :Entity ;
  rdfs:range :Entity ;
  rdfs:label "related to concept"@en .

:hasName a owl:DatatypeProperty ;
  rdfs:domain :Entity ;
  rdfs:range xsd:string ;
  rdfs:label "has name"@en .

:hasIndex a owl:DatatypeProperty ;
  rdfs:domain :Entity ;
  rdfs:range xsd:integer ;
  rdfs:label "has index"@en .

#################################################################
# Triple class
#################################################################

:Triple a owl:Class ;
  rdfs:subClassOf :Entity ;
  rdfs:label "Triple"@en .

#################################################################
# Ontology-level individuals
#################################################################

:OntologyModel a :Ontology ;
  rdfs:label "Ontology Model"@en .

#################################################################
# Core class hierarchy
#################################################################

:Class_1 a owl:Class ; rdfs:subClassOf :OntologyClass ; rdfs:label "Class 1"@en .
:Class_2 a owl:Class ; rdfs:subClassOf :Class_1 ; rdfs:label "Class 2"@en .
:Class_3 a owl:Class ; rdfs:subClassOf :Class_2 ; rdfs:label "Class 3"@en .
:Class_4 a owl:Class ; rdfs:subClassOf :Class_3 ; rdfs:label "Class 4"@en .
:Class_5 a owl:Class ; rdfs:subClassOf :Class_4 ; rdfs:label "Class 5"@en .
:Class_6 a owl:Class ; rdfs:subClassOf :Class_5 ; rdfs:label "Class 6"@en .
:Class_7 a owl:Class ; rdfs:subClassOf :Class_6 ; rdfs:label "Class 7"@en .
:Class_8 a owl:Class ; rdfs:subClassOf :Class_7 ; rdfs:label "Class 8"@en .
:Class_9 a owl:Class ; rdfs:subClassOf :Class_8 ; rdfs:label "Class 9"@en .
:Class_10 a owl:Class ; rdfs:subClassOf :Class_9 ; rdfs:label "Class 10"@en .
:Class_11 a owl:Class ; rdfs:subClassOf :Class_10 ; rdfs:label "Class 11"@en .
:Class_12 a owl:Class ; rdfs:subClassOf :Class_11 ; rdfs:label "Class 12"@en .
:Class_13 a owl:Class ; rdfs:subClassOf :Class_12 ; rdfs:label "Class 13"@en .
:Class_14 a owl:Class ; rdfs:subClassOf :Class_13 ; rdfs:label "Class 14"@en .
:Class_15 a owl:Class ; rdfs:subClassOf :Class_14 ; rdfs:label "Class 15"@en .
:Class_16 a owl:Class ; rdfs:subClassOf :Class_15 ; rdfs:label "Class 16"@en .
:Class_17 a owl:Class ; rdfs:subClassOf :Class_16 ; rdfs:label "Class 17"@en .
:Class_18 a owl:Class ; rdfs:subClassOf :Class_17 ; rdfs:label "Class 18"@en .
:Class_19 a owl:Class ; rdfs:subClassOf :Class_18 ; rdfs:label "Class 19"@en .
:Class_20 a owl:Class ; rdfs:subClassOf :Class_19 ; rdfs:label "Class 20"@en .
:Class_21 a owl:Class ; rdfs:subClassOf :Class_20 ; rdfs:label "Class 21"@en .
:Class_22 a owl:Class ; rdfs:subClassOf :Class_21 ; rdfs:label "Class 22"@en .
:Class_23 a owl:Class ; rdfs:subClassOf :Class_22 ; rdfs:label "Class 23"@en .
:Class_24 a owl:Class ; rdfs:subClassOf :Class_23 ; rdfs:label "Class 24"@en .
:Class_25 a owl:Class ; rdfs:subClassOf :Class_24 ; rdfs:label "Class 25"@en .
:Class_26 a owl:Class ; rdfs:subClassOf :Class_25 ; rdfs:label "Class 26"@en .
:Class_27 a owl:Class ; rdfs:subClassOf :Class_26 ; rdfs:label "Class 27"@en .
:Class_28 a owl:Class ; rdfs:subClassOf :Class_27 ; rdfs:label "Class 28"@en .
:Class_29 a owl:Class ; rdfs:subClassOf :Class_28 ; rdfs:label "Class 29"@en .
:Class_30 a owl:Class ; rdfs:subClassOf :Class_29 ; rdfs:label "Class 30"@en .
:Class_31 a owl:Class ; rdfs:subClassOf :Class_30 ; rdfs:label "Class 31"@en .
:Class_32 a owl:Class ; rdfs:subClassOf :Class_31 ; rdfs:label "Class 32"@en .
:Class_33 a owl:Class ; rdfs:subClassOf :Class_32 ; rdfs:label "Class 33"@en .
:Class_34 a owl:Class ; rdfs:subClassOf :Class_33 ; rdfs:label "Class 34"@en .
:Class_35 a owl:Class ; rdfs:subClassOf :Class_34 ; rdfs:label "Class 35"@en .
:Class_36 a owl:Class ; rdfs:subClassOf :Class_35 ; rdfs:label "Class 36"@en .
:Class_37 a owl:Class ; rdfs:subClassOf :Class_36 ; rdfs:label "Class 37"@en .
:Class_38 a owl:Class ; rdfs:subClassOf :Class_37 ; rdfs:label "Class 38"@en .
:Class_39 a owl:Class ; rdfs:subClassOf :Class_38 ; rdfs:label "Class 39"@en .
:Class_40 a owl:Class ; rdfs:subClassOf :Class_39 ; rdfs:label "Class 40"@en .
:Class_41 a owl:Class ; rdfs:subClassOf :Class_40 ; rdfs:label "Class 41"@en .
:Class_42 a owl:Class ; rdfs:subClassOf :Class_41 ; rdfs:label "Class 42"@en .
:Class_43 a owl:Class ; rdfs:subClassOf :Class_42 ; rdfs:label "Class 43"@en .
:Class_44 a owl:Class ; rdfs:subClassOf :Class_43 ; rdfs:label "Class 44"@en .
:Class_45 a owl:Class ; rdfs:subClassOf :Class_44 ; rdfs:label "Class 45"@en .
:Class_46 a owl:Class ; rdfs:subClassOf :Class_45 ; rdfs:label "Class 46"@en .
:Class_47 a owl:Class ; rdfs:subClassOf :Class_46 ; rdfs:label "Class 47"@en .
:Class_48 a owl:Class ; rdfs:subClassOf :Class_47 ; rdfs:label "Class 48"@en .
:Class_49 a owl:Class ; rdfs:subClassOf :Class_48 ; rdfs:label "Class 49"@en .
:Class_50 a owl:Class ; rdfs:subClassOf :Class_49 ; rdfs:label "Class 50"@en .

#################################################################
# Object property hierarchy
#################################################################

:ObjectProperty_1 a owl:ObjectProperty ; rdfs:subPropertyOf :relatedToConcept ; rdfs:label "Object Property 1"@en .
:ObjectProperty_2 a owl:ObjectProperty ; rdfs:subPropertyOf :ObjectProperty_1 ; rdfs:label "Object Property 2"@en .
:ObjectProperty_3 a owl:ObjectProperty ; rdfs:subPropertyOf :ObjectProperty_2 ; rdfs:label "Object Property 3"@en .
:ObjectProperty_4 a owl:ObjectProperty ; rdfs:subPropertyOf :ObjectProperty_3 ; rdfs:label "Object Property 4"@en .
:ObjectProperty_5 a owl:ObjectProperty ; rdfs:subPropertyOf :ObjectProperty_4 ; rdfs:label "Object Property 5"@en .
:ObjectProperty_6 a owl:ObjectProperty ; rdfs:subPropertyOf :ObjectProperty_5 ; rdfs:label "Object Property 6"@en .
:ObjectProperty_7 a owl:ObjectProperty ; rdfs:subPropertyOf :ObjectProperty_6 ; rdfs:label "Object Property 7"@en .
:ObjectProperty_8 a owl:ObjectProperty ; rdfs:subPropertyOf :ObjectProperty_7 ; rdfs:label "Object Property 8"@en .
:ObjectProperty_9 a owl:ObjectProperty ; rdfs:subPropertyOf :ObjectProperty_8 ; rdfs:label "Object Property 9"@en .
:ObjectProperty_10 a owl:ObjectProperty ; rdfs:subPropertyOf :ObjectProperty_9 ; rdfs:label "Object Property 10"@en .

#################################################################
# Datatype property hierarchy
#################################################################

:DatatypeProperty_1 a owl:DatatypeProperty ; rdfs:subPropertyOf :hasName ; rdfs:label "Datatype Property 1"@en .
:DatatypeProperty_2 a owl:DatatypeProperty ; rdfs:subPropertyOf :DatatypeProperty_1 ; rdfs:label "Datatype Property 2"@en .
:DatatypeProperty_3 a owl:DatatypeProperty ; rdfs:subPropertyOf :DatatypeProperty_2 ; rdfs:label "Datatype Property 3"@en .
:DatatypeProperty_4 a owl:DatatypeProperty ; rdfs:subPropertyOf :DatatypeProperty_3 ; rdfs:label "Datatype Property 4"@en .
:DatatypeProperty_5 a owl:DatatypeProperty ; rdfs:subPropertyOf :DatatypeProperty_4 ; rdfs:label "Datatype Property 5"@en .

#################################################################
# Individuals
#################################################################

:Individual_1 a :OntologyIndividual ; :hasName "Individual 1" ; :hasIndex 1 .
:Individual_2 a :OntologyIndividual ; :hasName "Individual 2" ; :hasIndex 2 .
:Individual_3 a :OntologyIndividual ; :hasName "Individual 3" ; :hasIndex 3 .
:Individual_4 a :OntologyIndividual ; :hasName "Individual 4" ; :hasIndex 4 .
:Individual_5 a :OntologyIndividual ; :hasName "Individual 5" ; :hasIndex 5 .
:Individual_6 a :OntologyIndividual ; :hasName "Individual 6" ; :hasIndex 6 .
:Individual_7 a :OntologyIndividual ; :hasName "Individual 7" ; :hasIndex 7 .
:Individual_8 a :OntologyIndividual ; :hasName "Individual 8" ; :hasIndex 8 .
:Individual_9 a :OntologyIndividual ; :hasName "Individual 9" ; :hasIndex 9 .
:Individual_10 a :OntologyIndividual ; :hasName "Individual 10" ; :hasIndex 10 .

#################################################################
# Representative entity-property-object triples
#################################################################

:Triple_1 a :Triple ; :hasSubject :Class_1 ; :hasPredicate :subClassOfConcept ; :hasObject :Entity ; :tripleOf :OntologyModel .
:Triple_2 a :Triple ; :hasSubject :Class_2 ; :hasPredicate :subClassOfConcept ; :hasObject :Class_1 ; :tripleOf :OntologyModel .
:Triple_3 a :Triple ; :hasSubject :Class_3 ; :hasPredicate :subClassOfConcept ; :hasObject :Class_2 ; :tripleOf :OntologyModel .
:Triple_4 a :Triple ; :hasSubject :Class_4 ; :hasPredicate :subClassOfConcept ; :hasObject :Class_3 ; :tripleOf :OntologyModel .
:Triple_5 a :Triple ; :hasSubject :Class_5 ; :hasPredicate :subClassOfConcept ; :hasObject :Class_4 ; :tripleOf :OntologyModel .
:Triple_6 a :Triple ; :hasSubject :Class_6 ; :hasPredicate :subClassOfConcept ; :hasObject :Class_5 ; :tripleOf :OntologyModel .
:Triple_7 a :Triple ; :hasSubject :Class_7 ; :hasPredicate :subClassOfConcept ; :hasObject :Class_6 ; :tripleOf :OntologyModel .
:Triple_8 a :Triple ; :hasSubject :Class_8 ; :hasPredicate :subClassOfConcept ; :hasObject :Class_7 ; :tripleOf :OntologyModel .
:Triple_9 a :Triple ; :hasSubject :Class_9 ; :hasPredicate :subClassOfConcept ; :hasObject :Class_8 ; :tripleOf :OntologyModel .
:Triple_10 a :Triple ; :hasSubject :Class_10 ; :hasPredicate :subClassOfConcept ; :hasObject :Class_9 ; :tripleOf :OntologyModel .

#################################################################
# Class definitions connected to ontology model
#################################################################

:OntologyModel :definesClass :Class_1, :Class_2, :Class_3, :Class_4, :Class_5, :Class_6, :Class_7, :Class_8, :Class_9, :Class_10 ;
  :definesObjectProperty :ObjectProperty_1, :ObjectProperty_2, :ObjectProperty_3, :ObjectProperty_4, :ObjectProperty_5 ;
  :definesDatatypeProperty :DatatypeProperty_1, :DatatypeProperty_2, :DatatypeProperty_3 ;
  :definesIndividual :Individual_1, :Individual_2, :Individual_3, :Individual_4, :Individual_5 .

#################################################################
# Extended high-subclass pattern
#################################################################

:Class_51 a owl:Class ; rdfs:subClassOf :Class_50 ; rdfs:label "Class 51"@en .
:Class_52 a owl:Class ; rdfs:subClassOf :Class_51 ; rdfs:label "Class 52"@en .
:Class_53 a owl:Class ; rdfs:subClassOf :Class_52 ; rdfs:label "Class 53"@en .
:Class_54 a owl:Class ; rdfs:subClassOf :Class_53 ; rdfs:label "Class 54"@en .
:Class_55 a owl:Class ; rdfs:subClassOf :Class_54 ; rdfs:label "Class 55"@en .
:Class_56 a owl:Class ; rdfs:subClassOf :Class_55 ; rdfs:label "Class 56"@en .
:Class_57 a owl:Class ; rdfs:subClassOf :Class_56 ; rdfs:label "Class 57"@en .
:Class_58 a owl:Class ; rdfs:subClassOf :Class_57 ; rdfs:label "Class 58"@en .
:Class_59 a owl:Class ; rdfs:subClassOf :Class_58 ; rdfs:label "Class 59"@en .
:Class_60 a owl:Class ; rdfs:subClassOf :Class_59 ; rdfs:label "Class 60"@en .