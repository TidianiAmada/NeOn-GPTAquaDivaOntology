### Object properties
:hasPart a owl:ObjectProperty ; rdfs:domain :Entity ; rdfs:range :Entity .
:partOf a owl:ObjectProperty ; owl:inverseOf :hasPart ; rdfs:domain :Entity ; rdfs:range :Entity .
:hasAgent a owl:ObjectProperty ; rdfs:domain :Activity ; rdfs:range :Agent .
:participatesIn a owl:ObjectProperty ; owl:inverseOf :hasAgent ; rdfs:domain :Agent ; rdfs:range :Activity .
:locatedIn a owl:ObjectProperty ; rdfs:domain :Entity ; rdfs:range :Location .
:contains a owl:ObjectProperty ; owl:inverseOf :locatedIn ; rdfs:domain :Location ; rdfs:range :Entity .
:hasMember a owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :Person .
:memberOf a owl:ObjectProperty ; owl:inverseOf :hasMember ; rdfs:domain :Person ; rdfs:range :Organization .
:hasProject a owl:ObjectProperty ; rdfs:domain :Organization ; rdfs:range :Project .
:projectOf a owl:ObjectProperty ; owl:inverseOf :hasProject ; rdfs:domain :Project ; rdfs:range :Organization .
:usesTool a owl:ObjectProperty ; rdfs:domain :Activity ; rdfs:range :Tool .
:usedIn a owl:ObjectProperty ; owl:inverseOf :usesTool ; rdfs:domain :Tool ; rdfs:range :Activity .
:hasObservation a owl:ObjectProperty ; rdfs:domain :Process ; rdfs:range :Observation .
:observedIn a owl:ObjectProperty ; owl:inverseOf :hasObservation ; rdfs:domain :Observation ; rdfs:range :Process .
:hasMeasurement a owl:ObjectProperty ; rdfs:domain :Observation ; rdfs:range :Measurement .
:measurementOf a owl:ObjectProperty ; owl:inverseOf :hasMeasurement ; rdfs:domain :Measurement ; rdfs:range :Observation .
:hasDataset a owl:ObjectProperty ; rdfs:domain :Project ; rdfs:range :Dataset .
:datasetOf a owl:ObjectProperty ; owl:inverseOf :hasDataset ; rdfs:domain :Dataset ; rdfs:range :Project .
:describes a owl:ObjectProperty ; rdfs:domain :Document ; rdfs:range :Entity .
:isDescribedBy a owl:ObjectProperty ; owl:inverseOf :describes ; rdfs:domain :Entity ; rdfs:range :Document .
:derivedFrom a owl:ObjectProperty ; rdfs:domain :Dataset ; rdfs:range :Dataset .
:supports a owl:ObjectProperty ; rdfs:domain :Dataset ; rdfs:range :Hypothesis .
:tests a owl:ObjectProperty ; rdfs:domain :Experiment ; rdfs:range :Hypothesis .
:produces a owl:ObjectProperty ; rdfs:domain :Process ; rdfs:range :Dataset .
:consumes a owl:ObjectProperty ; rdfs:domain :Process ; rdfs:range :Resource .
:hasSample a owl:ObjectProperty ; rdfs:domain :Site ; rdfs:range :Sample .
:sampleFrom a owl:ObjectProperty ; owl:inverseOf :hasSample ; rdfs:domain :Sample ; rdfs:range :Site .
:hasSensor a owl:ObjectProperty ; rdfs:domain :Facility ; rdfs:range :Sensor .
:measures a owl:ObjectProperty ; rdfs:domain :Sensor ; rdfs:range :Measurement .
:records a owl:ObjectProperty ; rdfs:domain :Sensor ; rdfs:range :Observation .
:dependsOn a owl:ObjectProperty ; rdfs:domain :Entity ; rdfs:range :Entity .
:influences a owl:ObjectProperty ; rdfs:domain :Entity ; rdfs:range :Entity .
:interactsWith a owl:ObjectProperty ; rdfs:domain :BiologicalEntity ; rdfs:range :BiologicalEntity .
:coOccursWith a owl:ObjectProperty ; rdfs:domain :BiologicalEntity ; rdfs:range :BiologicalEntity .
:hasHabitat a owl:ObjectProperty ; rdfs:domain :BiologicalEntity ; rdfs:range :Habitat .
:hosts a owl:ObjectProperty ; rdfs:domain :Habitat ; rdfs:range :BiologicalEntity .
:hasClimate a owl:ObjectProperty ; rdfs:domain :Ecosystem ; rdfs:range :Climate .
:hasWeatherEvent a owl:ObjectProperty ; rdfs:domain :Climate ; rdfs:range :Weather .
:affectsGrowthOf a owl:ObjectProperty ; rdfs:domain :Nutrient ; rdfs:range :Plant .
:locatedAt a owl:ObjectProperty ; rdfs:domain :Entity ; rdfs:range :Location .
:adjacentTo a owl:ObjectProperty ; rdfs:domain :Location ; rdfs:range :Location .

