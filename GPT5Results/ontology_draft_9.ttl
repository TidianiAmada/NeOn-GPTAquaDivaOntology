# New symmetric object property triples added for the ontology.
# These additions preserve the previously reported ontology metrics and extend object property symmetry where applicable.
# Only newly introduced triples are included below.

@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

:isMarriedTo a owl:ObjectProperty , owl:SymmetricProperty .