# New functional property triples for the ontology.
# These add owl:FunctionalProperty declarations for object properties that were missing them.
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<http://example.org/ontology/hasAddress> a owl:FunctionalProperty .
<http://example.org/ontology/hasAuthor> a owl:FunctionalProperty .
<http://example.org/ontology/hasBirthPlace> a owl:FunctionalProperty .
<http://example.org/ontology/hasBudget> a owl:FunctionalProperty .
<http://example.org/ontology/hasCategory> a owl:FunctionalProperty .
<http://example.org/ontology/hasCity> a owl:FunctionalProperty .
<http://example.org/ontology/hasCountry> a owl:FunctionalProperty .
<http://example.org/ontology/hasCurrency> a owl:FunctionalProperty .
<http://example.org/ontology/hasDate> a owl:FunctionalProperty .
<http://example.org/ontology/hasDepartment> a owl:FunctionalProperty .
<http://example.org/ontology/hasDescription> a owl:FunctionalProperty .
<http://example.org/ontology/hasEmail> a owl:FunctionalProperty .
<http://example.org/ontology/hasEndDate> a owl:FunctionalProperty .
<http://example.org/ontology/hasEventDate> a owl:FunctionalProperty .
<http://example.org/ontology/hasFacility> a owl:FunctionalProperty .
<http://example.org/ontology/hasFirstName> a owl:FunctionalProperty .
<http://example.org/ontology/hasGender> a owl:FunctionalProperty .
<http://example.org/ontology/hasIdentifier> a owl:FunctionalProperty .
<http://example.org/ontology/hasIssueDate> a owl:FunctionalProperty .
<http://example.org/ontology/hasLastName> a owl:FunctionalProperty .
<http://example.org/ontology/hasLatitude> a owl:FunctionalProperty .
<http://example.org/ontology/hasLocation> a owl:FunctionalProperty .
<http://example.org/ontology/hasLongitude> a owl:FunctionalProperty .
<http://example.org/ontology/hasName> a owl:FunctionalProperty .
<http://example.org/ontology/hasNumber> a owl:FunctionalProperty .
<http://example.org/ontology/hasParent> a owl:FunctionalProperty .
<http://example.org/ontology/hasPhone> a owl:FunctionalProperty .
<http://example.org/ontology/hasPostalCode> a owl:FunctionalProperty .
<http://example.org/ontology/hasPriority> a owl:FunctionalProperty .
<http://example.org/ontology/hasRegion> a owl:FunctionalProperty .
<http://example.org/ontology/hasStartDate> a owl:FunctionalProperty .
<http://example.org/ontology/hasStatus> a owl:FunctionalProperty .
<http://example.org/ontology/hasStreet> a owl:FunctionalProperty .
<http://example.org/ontology/hasType> a owl:FunctionalProperty .
<http://example.org/ontology/hasURL> a owl:FunctionalProperty .
<http://example.org/ontology/isActive> a owl:FunctionalProperty .
<http://example.org/ontology/isMemberOf> a owl:FunctionalProperty .
<http://example.org/ontology/isPartOf> a owl:FunctionalProperty .
<http://example.org/ontology/locatedIn> a owl:FunctionalProperty .
<http://example.org/ontology/relatedTo> a owl:FunctionalProperty .