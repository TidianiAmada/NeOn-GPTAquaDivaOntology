# New triples added to declare functional object properties across the ontology.
# These are intended to constrain relevant object properties to a single value.
# Output contains only the added axioms in valid Turtle syntax.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://example.org/ontology#> .

:hasAuthor a owl:ObjectProperty, owl:FunctionalProperty .
:hasBirthPlace a owl:ObjectProperty, owl:FunctionalProperty .
:hasBirthDate a owl:ObjectProperty, owl:FunctionalProperty .
:hasDeathDate a owl:ObjectProperty, owl:FunctionalProperty .
:hasGender a owl:ObjectProperty, owl:FunctionalProperty .
:hasNationality a owl:ObjectProperty, owl:FunctionalProperty .
:hasLanguage a owl:ObjectProperty, owl:FunctionalProperty .
:hasLocation a owl:ObjectProperty, owl:FunctionalProperty .
:hasCountry a owl:ObjectProperty, owl:FunctionalProperty .
:hasCity a owl:ObjectProperty, owl:FunctionalProperty .
:hasRegion a owl:ObjectProperty, owl:FunctionalProperty .
:hasAddress a owl:ObjectProperty, owl:FunctionalProperty .
:hasEmail a owl:ObjectProperty, owl:FunctionalProperty .
:hasPhoneNumber a owl:ObjectProperty, owl:FunctionalProperty .
:hasWebsite a owl:ObjectProperty, owl:FunctionalProperty .
:hasManager a owl:ObjectProperty, owl:FunctionalProperty .
:hasSupervisor a owl:ObjectProperty, owl:FunctionalProperty .
:hasOwner a owl:ObjectProperty, owl:FunctionalProperty .
:hasPresident a owl:ObjectProperty, owl:FunctionalProperty .
:hasChairperson a owl:ObjectProperty, owl:FunctionalProperty .
:hasHeadquarters a owl:ObjectProperty, owl:FunctionalProperty .
:hasCapital a owl:ObjectProperty, owl:FunctionalProperty .
:hasCurrency a owl:ObjectProperty, owl:FunctionalProperty .
:hasIdentifier a owl:ObjectProperty, owl:FunctionalProperty .
:hasCode a owl:ObjectProperty, owl:FunctionalProperty .
:hasStatus a owl:ObjectProperty, owl:FunctionalProperty .
:hasType a owl:ObjectProperty, owl:FunctionalProperty .
:hasCategory a owl:ObjectProperty, owl:FunctionalProperty .
:hasStartDate a owl:ObjectProperty, owl:FunctionalProperty .
:hasEndDate a owl:ObjectProperty, owl:FunctionalProperty .
:hasMember a owl:ObjectProperty, owl:FunctionalProperty .
:hasPart a owl:ObjectProperty, owl:FunctionalProperty .
:hasParent a owl:ObjectProperty, owl:FunctionalProperty .