<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#Class">
    <rdfs:comment>The class of all OWL classes.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#DatatypeProperty">
    <rdfs:comment>The class of all OWL datatype properties.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#AnnotationProperty">
    <rdfs:comment>The class of all OWL annotation properties.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#ObjectProperty">
    <rdfs:comment>The class of all OWL object properties.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/iao.owl#InformationArtifactOntology">
    <rdfs:comment>The ontology that provides terms for information artifacts and related concepts.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
