<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.org/aquadiva#measuresEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">measuresEntity</rdfs:label>
    <rdfs:comment xml:lang="en">Links a measurement type to the kind of entity it measures.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#MeasurementType"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#MicrobialEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Entity"/>
    <rdfs:label xml:lang="en">Microbial Entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#relatesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">relatesTo</rdfs:label>
    <rdfs:comment xml:lang="en">General relation between entities or observations.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Entity"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasMember</rdfs:label>
    <rdfs:comment xml:lang="en">Links an observation collection to a contained observation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#ObservationCollection"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Observation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Biofilm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#MicrobialCommunity"/>
    <rdfs:label xml:lang="en">Biofilm</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasBaseQualifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasBaseQualifier</rdfs:label>
    <rdfs:comment xml:lang="en">Links a composite characteristic qualifier to its base qualifier.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#CompositeCharacteristicQualifier"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#BaseCharacteristicQualifier"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#PrefixedUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Unit"/>
    <rdfs:label xml:lang="en">Prefixed Unit</rdfs:label>
    <rdfs:comment xml:lang="en">A unit modified by a prefix such as kilo- or milli-.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasQualifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasQualifier</rdfs:label>
    <rdfs:comment xml:lang="en">Links a measured characteristic to a qualifier refining it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#MeasuredCharacteristic"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#CharacteristicQualifier"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#measuresUsingProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">measuresUsingProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Links a measurement type to a protocol used for measurement.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#MeasurementType"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Protocol"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasMeasurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasMeasurement</rdfs:label>
    <rdfs:comment xml:lang="en">Links an observation to one of its measurements.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Observation"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Measurement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Bacterium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Microbe"/>
    <rdfs:label xml:lang="en">Bacterium</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/aquadiva#hasNextQualifier"/>
    <owl:someValuesFrom rdf:resource="http://example.org/aquadiva#CharacteristicQualifier"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Archaea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Microbe"/>
    <rdfs:label xml:lang="en">Archaea</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasNextQualifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasNextQualifier</rdfs:label>
    <rdfs:comment xml:lang="en">Links a composite characteristic qualifier to the next qualifier in the chain.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#CompositeCharacteristicQualifier"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#CharacteristicQualifier"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#unitLabel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">unitLabel</rdfs:label>
    <rdfs:comment xml:lang="en">Human-readable label for a unit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Unit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasObservedRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasObservedRelation</rdfs:label>
    <rdfs:comment xml:lang="en">Links an observation to an observed relation present in the observation.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Observation"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#ObservedRelation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#MeasurementType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Measurement Type</rdfs:label>
    <rdfs:comment xml:lang="en">A type of measurement defining what is measured and how.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#inCollection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">inCollection</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse relation of hasMember.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://example.org/aquadiva#hasMember"/>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Observation"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#ObservationCollection"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasValue</rdfs:label>
    <rdfs:comment xml:lang="en">Links a measurement to its measured value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Measurement"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#MeasuredValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#ofEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">ofEntity</rdfs:label>
    <rdfs:comment xml:lang="en">Links an observation to the entity being observed.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Observation"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#ObservedRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Observed Relation</rdfs:label>
    <rdfs:comment xml:lang="en">A relation observed between entities or observations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#HydrogeologicalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Entity"/>
    <rdfs:label xml:lang="en">Hydrogeological Entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Observation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Entity"/>
    <rdfs:subClassOf rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb2"/>
    <rdfs:label xml:lang="en">Observation</rdfs:label>
    <rdfs:comment xml:lang="en">An observation of one or more entities in a particular context.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Characteristic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Entity"/>
    <rdfs:label xml:lang="en">Characteristic</rdfs:label>
    <rdfs:comment xml:lang="en">A property or feature of an entity that can be observed or measured.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Conduit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#KarstSystem"/>
    <rdfs:label xml:lang="en">Conduit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#measuresUsingStandard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">measuresUsingStandard</rdfs:label>
    <rdfs:comment xml:lang="en">Links a measurement type to a standard used for measurement.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#MeasurementType"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Standard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#CompositeCharacteristicQualifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#CharacteristicQualifier"/>
    <rdfs:subClassOf rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb4"/>
    <rdfs:subClassOf rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb5"/>
    <rdfs:label xml:lang="en">Composite Characteristic Qualifier</rdfs:label>
    <rdfs:comment xml:lang="en">A qualifier composed of one or more component qualifiers.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasSourceUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasSourceUnit</rdfs:label>
    <rdfs:comment xml:lang="en">Links a unit conversion to its source unit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#UnitConversion"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Unit"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#GeochemicalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Entity"/>
    <rdfs:label xml:lang="en">Geochemical Entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#ofCharacteristic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">ofCharacteristic</rdfs:label>
    <rdfs:comment xml:lang="en">Links a measurement to the characteristic it represents.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Measurement"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Characteristic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#KarstSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#HydrogeologicalEntity"/>
    <rdfs:label xml:lang="en">Karst System</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/aquadiva#hasMember"/>
    <owl:someValuesFrom rdf:resource="http://example.org/aquadiva#Observation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#entityRelated">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">entityRelated</rdfs:label>
    <rdfs:comment xml:lang="en">Relates entities observed in different observations.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Observation"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Observation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#BaseUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Unit"/>
    <rdfs:label xml:lang="en">Base Unit</rdfs:label>
    <rdfs:comment xml:lang="en">A fundamental unit in a unit system.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#SedimentSample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#GeochemicalEntity"/>
    <rdfs:label xml:lang="en">Sediment Sample</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Measurement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Measurement</rdfs:label>
    <rdfs:comment xml:lang="en">A quantified result associated with an observation.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasUnit</rdfs:label>
    <rdfs:comment xml:lang="en">Links composite, derived, or prefixed units to the unit they are based on or composed from.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Unit"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Unit"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/aquadiva#hasTargetUnit"/>
    <owl:someValuesFrom rdf:resource="http://example.org/aquadiva#Unit"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#GroundwaterSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#HydrogeologicalEntity"/>
    <rdfs:label xml:lang="en">Groundwater System</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#BaseCharacteristicQualifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#CharacteristicQualifier"/>
    <rdfs:label xml:lang="en">Base Characteristic Qualifier</rdfs:label>
    <rdfs:comment xml:lang="en">The base component of a composite characteristic qualifier.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Entity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Entity</rdfs:label>
    <rdfs:comment xml:lang="en">Any domain entity that can be observed or measured.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#WaterSample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#GeochemicalEntity"/>
    <rdfs:label xml:lang="en">Water Sample</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/aquadiva#hasBaseQualifier"/>
    <owl:someValuesFrom rdf:resource="http://example.org/aquadiva#BaseCharacteristicQualifier"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#DerivedUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Unit"/>
    <rdfs:label xml:lang="en">Derived Unit</rdfs:label>
    <rdfs:comment xml:lang="en">A unit derived from one or more base units.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#ChemicalSpecies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#GeochemicalEntity"/>
    <rdfs:label xml:lang="en">Chemical Species</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Microbe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#MicrobialEntity"/>
    <rdfs:label xml:lang="en">Microbe</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#textValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">textValue</rdfs:label>
    <rdfs:comment xml:lang="en">Textual representation of a measured value when numeric values are not sufficient.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#MeasuredValue"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">AquaDiva Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">Ontology for groundwater ecosystems, microbial ecology, hydrogeology, karst systems, and geochemistry.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasObservedCharacteristic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasObservedCharacteristic</rdfs:label>
    <rdfs:comment xml:lang="en">Links an observation to a characteristic that was observed.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Observation"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Characteristic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Standard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Standard</rdfs:label>
    <rdfs:comment xml:lang="en">A standard used to normalize or interpret measurements.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#usesProtocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">usesProtocol</rdfs:label>
    <rdfs:comment xml:lang="en">Links a measurement to the protocol used.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Measurement"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Protocol"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#GroundwaterHabitat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Habitat"/>
    <rdfs:label xml:lang="en">Groundwater Habitat</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#UnitConversion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Unit Conversion</rdfs:label>
    <rdfs:comment xml:lang="en">A conversion specification between a source and a target unit.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb6"/>
    <rdfs:subClassOf rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb7"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#KarstHabitat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Habitat"/>
    <rdfs:label xml:lang="en">Karst Habitat</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Protocol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Protocol</rdfs:label>
    <rdfs:comment xml:lang="en">A standardized procedure used for observation or measurement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#CharacteristicQualifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Characteristic Qualifier</rdfs:label>
    <rdfs:comment xml:lang="en">A qualifier that refines the interpretation of a characteristic.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Context">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Context</rdfs:label>
    <rdfs:comment xml:lang="en">A contextual entity or condition for an observation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/aquadiva#ofEntity"/>
    <owl:someValuesFrom rdf:resource="http://example.org/aquadiva#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Habitat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#EnvironmentalEntity"/>
    <rdfs:label xml:lang="en">Habitat</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#ObservationCollection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Entity"/>
    <rdfs:subClassOf rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb3"/>
    <rdfs:label xml:lang="en">Observation Collection</rdfs:label>
    <rdfs:comment xml:lang="en">A collection of observations grouped for analysis or comparison.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#characteristicFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">characteristicFor</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a characteristic with the entity it characterizes.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Characteristic"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#numericValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">numericValue</rdfs:label>
    <rdfs:comment xml:lang="en">Numeric representation of a measured value.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#MeasuredValue"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Spring">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#GroundwaterSystem"/>
    <rdfs:label xml:lang="en">Spring</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#resultOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">resultOf</rdfs:label>
    <rdfs:comment xml:lang="en">General inverse relation for outputs of measurements or observations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#CompositeUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Unit"/>
    <rdfs:label xml:lang="en">Composite Unit</rdfs:label>
    <rdfs:comment xml:lang="en">A unit composed of multiple units combined by multiplication or division.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#MicrobialCommunity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#MicrobialEntity"/>
    <rdfs:label xml:lang="en">Microbial Community</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#usesStandard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">usesStandard</rdfs:label>
    <rdfs:comment xml:lang="en">Links a measurement to the standard used.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Measurement"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Standard"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#measurementFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">measurementFor</rdfs:label>
    <rdfs:comment xml:lang="en">Links a measurement to the observation it belongs to.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Measurement"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Observation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#EnvironmentalEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Entity"/>
    <rdfs:label xml:lang="en">Environmental Entity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#MeasuredValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Measured Value</rdfs:label>
    <rdfs:comment xml:lang="en">A numeric or symbolic value obtained from a measurement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#measuresCharacteristic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">measuresCharacteristic</rdfs:label>
    <rdfs:comment xml:lang="en">Links a measurement type to the characteristic it measures.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#MeasurementType"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Characteristic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#MeasuredCharacteristic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Characteristic"/>
    <rdfs:label xml:lang="en">Measured Characteristic</rdfs:label>
    <rdfs:comment xml:lang="en">A characteristic that is directly measured or inferred from a measurement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#KarstAquifer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Aquifer"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#KarstSystem"/>
    <rdfs:label xml:lang="en">Karst Aquifer</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasContextualEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasContextualEntity</rdfs:label>
    <rdfs:comment xml:lang="en">Links a context to the entity representing that context.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Context"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/aquadiva#hasSourceUnit"/>
    <owl:someValuesFrom rdf:resource="http://example.org/aquadiva#Unit"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd501c4be9e2643adbec3dc0f662f46bbb1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/aquadiva#hasValue"/>
    <owl:someValuesFrom rdf:resource="http://example.org/aquadiva#MeasuredValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasContext</rdfs:label>
    <rdfs:comment xml:lang="en">Links an observation to another observation providing context.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#Observation"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Observation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Unit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Unit</rdfs:label>
    <rdfs:comment xml:lang="en">A unit of measurement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#hasTargetUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasTargetUnit</rdfs:label>
    <rdfs:comment xml:lang="en">Links a unit conversion to its target unit.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/aquadiva#UnitConversion"/>
    <rdfs:range rdf:resource="http://example.org/aquadiva#Unit"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Cave">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#KarstSystem"/>
    <rdfs:label xml:lang="en">Cave</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Aquifer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#GroundwaterSystem"/>
    <rdfs:label xml:lang="en">Aquifer</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/aquadiva#Fungus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://example.org/aquadiva#Microbe"/>
    <rdfs:label xml:lang="en">Fungus</rdfs:label>
  </rdf:Description>
</rdf:RDF>
