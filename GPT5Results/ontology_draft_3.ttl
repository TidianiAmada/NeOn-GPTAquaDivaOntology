### Properties

aq:hasHabitat a owl:ObjectProperty ;
    rdfs:domain aq:Organism ;
    rdfs:range aq:Habitat .

aq:hasMember a owl:ObjectProperty ;
    rdfs:domain aq:Habitat ;
    rdfs:range aq:Organism .

aq:occursIn a owl:ObjectProperty ;
    rdfs:domain aq:Organism ;
    rdfs:range aq:Habitat .

aq:hasGuild a owl:ObjectProperty ;
    rdfs:domain aq:Microbe ;
    rdfs:range aq:FunctionalGuild .

aq:participatesIn a owl:ObjectProperty ;
    rdfs:domain aq:Organism ;
    rdfs:range aq:Process .

aq:drivesProcess a owl:ObjectProperty ;
    rdfs:domain aq:FunctionalGuild ;
    rdfs:range aq:BiogeochemicalProcess .

aq:affects a owl:ObjectProperty ;
    rdfs:domain aq:Process ;
    rdfs:range aq:Entity .

aq:hasParameter a owl:ObjectProperty ;
    rdfs:domain aq:Habitat ;
    rdfs:range aq:WaterQualityParameter .

aq:hasHydrochemicalParameter a owl:ObjectProperty ;
    rdfs:subPropertyOf aq:hasParameter ;
    rdfs:domain aq:Aquifer ;
    rdfs:range aq:HydrochemicalParameter .

aq:hasGeology a owl:ObjectProperty ;
    rdfs:domain aq:Habitat ;
    rdfs:range aq:GeologicalSetting .

aq:hasGeologicalSetting a owl:ObjectProperty ;
    rdfs:subPropertyOf aq:hasGeology ;
    rdfs:domain aq:Aquifer ;
    rdfs:range aq:GeologicalSetting .

aq:hasSamplingMethod a owl:ObjectProperty ;
    rdfs:domain aq:Study ;
    rdfs:range aq:SamplingMethod .

aq:hasIndicator a owl:ObjectProperty ;
    rdfs:domain aq:Habitat ;
    rdfs:range aq:Indicator .

aq:comparesWith a owl:ObjectProperty ;
    rdfs:domain aq:Habitat ;
    rdfs:range aq:Habitat .

aq:locatedIn a owl:ObjectProperty ;
    rdfs:domain aq:Entity ;
    rdfs:range aq:Habitat .

aq:influences a owl:ObjectProperty ;
    rdfs:domain aq:Entity ;
    rdfs:range aq:Entity .

aq:connectedTo a owl:ObjectProperty ;
    rdfs:domain aq:Aquifer ;
    rdfs:range aq:Aquifer .

aq:hasChemicalSignal a owl:ObjectProperty ;
    rdfs:domain aq:Habitat ;
    rdfs:range aq:ChemicalSignal .

aq:hasColloid a owl:ObjectProperty ;
    rdfs:domain aq:Habitat ;
    rdfs:range aq:Colloid .

aq:utilizesSubstrate a owl:ObjectProperty ;
    rdfs:domain aq:Microbe ;
    rdfs:range aq:Substrate .

aq:produces a owl:ObjectProperty ;
    rdfs:domain aq:Organism ;
    rdfs:range aq:ChemicalEntity .

aq:consumes a owl:ObjectProperty ;
    rdfs:domain aq:Organism ;
    rdfs:range aq:ChemicalEntity .

aq:hasTemporalChange a owl:ObjectProperty ;
    rdfs:domain aq:Entity ;
    rdfs:range aq:Process .

aq:isMeasuredBy a owl:ObjectProperty ;
    rdfs:domain aq:Entity ;
    rdfs:range aq:SamplingMethod .

aq:hasContaminantTransportPathway a owl:ObjectProperty ;
    rdfs:domain aq:Aquifer ;
    rdfs:range aq:ContaminantTransport .

aq:hasRechargeProcess a owl:ObjectProperty ;
    rdfs:domain aq:Aquifer ;
    rdfs:range aq:RechargeProcess .

aq:hasClimateDriver a owl:ObjectProperty ;
    rdfs:domain aq:Aquifer ;
    rdfs:range aq:ClimateParameter .

aq:hasBiogeochemicalProcess a owl:ObjectProperty ;
    rdfs:domain aq:Aquifer ;
    rdfs:range aq:BiogeochemicalProcess .

### Datatype Properties

aq:hasName a owl:DatatypeProperty ; rdfs:range xsd:string .
aq:hasIdentifier a owl:DatatypeProperty ; rdfs:range xsd:string .
aq:hasValue a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aq:hasUnit a owl:DatatypeProperty ; rdfs:range xsd:string .
aq:hasDate a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
aq:hasDepth a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aq:hasAbundance a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aq:hasRelativeAbundance a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aq:hasDiversityIndex a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aq:haspHValue a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aq:hasOxygenValue a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aq:hasDOCValue a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aq:hasTemperatureValue a owl:DatatypeProperty ; rdfs:range xsd:decimal .
aq:hasNotes a owl:DatatypeProperty ; rdfs:range xsd:string .

### Study class

aq:Study a owl:Class ; rdfs:subClassOf aq:Entity .

### Example Individuals

ex:karst_aquifer_1 a aq:KarstAquifer ;
    aq:hasName "Karst aquifer 1" ;
    aq:hasGeologicalSetting ex:triassic_limestone ;
    aq:hasHydrochemicalParameter ex:param_ph, ex:param_oxygen, ex:param_doc ;
    aq:hasBiogeochemicalProcess ex:process_carbon_fixation, ex:process_denitrification ;
    aq:hasClimateDriver ex:precipitation_event_1 ;
    aq:hasRechargeProcess ex:recharge_1 ;
    aq:hasSamplingMethod ex:method_metagenomics .

ex:fractured_aquifer_1 a aq:FracturedRockAquifer ;
    aq:hasName "Fractured rock aquifer 1" ;
    aq:hasGeologicalSetting ex:fracture_zone ;
    aq:hasHydrochemicalParameter ex:param_ph, ex:param_oxygen ;
    aq:hasColloid ex:aquatic_colloid_1 ;
    aq:hasContaminantTransportPathway ex:transport_microbial ;
    aq:hasSamplingMethod ex:method_water_sampling .

ex:fungus_1 a aq:AquaticFungus ;
    aq:hasName "Aquatic fungus A" ;
    aq:occursIn ex:karst_aquifer_1 ;
    aq:hasHabitat ex:karst_aquifer_1 ;
    aq:produces ex:peptide_1 .

ex:bacterium_1 a aq:Bacterium ;
    aq:hasName "Bacterium A" ;
    aq:occursIn ex:fractured_aquifer_1 ;
    aq:hasGuild ex:guild_denitrifier ;
    aq:participatesIn ex:process_denitrification ;
    aq:utilizesSubstrate ex:substrate_organic_1 ;
    aq:consumes ex:param_doc .

ex:guild_denitrifier a aq:Denitrifier ;
    aq:hasName "Denitrifier guild" ;
    aq:drivesProcess ex:process_denitrification .

ex:guild_autotroph a aq:Chemolithoautotroph ;
    aq:hasName "Chemolithoautotroph guild" ;
    aq:drivesProcess ex:process_carbon_fixation .

ex:param_ph a aq:pH ; aq:hasValue "7.2"^^xsd:decimal ; aq:hasUnit "pH" .
ex:param_oxygen a aq:OxygenContent ; aq:hasValue "1.5"^^xsd:decimal ; aq:hasUnit "mg/L" .
ex:param_doc a aq:DissolvedOrganicCarbon ; aq:hasValue "2.3"^^xsd:decimal ; aq:hasUnit "mg/L" .
ex:param_temperature a aq:Temperature ; aq:hasValue "11.0"^^xsd:decimal ; aq:hasUnit "degC" .

ex:triassic_limestone a aq:Lithology ; aq:hasName "Triassic limestone" .
ex:fracture_zone a aq:Fracture ; aq:hasName "Fracture zone" .
ex:pedo_setting_1 a aq:PedologicalSetting ; aq:hasName "Agricultural pedological setting" .

ex:precipitation_event_1 a aq:PrecipitationEvent ; aq:hasName "Rain event" .
ex:snowmelt_event_1 a aq:SnowmeltEvent ; aq:hasName "Snowmelt event" .
ex:recharge_1 a aq:RechargeProcess ; aq:hasName "Recharge pulse" .

ex:transport_microbial a aq:MicrobialTransport ; aq:hasName "Microbial transport pathway" .
ex:aquatic_colloid_1 a aq:AquaticColloid ; aq:hasName "Aquatic colloid 1" .
ex:peptide_1 a aq:Peptide ; aq:hasName "Subsurface peptide marker" .
ex:substrate_organic_1 a aq:OrganicSubstrate ; aq:hasName "Organic substrate 1" .

ex:method_metagenomics a aq:Metagenomics ; aq:hasName "Metagenomics" .
ex:method_water_sampling a aq:WaterSampling ; aq:hasName "Water sampling" .

