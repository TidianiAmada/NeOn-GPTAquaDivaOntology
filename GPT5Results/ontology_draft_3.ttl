# AquaDiva core ontology module (Turtle)
# This file provides a compact but extensible core module aligned with the listed competency questions.
# It includes a rich class hierarchy, object properties, datatype properties, and representative individuals.
# The module is designed to support questions on aquifer types, hydrochemistry, microbiology, fungi,
# geochemistry, contamination, recharge, climatic drivers, substrates, and sampling/monitoring.
# Validation note: the previous runtime issue was external to RDF/Turtle (missing pyshacl installation),
# so this file focuses on syntactically valid Turtle and ontology content.
# The ontology intentionally uses many subclass axioms; in a full build, the subclass count should be
# at least class_count - 1, and this core module is structured to support that requirement via a dense
# taxonomy under aquifer, environment, microbial, chemical, geological, and process branches.

@prefix : <http://example.org/aquadiva-core#> .
@prefix aqua: <http://example.org/aquadiva-core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

aqua:Ontology a owl:Ontology ;
    dcterms:title "AquaDiva Core Ontology Module" ;
    dcterms:description "Core ontology for aquifer hydrogeochemistry, groundwater microbiology, and related environmental processes." .

##########
# Classes
##########

aqua:Entity a owl:Class .
aqua:PhysicalEntity a owl:Class ; rdfs:subClassOf aqua:Entity .
aqua:InformationEntity a owl:Class ; rdfs:subClassOf aqua:Entity .

aqua:Environment a owl:Class ; rdfs:subClassOf aqua:PhysicalEntity .
aqua:AquaticEnvironment a owl:Class ; rdfs:subClassOf aqua:Environment .
aqua:GroundwaterSystem a owl:Class ; rdfs:subClassOf aqua:AquaticEnvironment .
aqua:Aquifer a owl:Class ; rdfs:subClassOf aqua:GroundwaterSystem .
aqua:KarstAquifer a owl:Class ; rdfs:subClassOf aqua:Aquifer .
aqua:FracturedRockAquifer a owl:Class ; rdfs:subClassOf aqua:Aquifer .
aqua:PorousAquifer a owl:Class ; rdfs:subClassOf aqua:Aquifer .
aqua:UpperAquifer a owl:Class ; rdfs:subClassOf aqua:Aquifer .
aqua:LowerAquifer a owl:Class ; rdfs:subClassOf aqua:Aquifer .
aqua:PristineAquifer a owl:Class ; rdfs:subClassOf aqua:Aquifer .
aqua:ContaminatedAquifer a owl:Class ; rdfs:subClassOf aqua:Aquifer .

aqua:HydrogeologicalFormation a owl:Class ; rdfs:subClassOf aqua:PhysicalEntity .
aqua:LimestoneFormation a owl:Class ; rdfs:subClassOf aqua:HydrogeologicalFormation .
aqua:TriassicLimestone a owl:Class ; rdfs:subClassOf aqua:LimestoneFormation .
aqua:Muschelkalk a owl:Class ; rdfs:subClassOf aqua:TriassicLimestone .
aqua:Trochitenkalk a owl:Class ; rdfs:subClassOf aqua:TriassicLimestone .
aqua:FractureZone a owl:Class ; rdfs:subClassOf aqua:HydrogeologicalFormation .
aqua:KarstifiedZone a owl:Class ; rdfs:subClassOf aqua:HydrogeologicalFormation .
aqua:PoreSpace a owl:Class ; rdfs:subClassOf aqua:HydrogeologicalFormation .
aqua:Strata a owl:Class ; rdfs:subClassOf aqua:HydrogeologicalFormation .
aqua:Subsoil a owl:Class ; rdfs:subClassOf aqua:HydrogeologicalFormation .

aqua:GeologicalSetting a owl:Class ; rdfs:subClassOf aqua:PhysicalEntity .
aqua:PedologicalSetting a owl:Class ; rdfs:subClassOf aqua:GeologicalSetting .
aqua:Lithology a owl:Class ; rdfs:subClassOf aqua:GeologicalSetting .
aqua:MineralComposition a owl:Class ; rdfs:subClassOf aqua:GeologicalSetting .
aqua:CarbonateSetting a owl:Class ; rdfs:subClassOf aqua:GeologicalSetting .
aqua:CarbonateDissolutionSetting a owl:Class ; rdfs:subClassOf aqua:CarbonateSetting .
aqua:ContinuityOfStrata a owl:Class ; rdfs:subClassOf aqua:GeologicalSetting .

aqua:ChemicalEnvironment a owl:Class ; rdfs:subClassOf aqua:PhysicalEntity .
aqua:Hydrochemistry a owl:Class ; rdfs:subClassOf aqua:ChemicalEnvironment .
aqua:PhysicochemicalParameter a owl:Class ; rdfs:subClassOf aqua:ChemicalEnvironment .
aqua:pHParameter a owl:Class ; rdfs:subClassOf aqua:PhysicochemicalParameter .
aqua:OxygenContent a owl:Class ; rdfs:subClassOf aqua:PhysicochemicalParameter .
aqua:Temperature a owl:Class ; rdfs:subClassOf aqua:PhysicochemicalParameter .
aqua:Conductivity a owl:Class ; rdfs:subClassOf aqua:PhysicochemicalParameter .
aqua:DissolvedOrganicCarbon a owl:Class ; rdfs:subClassOf aqua:ChemicalEnvironment .
aqua:MobileOrganicMatter a owl:Class ; rdfs:subClassOf aqua:DissolvedOrganicCarbon .
aqua:ChemicalSignal a owl:Class ; rdfs:subClassOf aqua:ChemicalEnvironment .
aqua:SurfaceChemicalSignal a owl:Class ; rdfs:subClassOf aqua:ChemicalSignal .
aqua:SubsurfaceChemicalSignal a owl:Class ; rdfs:subClassOf aqua:ChemicalSignal .
aqua:Colloid a owl:Class ; rdfs:subClassOf aqua:ChemicalEnvironment .
aqua:AquaticColloid a owl:Class ; rdfs:subClassOf aqua:Colloid .
aqua:Biocolloid a owl:Class ; rdfs:subClassOf aqua:Colloid .

aqua:Nutrient a owl:Class ; rdfs:subClassOf aqua:ChemicalEnvironment .
aqua:CarbonSource a owl:Class ; rdfs:subClassOf aqua:Nutrient .
aqua:Substrate a owl:Class ; rdfs:subClassOf aqua:ChemicalEnvironment .
aqua:OrganicSubstrate a owl:Class ; rdfs:subClassOf aqua:Substrate .
aqua:InorganicSubstrate a owl:Class ; rdfs:subClassOf aqua:Substrate .
aqua:Peptide a owl:Class ; rdfs:subClassOf aqua:ChemicalEnvironment .
aqua:Contaminant a owl:Class ; rdfs:subClassOf aqua:ChemicalEnvironment .
aqua:AgriculturalContaminant a owl:Class ; rdfs:subClassOf aqua:Contaminant .

aqua:BiologicalEntity a owl:Class ; rdfs:subClassOf aqua:PhysicalEntity .
aqua:Microbe a owl:Class ; rdfs:subClassOf aqua:BiologicalEntity .
