##########
# Individuals
##########

aqua:KarstAquifer_1 a aqua:KarstAquifer ;
    aqua:hasName "Karst aquifer 1" ;
    aqua:hasPermeability "high" .

aqua:FracturedRockAquifer_1 a aqua:FracturedRockAquifer ;
    aqua:hasName "Fractured rock aquifer 1" ;
    aqua:hasPermeability "moderate" .

aqua:TriassicLimestone_Formation_1 a aqua:TriassicLimestone ;
    aqua:hasName "Triassic limestone formation" .

aqua:Muschelkalk_Formation_1 a aqua:Muschelkalk ;
    aqua:hasName "Muschelkalk formation" .

aqua:Trochitenkalk_Formation_1 a aqua:Trochitenkalk ;
    aqua:hasName "Trochitenkalk formation" .

aqua:SampleMethod_1 a aqua:SamplingMethod ;
    aqua:hasName "Groundwater filtration" .

aqua:SampleMethod_2 a aqua:SamplingMethod ;
    aqua:hasName "DNA sequencing" .

aqua:Microbe_1 a aqua:Bacterium ;
    aqua:hasTaxonName "Unknown bacterium A" ;
    aqua:locatedIn aqua:KarstAquifer_1 .

aqua:Fungus_1 a aqua:AquaticFungus ;
    aqua:hasTaxonName "Unknown aquatic fungus A" ;
    aqua:locatedIn aqua:KarstAquifer_1 .

aqua:Guild_1 a aqua:CO2FixationGuild ;
    aqua:hasFunctionalRole "carbonate-associated autotrophy" ;
    aqua:locatedIn aqua:FracturedRockAquifer_1 .

aqua:Zone_Oxic_1 a aqua:OxicZone ;
    aqua:hasName "Oxic zone 1" .

aqua:Zone_Anoxic_1 a aqua:AnoxicZone ;
    aqua:hasName "Anoxic zone 1" .

aqua:DOC_1 a aqua:MobileOrganicMatter ;
    aqua:hasDOCValue "2.5"^^xsd:decimal ;
    aqua:hasUnit "mg/L" .

aqua:pH_1 a aqua:pHParameter ;
    aqua:haspH "7.4"^^xsd:decimal .

aqua:O2_1 a aqua:OxygenContent ;
    aqua:hasOxygenLevel "low" .

aqua:PrecipitationEvent_1 a aqua:MonitoringEvent ;
    aqua:hasPrecipitation "heavy" ;
    aqua:hasTime "2024-05-01"^^xsd:date .

aqua:SnowmeltEvent_1 a aqua:MonitoringEvent ;
    aqua:hasSnowmeltIntensity "high" ;
    aqua:hasTime "2024-03-15"^^xsd:date .

aqua:Contaminant_1 a aqua:AgriculturalContaminant ;
    aqua:hasName "Nitrate" .

aqua:GroundwaterQuality_1 a aqua:GroundwaterQuality ;
    aqua:hasResult "good" .

##########
# Core axioms for competency-question support
##########

aqua:KarstAquifer rdfs:subClassOf [ a owl:Restriction ; owl:onProperty aqua:hasFormation ; owl:someValuesFrom aqua:KarstifiedZone ] .
aqua:FracturedRockAquifer rdfs:subClassOf [ a owl:Restriction ; owl:onProperty aqua:hasFormation ; owl:someValuesFrom aqua:FractureZone ] .
aqua:Aquifer rdfs:subClassOf [ a owl:Restriction ; owl:onProperty aqua:hasHabitat ; owl:someValuesFrom aqua:SubsurfaceHabitat ] .
aqua:Microbe rdfs:subClassOf [ a owl:Restriction ; owl:onProperty aqua:locatedIn ; owl:someValuesFrom aqua:Aquifer ] .
aqua:Fungus rdfs:subClassOf [ a owl:Restriction ; owl:onProperty aqua:locatedIn ; owl:someValuesFrom aqua:SubsurfaceHabitat ] .
aqua:FunctionalGuild rdfs:subClassOf [ a owl:Restriction ; owl:onProperty aqua:hasHabitat ; owl:someValuesFrom aqua:Habitat ] .
aqua:Recharge rdfs:subClassOf [ a owl:Restriction ; owl:onProperty aqua:influences ; owl:someValuesFrom aqua:GroundwaterSupply ] .
aqua:Karstification rdfs:subClassOf [ a owl:Restriction ; owl:onProperty aqua:impacts ; owl:someValuesFrom aqua:Hydrochemistry ] .
aqua:ContaminantTransport rdfs:subClassOf [ a owl:Restriction ; owl:onProperty aqua:transports ; owl:someValuesFrom aqua:Contaminant ] .
aqua:CO2FixationProcess rdfs:subClassOf [ a owl:Restriction ; owl:onProperty aqua:fixes ; owl:someValuesFrom aqua:CarbonSource ] . 

##########
# Additional subclass structure
##########

aqua:ForestSetting a owl:Class ; rdfs:subClassOf aqua:GeologicalSetting .
aqua:AgriculturalSetting a owl:Class ; rdfs:subClassOf aqua:GeologicalSetting .
aqua:PristineSetting a owl:Class ; rdfs:subClassOf aqua:GeologicalSetting .
aqua:KarstSystem a owl:Class ; rdfs:subClassOf aqua:GroundwaterSystem .
aqua:MarineSystem a owl:Class ; rdfs:subClassOf aqua:AquaticEnvironment .
aqua:SoilSystem a owl:Class ; rdfs:subClassOf aqua:Environment .
aqua:SurfaceEnvironment a owl:Class ; rdfs:subClassOf aqua:Environment .
aqua:SubsurfaceEnvironment a owl:Class ; rdfs:subClassOf aqua:Environment .

aqua:HydraulicProperty a owl:Class ; rdfs:subClassOf aqua:PhysicalEntity .
aqua:FlowRegime a owl:Class ; rdfs:subClassOf aqua:HydraulicProperty .
aqua:FracturedFlow a owl:Class ; rdfs:subClassOf aqua:FlowRegime .
aqua:KarstifiedFlow a owl:Class ; rdfs:subClassOf aqua:FlowRegime .

aqua:OrganicMatter a owl:Class ; rdfs:subClassOf aqua:ChemicalEnvironment .
aqua:BiogeochemicalIndicator a owl:Class ; rdfs:subClassOf aqua:InformationEntity .
aqua:GroundwaterProtectionMeasure a owl:Class ; rdfs:subClassOf aqua:InformationEntity .
aqua:Vulnerability a owl:Class ; rdfs:subClassOf aqua:InformationEntity . 

# End of AquaDiva core ontology module.