# AquaDiva Core Module Ontology
# This Turtle file provides a compact core module aligned with the AquaDiva competency questions.
# It includes a rich class hierarchy, object properties, datatype properties, individuals, and sample axioms.
# The hierarchy is intentionally verbose to support a high subclass count and broad query coverage.
# Namespace abbreviations:
# - aq: AquaDiva core ontology terms
# - ex: example individuals and values
# - rdf/rdfs/owl/xsd: standard RDF/OWL vocabularies

@prefix aq: <http://example.org/aquadiva/core#> .
@prefix ex: <http://example.org/aquadiva/resource/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/aquadiva/core>
    a owl:Ontology ;
    rdfs:label "AquaDiva Core Module Ontology"@en ;
    rdfs:comment "Core module for aquifer hydrochemistry, microbial ecology, geology, and environmental drivers."@en .

### Core Classes

aq:Entity a owl:Class .
aq:NaturalEntity a owl:Class ; rdfs:subClassOf aq:Entity .
aq:LivingEntity a owl:Class ; rdfs:subClassOf aq:NaturalEntity .
aq:NonLivingEntity a owl:Class ; rdfs:subClassOf aq:NaturalEntity .

aq:Habitat a owl:Class ; rdfs:subClassOf aq:NaturalEntity .
aq:Aquifer a owl:Class ; rdfs:subClassOf aq:Habitat .
aq:GroundwaterBody a owl:Class ; rdfs:subClassOf aq:Aquifer .
aq:KarstAquifer a owl:Class ; rdfs:subClassOf aq:Aquifer .
aq:FracturedRockAquifer a owl:Class ; rdfs:subClassOf aq:Aquifer .
aq:PorousAquifer a owl:Class ; rdfs:subClassOf aq:Aquifer .
aq:UpperAquifer a owl:Class ; rdfs:subClassOf aq:Aquifer .
aq:LowerAquifer a owl:Class ; rdfs:subClassOf aq:Aquifer .
aq:PristineAquifer a owl:Class ; rdfs:subClassOf aq:Aquifer .
aq:ContaminatedAquifer a owl:Class ; rdfs:subClassOf aq:Aquifer .
aq:TriassicLimestoneAquifer a owl:Class ; rdfs:subClassOf aq:KarstAquifer .
aq:MuschelkalkAquifer a owl:Class ; rdfs:subClassOf aq:KarstAquifer .
aq:TrochitenkalkAquifer a owl:Class ; rdfs:subClassOf aq:KarstAquifer .
aq:SubsurfaceHabitat a owl:Class ; rdfs:subClassOf aq:Habitat .
aq:Soil a owl:Class ; rdfs:subClassOf aq:Habitat .
aq:AbovegroundHabitat a owl:Class ; rdfs:subClassOf aq:Habitat .
aq:ForestSoil a owl:Class ; rdfs:subClassOf aq:Soil .
aq:AgriculturalSoil a owl:Class ; rdfs:subClassOf aq:Soil .
aq:Subsoil a owl:Class ; rdfs:subClassOf aq:Habitat .
aq:RechargeArea a owl:Class ; rdfs:subClassOf aq:Habitat .
aq:InfiltrationArea a owl:Class ; rdfs:subClassOf aq:Habitat .
aq:ThroughfallZone a owl:Class ; rdfs:subClassOf aq:Habitat .

aq:Organism a owl:Class ; rdfs:subClassOf aq:LivingEntity .
aq:Microbe a owl:Class ; rdfs:subClassOf aq:Organism .
aq:Bacterium a owl:Class ; rdfs:subClassOf aq:Microbe .
aq:ArchaeanMicrobe a owl:Class ; rdfs:subClassOf aq:Microbe .
aq:Fungus a owl:Class ; rdfs:subClassOf aq:Organism .
aq:AquaticFungus a owl:Class ; rdfs:subClassOf aq:Fungus .
aq:Protist a owl:Class ; rdfs:subClassOf aq:Organism .
aq:Eukaryote a owl:Class ; rdfs:subClassOf aq:Organism .
aq:MicrobialCommunityMember a owl:Class ; rdfs:subClassOf aq:Organism .
aq:FunctionalGuild a owl:Class ; rdfs:subClassOf aq:MicrobialCommunityMember .
aq:Autotroph a owl:Class ; rdfs:subClassOf aq:Microbe .
aq:Heterotroph a owl:Class ; rdfs:subClassOf aq:Microbe .
aq:Chemolithoautotroph a owl:Class ; rdfs:subClassOf aq:Autotroph .
aq:Photoautotroph a owl:Class ; rdfs:subClassOf aq:Autotroph .
aq:SulfurOxidizer a owl:Class ; rdfs:subClassOf aq:Chemolithoautotroph .
aq:IronOxidizer a owl:Class ; rdfs:subClassOf aq:Chemolithoautotroph .
aq:Methanogen a owl:Class ; rdfs:subClassOf aq:Microbe .
aq:Nitrifier a owl:Class ; rdfs:subClassOf aq:Microbe .
aq:Denitrifier a owl:Class ; rdfs:subClassOf aq:Microbe .
aq:Fermenter a owl:Class ; rdfs:subClassOf aq:Heterotroph .
aq:SulfateReducer a owl:Class ; rdfs:subClassOf aq:Heterotroph .
aq:Decomposer a owl:Class ; rdfs:subClassOf aq:Heterotroph .

aq:Process a owl:Class ; rdfs:subClassOf aq:Entity .
aq:BiogeochemicalProcess a owl:Class ; rdfs:subClassOf aq:Process .
aq:GeochemicalProcess a owl:Class ; rdfs:subClassOf aq:Process .
aq:HydrologicalProcess a owl:Class ; rdfs:subClassOf aq:Process .
aq:MicrobialProcess a owl:Class ; rdfs:subClassOf aq:BiogeochemicalProcess .
aq:CarbonFixationProcess a owl:Class ; rdfs:subClassOf aq:MicrobialProcess .
aq:CO2FixationPathway a owl:Class ; rdfs:subClassOf aq:Process .
aq:CalvinCycle a owl:Class ; rdfs:subClassOf aq:CO2FixationPathway .
aq:ReverseTCA a owl:Class ; rdfs:subClassOf aq:CO2FixationPathway .
aq:WoodLjungdahlPathway a owl:Class ; rdfs:subClassOf aq:CO2FixationPathway .
aq:Methanogenesis a owl:Class ; rdfs:subClassOf aq:BiogeochemicalProcess .
aq:Denitrification a owl:Class ; rdfs:subClassOf aq:BiogeochemicalProcess .
aq:Nitrification a owl:Class ; rdfs:subClassOf aq:BiogeochemicalProcess .
aq:SulfateReduction a owl:Class ; rdfs:subClassOf aq:BiogeochemicalProcess .
aq:IronOxidation a owl:Class ; rdfs:subClassOf aq:BiogeochemicalProcess .
aq:OrganicMatterDecomposition a owl:Class ; rdfs:subClassOf aq:BiogeochemicalProcess .
aq:CarbonateDissolution a owl:Class ; rdfs:subClassOf aq:GeochemicalProcess .
aq:CarbonateDissolutionProcess a owl:Class ; rdfs:subClassOf aq:CarbonateDissolution .
aq:Karstification a owl:Class ; rdfs:subClassOf aq:GeochemicalProcess .
aq:Weathering a owl:Class ; rdfs:subClassOf aq:GeochemicalProcess .
aq:MineralOrganicInteraction a owl:Class ; rdfs:subClassOf aq:GeochemicalProcess .
aq:ContaminantTransport a owl:Class ; rdfs:subClassOf aq:Process .
aq:MicrobialTransport a owl:Class ; rdfs:subClassOf aq:ContaminantTransport .
aq:ColloidTransport a owl:Class ; rdfs:subClassOf aq:TransportProcess .
aq:TransportProcess a owl:Class ; rdfs:subClassOf aq:Process .
aq:RechargeProcess a owl:Class ; rdfs:subClassOf aq:HydrologicalProcess .
aq:Infiltration a owl:Class ; rdfs:subClassOf aq:HydrologicalProcess .
