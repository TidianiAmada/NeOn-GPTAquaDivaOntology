:OntologyModel a :Ontology ;
    rdfs:label "Ontology Model"@en ;
    :definesClass :Class_1,
        :Class_10,
        :Class_2,
        :Class_3,
        :Class_4,
        :Class_5,
        :Class_6,
        :Class_7,
        :Class_8,
        :Class_9 ;
    :definesDatatypeProperty :DatatypeProperty_1,
        :DatatypeProperty_2,
        :DatatypeProperty_3 ;
    :definesIndividual :Individual_1,
        :Individual_2,
        :Individual_3,
        :Individual_4,
        :Individual_5 ;
    :definesObjectProperty :ObjectProperty_1,
        :ObjectProperty_2,
        :ObjectProperty_3,
        :ObjectProperty_4,
        :ObjectProperty_5 .

