@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/ontology> a owl:Ontology ;
    rdfs:comment "Conceptual ontology model with a large class hierarchy, object properties, datatype properties, and individuals."@en .

:AcademicOrganization a owl:Class ;
    rdfs:subClassOf :Organization .

:AccessPolicy a owl:Class ;
    rdfs:subClassOf :SecurityPolicy .

:AccessRule a owl:Class ;
    rdfs:subClassOf :OperationalRule .

:AdministrativeEntity a owl:Class ;
    rdfs:subClassOf :Organization .

:ApprovalEvent a owl:Class ;
    rdfs:subClassOf :ReviewEvent .

:BusinessProcess a owl:Class ;
    rdfs:subClassOf :OperationalProcess .

:CodeIdentifier a owl:Class ;
    rdfs:subClassOf :Identifier .

:ComplianceMeasure a owl:Class ;
    rdfs:subClassOf :QualityMeasure .

:Contract a owl:Class ;
    rdfs:subClassOf :Document .

:CorporateOrganization a owl:Class ;
    rdfs:subClassOf :Organization .

:CreationEvent a owl:Class ;
    rdfs:subClassOf :LifecycleEvent .

:Customer a owl:Class ;
    rdfs:subClassOf :Person .

:Day a owl:Class ;
    rdfs:subClassOf :CalendarPeriod .

:DecisionRecord a owl:Class ;
    rdfs:subClassOf :OperationalDocument .

:DeletionEvent a owl:Class ;
    rdfs:subClassOf :LifecycleEvent .

:Director a owl:Class ;
    rdfs:subClassOf :Manager .

:DraftDocument a owl:Class ;
    rdfs:subClassOf :Document .

:FinalDocument a owl:Class ;
    rdfs:subClassOf :ApprovedDocument .

:FinancialMeasure a owl:Class ;
    rdfs:subClassOf :Measure .

:GovernmentOrganization a owl:Class ;
    rdfs:subClassOf :Organization .

:Guideline a owl:Class ;
    rdfs:subClassOf :Document .

:HardwareResource a owl:Class ;
    rdfs:subClassOf :PhysicalResource .

:InstallationGuide a owl:Class ;
    rdfs:subClassOf :UserGuide .

:LeadershipRole a owl:Class ;
    rdfs:subClassOf :InterpersonalRole .

:License a owl:Class ;
    rdfs:subClassOf :Document .

:MaintenanceGuide a owl:Class ;
    rdfs:subClassOf :UserGuide .

:Minutes a owl:Class ;
    rdfs:subClassOf :MeetingRecord .

:ModificationEvent a owl:Class ;
    rdfs:subClassOf :LifecycleEvent .

:Month a owl:Class ;
    rdfs:subClassOf :CalendarPeriod .

:NonProfitOrganization a owl:Class ;
    rdfs:subClassOf :Organization .

:NumericIdentifier a owl:Class ;
    rdfs:subClassOf :Identifier .

:Partner a owl:Class ;
    rdfs:subClassOf :Agent .

:PerformanceAttribute a owl:Class ;
    rdfs:subClassOf :QualityAttribute .

:PrivateOrganization a owl:Class ;
    rdfs:subClassOf :Organization .

:Product a owl:Class ;
    rdfs:subClassOf :Resource .

:PublicResource a owl:Class ;
    rdfs:subClassOf :ManagedResource .

:PublicationEvent a owl:Class ;
    rdfs:subClassOf :Event .

:Region a owl:Class ;
    rdfs:subClassOf :SpatialLocation .

:Researcher a owl:Class ;
    rdfs:subClassOf :Employee .

:RestrictedResource a owl:Class ;
    rdfs:subClassOf :LicensedResource .

:RiskMeasure a owl:Class ;
    rdfs:subClassOf :Measure .

:SecurityAttribute a owl:Class ;
    rdfs:subClassOf :QualityAttribute .

:Service a owl:Class ;
    rdfs:subClassOf :Resource .

:Site a owl:Class ;
    rdfs:subClassOf :SpatialLocation .

:SoftwareResource a owl:Class ;
    rdfs:subClassOf :DigitalResource .

:Student a owl:Class ;
    rdfs:subClassOf :Person .

:SubWorkflow a owl:Class ;
    rdfs:subClassOf :Workflow .

:Supplier a owl:Class ;
    rdfs:subClassOf :Agent .

:TechnicalRole a owl:Class ;
    rdfs:subClassOf :Role .

:TemporalMeasure a owl:Class ;
    rdfs:subClassOf :Measure .

:UsagePolicy a owl:Class ;
    rdfs:subClassOf :Policy .

:ValidationRule a owl:Class ;
    rdfs:subClassOf :Rule .

:Year a owl:Class ;
    rdfs:subClassOf :CalendarPeriod .

:actualEffort a owl:DatatypeProperty ;
    rdfs:domain :Task ;
    rdfs:range xsd:decimal .

:addressLine a owl:DatatypeProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:appliesTo a owl:ObjectProperty ;
    rdfs:domain :Rule ;
    rdfs:range :Entity .

:approvedBy a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Person .

:belongsToProject a owl:ObjectProperty ;
    rdfs:domain :Project ;
    rdfs:range :Organization ;
    owl:inverseOf :hasProject .

:budget a owl:DatatypeProperty ;
    rdfs:domain :Project ;
    rdfs:range xsd:decimal .

:capacity a owl:DatatypeProperty ;
    rdfs:domain :Resource ;
    rdfs:range xsd:decimal .

:city a owl:DatatypeProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:code a owl:DatatypeProperty ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string .

:constrains a owl:ObjectProperty ;
    rdfs:domain :Constraint ;
    rdfs:range :Entity .

:consumes a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Resource .

:contains a owl:ObjectProperty ;
    rdfs:domain :Collection ;
    rdfs:range :Entity .

:cost a owl:DatatypeProperty ;
    rdfs:domain :Resource ;
    rdfs:range xsd:decimal .

:country a owl:DatatypeProperty ;
    rdfs:domain :Address ;
    rdfs:range xsd:string .

:createdAt a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:dateTime .

:createdBy a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Agent .

:dependsOn a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Entity .

:description a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string .

:documents a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Entity ;
    owl:inverseOf :hasDocument .

:email a owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:endDate a owl:DatatypeProperty ;
    rdfs:domain :TimePeriod ;
    rdfs:range xsd:dateTime .

:estimatedEffort a owl:DatatypeProperty ;
    rdfs:domain :Task ;
    rdfs:range xsd:decimal .

:followedBy a owl:ObjectProperty ;
    rdfs:domain :ProjectPhase ;
    rdfs:range :ProjectPhase ;
    owl:inverseOf :precededBy .

:hasComponent a owl:ObjectProperty ;
    rdfs:domain :System ;
    rdfs:range :Component .

:hasDataset a owl:ObjectProperty ;
    rdfs:domain :Collection ;
    rdfs:range :Dataset .

:hasLocation a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Location ;
    owl:inverseOf :locatedIn .

:hasRequirement a owl:ObjectProperty ;
    rdfs:domain :Plan ;
    rdfs:range :Requirement .

:hasRole a owl:ObjectProperty ;
    rdfs:domain :Agent ;
    rdfs:range :Role .

:hasTask a owl:ObjectProperty ;
    rdfs:domain :Workflow ;
    rdfs:range :Task .

:hasValue a owl:ObjectProperty ;
    rdfs:domain :Measure ;
    rdfs:range :Value .

:identifier a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string .

:implements a owl:ObjectProperty ;
    rdfs:domain :Component ;
    rdfs:range :Specification .

:isDescribedBy a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Document ;
    owl:inverseOf :describes .

:label a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string .

:measures a owl:ObjectProperty ;
    rdfs:domain :Metric ;
    rdfs:range :Entity .

:metric1 a :KPI ;
    :hasValue :value1 ;
    :identifier "MET-001" ;
    :label "On-time delivery" ;
    :measures :project1 .

:partOf a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Entity ;
    owl:inverseOf :hasPart .

:participatesIn a owl:ObjectProperty ;
    rdfs:domain :Agent ;
    rdfs:range :Event .

:phone a owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:priority a owl:DatatypeProperty ;
    rdfs:domain :Task ;
    rdfs:range xsd:integer .

:produces a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Resource .

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Resource ;
    rdfs:range xsd:decimal .

:reviewedBy a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Person .

:startDate a owl:DatatypeProperty ;
    rdfs:domain :TimePeriod ;
    rdfs:range xsd:dateTime .

:status a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string .

:updatedAt a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:dateTime .

:updatedBy a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Agent .

:uses a owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Resource .

:valueDate a owl:DatatypeProperty ;
    rdfs:domain :Value ;
    rdfs:range xsd:dateTime .

:valueNumber a owl:DatatypeProperty ;
    rdfs:domain :Value ;
    rdfs:range xsd:decimal .

:valueString a owl:DatatypeProperty ;
    rdfs:domain :Value ;
    rdfs:range xsd:string .

:version a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string .

:ApprovedDocument a owl:Class ;
    rdfs:subClassOf :Document .

:Attribute a owl:Class ;
    rdfs:subClassOf :Entity .

:ClosurePhase a owl:Class ;
    rdfs:subClassOf :ProjectPhase .

:Constraint a owl:Class ;
    rdfs:subClassOf :Rule .

:DataArtifact a owl:Class ;
    rdfs:subClassOf :Document .

:DigitalResource a owl:Class ;
    rdfs:subClassOf :Resource .

:ExecutionPhase a owl:Class ;
    rdfs:subClassOf :ProjectPhase .

:InitiationPhase a owl:Class ;
    rdfs:subClassOf :ProjectPhase .

:InterpersonalRole a owl:Class ;
    rdfs:subClassOf :Role .

:KPI a owl:Class ;
    rdfs:subClassOf :OperationalMetric .

:LicensedResource a owl:Class ;
    rdfs:subClassOf :ManagedResource .

:Manager a owl:Class ;
    rdfs:subClassOf :Employee .

:MeetingRecord a owl:Class ;
    rdfs:subClassOf :OperationalDocument .

:OperationalMetric a owl:Class ;
    rdfs:subClassOf :Metric .

:OperationalProcess a owl:Class ;
    rdfs:subClassOf :Process .

:OperationalRule a owl:Class ;
    rdfs:subClassOf :Rule .

:PhysicalResource a owl:Class ;
    rdfs:subClassOf :Resource .

:Plan a owl:Class ;
    rdfs:subClassOf :Document .

:QualityMeasure a owl:Class ;
    rdfs:subClassOf :Measure .

:Report a owl:Class ;
    rdfs:subClassOf :TextDocument .

:Requirement a owl:Class ;
    rdfs:subClassOf :Document .

:ReviewEvent a owl:Class ;
    rdfs:subClassOf :Event .

:SecurityPolicy a owl:Class ;
    rdfs:subClassOf :Policy .

:Specification a owl:Class ;
    rdfs:subClassOf :Document .

:System a owl:Class ;
    rdfs:subClassOf :Resource .

:TechnicalDocument a owl:Class ;
    rdfs:subClassOf :TextDocument .

:address1 a :Address ;
    :addressLine "1 Example Street" ;
    :city "Example City" ;
    :country "Example Country" ;
    :identifier "ADR-001" ;
    :label "Main Office" .

:assignedTo a owl:ObjectProperty ;
    rdfs:domain :Task ;
    rdfs:range :Person .

:dataset1 a :Dataset ;
    :createdBy :person1 ;
    :identifier "DS-001" ;
    :label "Project Dataset" ;
    :partOf :project1 .

:describes a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Entity .

:doc1 a :Report ;
    :describes :project1 ;
    :identifier "DOC-001" ;
    :isDescribedBy :project1 ;
    :label "Status Report" ;
    :reviewedBy :person1 .

:hasDocument a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Document .

:hasMember a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Person .

:hasPart a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Entity .

:hasPhase a owl:ObjectProperty ;
    rdfs:domain :Project ;
    rdfs:range :ProjectPhase .

:hasProject a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Project .

:locatedIn a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Location .

:phase3 a :ClosurePhase ;
    :identifier "PH-003" ;
    :label "Closure" ;
    :precededBy :phase2 .

:precededBy a owl:ObjectProperty ;
    rdfs:domain :ProjectPhase ;
    rdfs:range :ProjectPhase .

:task1 a :Task ;
    :assignedTo :person1 ;
    :estimatedEffort 8.0 ;
    :identifier "TSK-001" ;
    :label "Define scope" ;
    :partOf :workflow1 ;
    :priority 1 .

:task2 a :Task ;
    :assignedTo :person2 ;
    :estimatedEffort 40.0 ;
    :identifier "TSK-002" ;
    :label "Implement core module" ;
    :partOf :workflow1 ;
    :priority 2 .

:value1 a :Value ;
    :valueNumber 0.95 ;
    :valueString "95 percent" .

:worksFor a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Organization .

:Activity a owl:Class ;
    rdfs:subClassOf :Process .

:Collection a owl:Class ;
    rdfs:subClassOf :Resource .

:Component a owl:Class ;
    rdfs:subClassOf :Entity .

:Dataset a owl:Class ;
    rdfs:subClassOf :DataArtifact .

:Employee a owl:Class ;
    rdfs:subClassOf :Person .

:ManagedResource a owl:Class ;
    rdfs:subClassOf :Resource .

:Metric a owl:Class ;
    rdfs:subClassOf :Measure .

:OperationalDocument a owl:Class ;
    rdfs:subClassOf :Document .

:Policy a owl:Class ;
    rdfs:subClassOf :Document .

:QualityAttribute a owl:Class ;
    rdfs:subClassOf :Attribute .

:TextDocument a owl:Class ;
    rdfs:subClassOf :Document .

:UserGuide a owl:Class ;
    rdfs:subClassOf :TechnicalDocument .

:phase1 a :InitiationPhase ;
    :identifier "PH-001" ;
    :label "Initiation" .

:phase2 a :ExecutionPhase ;
    :identifier "PH-002" ;
    :label "Execution" ;
    :precededBy :phase1 .

:CalendarPeriod a owl:Class ;
    rdfs:subClassOf :TimePeriod .

:Identifier a owl:Class ;
    rdfs:subClassOf :Entity .

:LifecycleEvent a owl:Class ;
    rdfs:subClassOf :Event .

:Location a owl:Class ;
    rdfs:subClassOf :Entity .

:Role a owl:Class ;
    rdfs:subClassOf :Entity .

:SpatialLocation a owl:Class ;
    rdfs:subClassOf :Location .

:TimePeriod a owl:Class ;
    rdfs:subClassOf :Entity .

:Workflow a owl:Class ;
    rdfs:subClassOf :Process .

:org1 a :Organization ;
    :hasMember :person1,
        :person2 ;
    :hasProject :project1 ;
    :identifier "ORG-001" ;
    :label "Acme Organization" ;
    :locatedIn :address1 ;
    :status "active" .

:person2 a :Person ;
    :email "bob@example.org" ;
    :identifier "PER-002" ;
    :label "Bob Jones" ;
    :worksFor :org1 .

:workflow1 a :Workflow ;
    :hasTask :task1,
        :task2 ;
    :identifier "WF-001" ;
    :label "Delivery workflow" .

:Address a owl:Class ;
    rdfs:subClassOf :SpatialLocation .

:Rule a owl:Class ;
    rdfs:subClassOf :Document .

:Event a owl:Class ;
    rdfs:subClassOf :Entity .

:Process a owl:Class ;
    rdfs:subClassOf :Event .

:Project a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasPhase ;
            owl:someValuesFrom :ProjectPhase ],
        :Entity .

:Value a owl:Class ;
    rdfs:subClassOf :Entity .

:person1 a :Person ;
    :email "alice@example.org" ;
    :identifier "PER-001" ;
    :label "Alice Smith" ;
    :worksFor :org1 .

:project1 a :Project ;
    :belongsToProject :org1 ;
    :budget 1000000.00 ;
    :createdBy :person1 ;
    :dependsOn :dataset1 ;
    :hasDocument :doc1 ;
    :hasPart :workflow1 ;
    :hasPhase :phase1,
        :phase2,
        :phase3 ;
    :identifier "PRJ-001" ;
    :label "Project Alpha" ;
    :updatedBy :person2 .

:Measure a owl:Class ;
    rdfs:subClassOf :Entity .

:Task a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :assignedTo ;
            owl:someValuesFrom :Person ],
        :Activity .

:Agent a owl:Class ;
    rdfs:subClassOf :Entity .

:ProjectPhase a owl:Class ;
    rdfs:subClassOf :Entity .

:Organization a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasMember ;
            owl:someValuesFrom :Person ],
        :Agent .

:Person a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :worksFor ;
            owl:someValuesFrom :Organization ],
        :Agent .

:Resource a owl:Class ;
    rdfs:subClassOf :Entity .

:Document a owl:Class ;
    rdfs:subClassOf :Resource .

:Entity a owl:Class .

