@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology ;
    rdfs:label "Conceptual Ontology Model"@en .

:AbstractEntity a owl:Class ;
    rdfs:label "Abstract Entity"@en ;
    rdfs:subClassOf :RootEntity .

