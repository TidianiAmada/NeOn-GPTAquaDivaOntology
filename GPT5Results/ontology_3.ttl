@prefix aad: <http://example.org/aquadiva/aad/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/aquadiva> a owl:Ontology ;
    rdfs:comment "AquaDiva ontology fragment with reusable observation, measurement, characteristic, qualifier, and unit patterns."@en .

aad:Acceptor a owl:Class ;
    rdfs:label "acceptor"@en ;
    rdfs:subClassOf aad:ChemicalRole .

aad:BaseUnit a owl:Class ;
    rdfs:label "base unit"@en ;
    rdfs:subClassOf aad:Unit .

aad:CompositeUnit a owl:Class ;
    rdfs:label "composite unit"@en ;
    rdfs:subClassOf aad:Unit .

aad:DerivedUnit a owl:Class ;
    rdfs:label "derived unit"@en ;
    rdfs:subClassOf aad:Unit .

aad:GeochemicalFeature a owl:Class ;
    rdfs:label "geochemical feature"@en ;
    rdfs:subClassOf aad:Entity .

aad:GroundwaterEcosystem a owl:Class ;
    rdfs:label "groundwater ecosystem"@en ;
    rdfs:subClassOf aad:Entity .

aad:KarstSystem a owl:Class ;
    rdfs:label "karst system"@en ;
    rdfs:subClassOf aad:HydrogeologicalFeature .

aad:MicrobialCommunity a owl:Class ;
    rdfs:label "microbial community"@en ;
    rdfs:subClassOf aad:Entity .

aad:PrefixedUnit a owl:Class ;
    rdfs:label "prefixed unit"@en ;
    rdfs:subClassOf aad:Unit .

aad:characteristicFor a owl:ObjectProperty ;
    rdfs:label "characteristic for"@en ;
    rdfs:domain aad:Characteristic ;
    rdfs:range aad:Entity .

aad:entityRelated a owl:ObjectProperty ;
    rdfs:label "entity related"@en ;
    rdfs:domain aad:Observation ;
    rdfs:range aad:Observation .

aad:hasContext a owl:ObjectProperty ;
    rdfs:label "has context"@en ;
    rdfs:domain aad:Observation ;
    rdfs:range aad:Observation .

aad:hasObservation a owl:ObjectProperty ;
    rdfs:label "has observation"@en ;
    rdfs:domain aad:ObservationCollection ;
    rdfs:range aad:Observation ;
    owl:equivalentProperty aad:hasMember .

aad:hasObservedMeasurement a owl:ObjectProperty ;
    rdfs:label "has observed measurement"@en ;
    rdfs:domain aad:Observation ;
    rdfs:range aad:Measurement ;
    owl:equivalentProperty aad:hasMeasurement .

aad:hasObservedRelation a owl:ObjectProperty ;
    rdfs:label "has observed relation"@en ;
    rdfs:domain aad:Observation ;
    rdfs:range aad:ObservedRelation .

aad:hasUnit a owl:ObjectProperty ;
    rdfs:label "has unit"@en ;
    rdfs:domain aad:Unit ;
    rdfs:range aad:Unit .

aad:measurementFor a owl:ObjectProperty ;
    rdfs:label "measurement for"@en ;
    rdfs:domain aad:Measurement ;
    rdfs:range aad:Observation .

aad:measurementTypeFor a owl:ObjectProperty ;
    rdfs:label "measurement type for"@en ;
    rdfs:domain aad:MeasurementType ;
    rdfs:range aad:Entity .

aad:measuresEntity a owl:ObjectProperty ;
    rdfs:label "measures entity"@en ;
    rdfs:domain aad:MeasurementType ;
    rdfs:range aad:Entity .

aad:measuresUsingProtocol a owl:ObjectProperty ;
    rdfs:label "measures using protocol"@en ;
    rdfs:domain aad:MeasurementType ;
    rdfs:range aad:Protocol .

aad:measuresUsingStandard a owl:ObjectProperty ;
    rdfs:label "measures using standard"@en ;
    rdfs:domain aad:MeasurementType ;
    rdfs:range aad:Standard .

aad:observes a owl:ObjectProperty ;
    rdfs:label "observes"@en ;
    rdfs:domain aad:Observation ;
    rdfs:range aad:Entity ;
    owl:equivalentProperty aad:ofEntity .

aad:usesProtocol a owl:ObjectProperty ;
    rdfs:label "uses protocol"@en ;
    rdfs:domain aad:Measurement ;
    rdfs:range aad:Protocol .

aad:usesStandard a owl:ObjectProperty ;
    rdfs:label "uses standard"@en ;
    rdfs:domain aad:Measurement ;
    rdfs:range aad:Standard .

aad:ChemicalRole a owl:Class ;
    rdfs:label "chemical role"@en ;
    rdfs:subClassOf aad:Entity .

aad:HydrogeologicalFeature a owl:Class ;
    rdfs:label "hydrogeological feature"@en ;
    rdfs:subClassOf aad:Entity .

aad:MeasuredCharacteristic a owl:Class ;
    rdfs:label "measured characteristic"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty aad:hasQualifier ;
            owl:someValuesFrom aad:CharacteristicQualifier ],
        aad:Characteristic .

aad:ObservedRelation a owl:Class ;
    rdfs:label "observed relation"@en ;
    rdfs:subClassOf aad:Entity .

aad:hasBaseQualifier a owl:ObjectProperty ;
    rdfs:label "has base qualifier"@en ;
    rdfs:domain aad:CompositeCharacteristicQualifier ;
    rdfs:range aad:BaseCharacteristicQualifier .

aad:hasMember a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:domain aad:ObservationCollection ;
    rdfs:range aad:Observation .

aad:hasNextQualifier a owl:ObjectProperty ;
    rdfs:label "has next qualifier"@en ;
    rdfs:domain aad:CompositeCharacteristicQualifier ;
    rdfs:range aad:CharacteristicQualifier .

aad:hasQualifier a owl:ObjectProperty ;
    rdfs:label "has qualifier"@en ;
    rdfs:domain aad:MeasuredCharacteristic ;
    rdfs:range aad:CharacteristicQualifier .

aad:hasSourceUnit a owl:ObjectProperty ;
    rdfs:label "has source unit"@en ;
    rdfs:domain aad:UnitConversion ;
    rdfs:range aad:Unit .

aad:hasTargetUnit a owl:ObjectProperty ;
    rdfs:label "has target unit"@en ;
    rdfs:domain aad:UnitConversion ;
    rdfs:range aad:Unit .

aad:hasValue a owl:ObjectProperty ;
    rdfs:label "has value"@en ;
    rdfs:domain aad:Measurement ;
    rdfs:range aad:MeasuredValue .

aad:measuresCharacteristic a owl:ObjectProperty ;
    rdfs:label "measures characteristic"@en ;
    rdfs:domain aad:MeasurementType ;
    rdfs:range aad:Characteristic .

aad:ofCharacteristic a owl:ObjectProperty ;
    rdfs:label "of characteristic"@en ;
    rdfs:domain aad:Measurement ;
    rdfs:range aad:Characteristic .

aad:usesUnit a owl:ObjectProperty ;
    rdfs:label "uses unit"@en ;
    rdfs:domain aad:Measurement ;
    rdfs:range aad:Unit .

aad:BaseCharacteristicQualifier a owl:Class ;
    rdfs:label "base characteristic qualifier"@en ;
    rdfs:subClassOf aad:CharacteristicQualifier .

aad:CompositeCharacteristicQualifier a owl:Class ;
    rdfs:label "composite characteristic qualifier"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty aad:hasBaseQualifier ;
            owl:someValuesFrom aad:BaseCharacteristicQualifier ],
        [ a owl:Restriction ;
            owl:onProperty aad:hasNextQualifier ;
            owl:someValuesFrom aad:CharacteristicQualifier ],
        aad:CharacteristicQualifier .

aad:MeasuredValue a owl:Class ;
    rdfs:label "measured value"@en ;
    rdfs:subClassOf aad:Entity .

aad:ObservationCollection a owl:Class ;
    rdfs:label "observation collection"@en ;
    rdfs:subClassOf aad:Entity .

aad:Protocol a owl:Class ;
    rdfs:label "protocol"@en ;
    rdfs:subClassOf aad:Entity .

aad:Standard a owl:Class ;
    rdfs:label "standard"@en ;
    rdfs:subClassOf aad:Entity .

aad:UnitConversion a owl:Class ;
    rdfs:label "unit conversion"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty aad:hasSourceUnit ;
            owl:someValuesFrom aad:Unit ],
        [ a owl:Restriction ;
            owl:onProperty aad:hasTargetUnit ;
            owl:someValuesFrom aad:Unit ],
        aad:Entity .

aad:hasMeasurement a owl:ObjectProperty ;
    rdfs:label "has measurement"@en ;
    rdfs:domain aad:Observation ;
    rdfs:range aad:Measurement .

aad:ofEntity a owl:ObjectProperty ;
    rdfs:label "of entity"@en ;
    rdfs:domain aad:Observation ;
    rdfs:range aad:Entity .

aad:MeasurementType a owl:Class ;
    rdfs:label "measurement type"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty aad:measuresCharacteristic ;
            owl:someValuesFrom aad:Characteristic ],
        aad:Entity .

aad:Characteristic a owl:Class ;
    rdfs:label "characteristic"@en ;
    rdfs:subClassOf aad:Entity .

aad:CharacteristicQualifier a owl:Class ;
    rdfs:label "characteristic qualifier"@en ;
    rdfs:subClassOf aad:Entity .

aad:Measurement a owl:Class ;
    rdfs:label "measurement"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty aad:hasValue ;
            owl:someValuesFrom aad:MeasuredValue ],
        [ a owl:Restriction ;
            owl:onProperty aad:ofCharacteristic ;
            owl:someValuesFrom aad:Characteristic ],
        [ a owl:Restriction ;
            owl:onProperty aad:usesUnit ;
            owl:someValuesFrom aad:Unit ],
        aad:Entity .

aad:Observation a owl:Class ;
    rdfs:label "observation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty aad:hasMeasurement ;
            owl:someValuesFrom aad:Measurement ],
        [ a owl:Restriction ;
            owl:onProperty aad:ofEntity ;
            owl:someValuesFrom aad:Entity ],
        aad:Entity .

aad:Unit a owl:Class ;
    rdfs:label "unit"@en ;
    rdfs:subClassOf aad:Entity .

aad:Entity a owl:Class ;
    rdfs:label "entity"@en .

