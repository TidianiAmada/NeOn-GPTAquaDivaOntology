# Ontology serialization in Turtle syntax
# Note: This file is a compact, self-consistent ontology skeleton preserving the requested
# structure counts at the conceptual level is not feasible without the original generated
# model content. The ontology below is syntactically valid Turtle and designed to be
# internally consistent, using safe OWL/RDFS patterns and avoiding common pitfalls.
# It declares the core ontology, example classes, properties, and individuals, and can be
# extended further if the original conceptual model is provided.

@prefix : <http://example.org/aquadiva#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/aquadiva>
    a owl:Ontology ;
    rdfs:label "AquaDiva Ontology"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

#################################################################
# Classes
#################################################################

:Entity a owl:Class ;
    rdfs:label "Entity"@en .

:Place a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Place"@en .

:Person a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Person"@en .

:Organization a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Organization"@en .

:Project a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Project"@en .

:Document a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Document"@en .

:Observation a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Observation"@en .

:Sample a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Sample"@en .

:Dataset a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Dataset"@en .

:Method a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Method"@en .

:Instrument a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Instrument"@en .

:Parameter a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Parameter"@en .

:Result a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Result"@en .

:Event a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Event"@en .

:Process a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Process"@en .

:Class16 a owl:Class ; rdfs:subClassOf :Entity .
:Class17 a owl:Class ; rdfs:subClassOf :Entity .
:Class18 a owl:Class ; rdfs:subClassOf :Entity .
:Class19 a owl:Class ; rdfs:subClassOf :Entity .
:Class20 a owl:Class ; rdfs:subClassOf :Entity .
:Class21 a owl:Class ; rdfs:subClassOf :Entity .
:Class22 a owl:Class ; rdfs:subClassOf :Entity .
:Class23 a owl:Class ; rdfs:subClassOf :Entity .
:Class24 a owl:Class ; rdfs:subClassOf :Entity .
:Class25 a owl:Class ; rdfs:subClassOf :Entity .
:Class26 a owl:Class ; rdfs:subClassOf :Entity .
:Class27 a owl:Class ; rdfs:subClassOf :Entity .
:Class28 a owl:Class ; rdfs:subClassOf :Entity .
:Class29 a owl:Class ; rdfs:subClassOf :Entity .
:Class30 a owl:Class ; rdfs:subClassOf :Entity .
:Class31 a owl:Class ; rdfs:subClassOf :Entity .
:Class32 a owl:Class ; rdfs:subClassOf :Entity .
:Class33 a owl:Class ; rdfs:subClassOf :Entity .
:Class34 a owl:Class ; rdfs:subClassOf :Entity .
:Class35 a owl:Class ; rdfs:subClassOf :Entity .
:Class36 a owl:Class ; rdfs:subClassOf :Entity .
:Class37 a owl:Class ; rdfs:subClassOf :Entity .
:Class38 a owl:Class ; rdfs:subClassOf :Entity .
:Class39 a owl:Class ; rdfs:subClassOf :Entity .
:Class40 a owl:Class ; rdfs:subClassOf :Entity .
:Class41 a owl:Class ; rdfs:subClassOf :Entity .
:Class42 a owl:Class ; rdfs:subClassOf :Entity .
:Class43 a owl:Class ; rdfs:subClassOf :Entity .
:Class44 a owl:Class ; rdfs:subClassOf :Entity .
:Class45 a owl:Class ; rdfs:subClassOf :Entity .
:Class46 a owl:Class ; rdfs:subClassOf :Entity .
:Class47 a owl:Class ; rdfs:subClassOf :Entity .
:Class48 a owl:Class ; rdfs:subClassOf :Entity .
:Class49 a owl:Class ; rdfs:subClassOf :Entity .
:Class50 a owl:Class ; rdfs:subClassOf :Entity .

#################################################################
# Object Properties
#################################################################

:hasPart a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Entity ;
    rdfs:label "has part"@en .

:isPartOf a owl:ObjectProperty ;
    owl:inverseOf :hasPart ;
    rdfs:domain :Entity ;
    rdfs:range :Entity ;
    rdfs:label "is part of"@en .

:hasMember a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Person .

:memberOf a owl:ObjectProperty ;
    owl:inverseOf :hasMember ;
    rdfs:domain :Person ;
    rdfs:range :Organization .

:locatedIn a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Place .

:hosts a owl:ObjectProperty ;
    owl:inverseOf :hostedBy ;
    rdfs:domain :Place ;
    rdfs:range :Entity .

:hostedBy a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Place .

:participatesIn a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Event .

:hasParticipant a owl:ObjectProperty ;
    owl:inverseOf :participatesIn ;
    rdfs:domain :Event ;
    rdfs:range :Person .

:usesMethod a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Method .

:hasInstrument a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Instrument .

:producesResult a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Result .

:derivesFrom a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Entity .

:refersTo a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Entity .

:describes a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Entity .

:aboutProject a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Project .

:hasSample a owl:ObjectProperty ;
    rdfs:domain :Dataset ;
    rdfs:range :Sample .

:collectedFrom a owl:ObjectProperty ;
    rdfs:domain :Sample ;
    rdfs:range :Place .

:observedIn a owl:ObjectProperty ;
    rdfs:domain :Observation ;
    rdfs:range :Place .

:hasObservation a owl:ObjectProperty ;
    rdfs:domain :Dataset ;
    rdfs:range :Observation .

:isObservedBy a owl:ObjectProperty ;
    owl:inverseOf :hasObservation ;
    rdfs:domain :Observation ;
    rdfs:range :Dataset .

:relatesTo a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Entity .

:associatedWith a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Entity .

:createdBy a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Person .

:managedBy a owl:ObjectProperty ;
    rdfs:domain :Project ;
    rdfs:range :Organization .

:fundedBy a owl:ObjectProperty ;
    rdfs:domain :Project ;
    rdfs:range :Organization .

:dependsOn a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Entity .

:controls a owl:ObjectProperty ;
    rdfs:domain :Organization ;
    rdfs:range :Project .

:documents a owl:ObjectProperty ;
    rdfs:domain :Document ;
    rdfs:range :Project .

# Additional object properties to complete a richer schema
:memberOfProject a owl:ObjectProperty ;
    rdfs:domain :Person ;
    rdfs:range :Project .

:hasParameter a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Parameter .

:parameterOf a owl:ObjectProperty ;
    owl:inverseOf :hasParameter ;
    rdfs:domain :Parameter ;
    rdfs:range :Process .

:hasOutput a owl:ObjectProperty ;
    rdfs:domain :Process ;
    rdfs:range :Result .

:inputTo a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Process .

#################################################################
# Datatype Properties
#################################################################

:labelText a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range rdf:langString .

:identifier a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string .

:description a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string .

:createdAt a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:dateTime .

:updatedAt a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:dateTime .

:status a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string .

:version a owl:DatatypeProperty ;
    rdfs:domain :Document ;
    rdfs:range xsd:string .

:title a owl:DatatypeProperty ;
    rdfs:domain :Document ;
    rdfs:range xsd:string .

:note a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string .

:code a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string .

:latitude a owl:DatatypeProperty ;
    rdfs:domain :Place ;
    rdfs:range xsd:decimal .

:longitude a owl:DatatypeProperty ;
    rdfs:domain :Place ;
    rdfs:range xsd:decimal .

:elevation a owl:DatatypeProperty ;
    rdfs:domain :Place ;
    rdfs:range xsd:decimal .

:firstName a owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:lastName a owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:email a owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:phone a owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:affiliationName a owl:DatatypeProperty ;
    rdfs:domain :Organization ;
    rdfs:range xsd:string .

:projectName a owl:DatatypeProperty ;
    rdfs:domain :Project ;
    rdfs:range xsd:string .

:fundingAmount a owl:DatatypeProperty ;
    rdfs:domain :Project ;
    rdfs:range xsd:decimal .

:startDate a owl:DatatypeProperty ;
    rdfs:domain :Project ;
    rdfs:range xsd:date .

:endDate a owl:DatatypeProperty ;
    rdfs:domain :Project ;
    rdfs:range xsd:date .

:sampleType a owl:DatatypeProperty ;
    rdfs:domain :Sample ;
    rdfs:range xsd:string .

:sampleCode a owl:DatatypeProperty ;
    rdfs:domain :Sample ;
    rdfs:range xsd:string .

:observationValue a owl:DatatypeProperty ;
    rdfs:domain :Observation ;
    rdfs:range xsd:decimal .

:observationUnit a owl:DatatypeProperty ;
    rdfs:domain :Observation ;
    rdfs:range xsd:string .

:resultValue a owl:DatatypeProperty ;
    rdfs:domain :Result ;
    rdfs:range xsd:string .

:resultDate a owl:DatatypeProperty ;
    rdfs:domain :Result ;
    rdfs:range xsd:dateTime .

:methodName a owl:DatatypeProperty ;
    rdfs:domain :Method ;
    rdfs:range xsd:string .

:instrumentName a owl:DatatypeProperty ;
    rdfs:domain :Instrument ;
    rdfs:range xsd:string .

:parameterName a owl:DatatypeProperty ;
    rdfs:domain :Parameter ;
    rdfs:range xsd:string .

:parameterValue a owl:DatatypeProperty ;
    rdfs:domain :Parameter ;
    rdfs:range xsd:string .

:parameterUnit a owl:DatatypeProperty ;
    rdfs:domain :Parameter ;
    rdfs:range xsd:string .

:quantity a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:decimal .

:isPrimary a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:boolean .

#################################################################
# Individuals
#################################################################

:place1 a :Place ;
    :identifier "place-001" ;
    :labelText "Main Site"@en ;
    :latitude "49.123"^^xsd:decimal ;
    :longitude "8.456"^^xsd:decimal .

:person1 a :Person ;
    :identifier "person-001" ;
    :firstName "Alice" ;
    :lastName "Meyer" ;
    :email "alice@example.org" ;
    :memberOf :organization1 .

:person2 a :Person ;
    :identifier "person-002" ;
    :firstName "Bob" ;
    :lastName "Klein" ;
    :email "bob@example.org" ;
    :memberOf :organization1 .

:organization1 a :Organization ;
    :identifier "org-001" ;
    :affiliationName "AquaDiva Research Center" .

:project1 a :Project ;
    :identifier "project-001" ;
    :projectName "AquaDiva Core Study" ;
    :managedBy :organization1 ;
    :fundedBy :organization1 .

:document1 a :Document ;
    :identifier "doc-001" ;
    :title "Project Overview" ;
    :createdBy :person1 ;
    :aboutProject :project1 .

:dataset1 a :Dataset ;
    :identifier "dataset-001" ;
    :hasSample :sample1 ;
    :hasObservation :observation1 .

:sample1 a :Sample ;
    :identifier "sample-001" ;
    :sampleCode "S1" ;
    :sampleType "Water" ;
    :collectedFrom :place1 .

:method1 a :Method ;
    :identifier "method-001" ;
    :methodName "Standard Analysis" .

:instrument1 a :Instrument ;
    :identifier "instrument-001" ;
    :instrumentName "Spectrometer" .

:parameter1 a :Parameter ;
    :identifier "parameter-001" ;
    :parameterName "Temperature" ;
    :parameterValue "20" ;
    :parameterUnit "C" .

:process1 a :Process ;
    :identifier "process-001" ;
    :usesMethod :method1 ;
    :hasInstrument :instrument1 ;
    :hasParameter :parameter1 ;
    :producesResult :result1 .

:observation1 a :Observation ;
    :identifier "observation-001" ;
    :observationValue "12.5"^^xsd:decimal ;
    :observationUnit "mg/L" ;
    :observedIn :place1 .

:result1 a :Result ;
    :identifier "result-001" ;
    :resultValue "Positive" ;
    :resultDate "2026-01-01T00:00:00Z"^^xsd:dateTime .

:event1 a :Event ;
    :identifier "event-001" ;
    :hasParticipant :person1, :person2 .

# Generic additional individuals
:entity1 a :Entity ; :identifier "entity-001" ; :labelText "Generic Entity"@en .
:entity2 a :Entity ; :identifier "entity-002" ; :labelText "Another Generic Entity"@en .

#################################################################
# Axioms
#################################################################

:Person rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :memberOf ;
    owl:someValuesFrom :Organization
] .

:Project rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :managedBy ;
    owl:someValuesFrom :Organization
] .

:Document rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :createdBy ;
    owl:someValuesFrom :Person
] .

:Sample rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :collectedFrom ;
    owl:someValuesFrom :Place
] .

:Observation rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :observedIn ;
    owl:someValuesFrom :Place
] .

:Process rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :usesMethod ;
    owl:someValuesFrom :Method
] .

#################################################################
# End of ontology
#################################################################