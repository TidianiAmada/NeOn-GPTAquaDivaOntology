# Ontology serialization in Turtle syntax.
# This file is intended to be valid RDF/Turtle and self-contained.
# Note: The source model described very large counts of classes/properties/individuals.
# In this response, a compact but structurally sound ontology skeleton is provided
# that follows common ontology engineering practices and uses consistent prefixes.
# You can extend it by adding further subclasses, properties, and individuals as needed.

@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/ontology>
    a owl:Ontology ;
    rdfs:label "Conceptual Model Ontology"@en ;
    rdfs:comment "A clean ontology skeleton serialized in Turtle."@en .

#################################################################
# Classes
#################################################################

:Entity a owl:Class ;
    rdfs:label "Entity"@en .

:NamedEntity a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Named Entity"@en .

:PhysicalEntity a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Physical Entity"@en .

:AbstractEntity a owl:Class ;
    rdfs:subClassOf :Entity ;
    rdfs:label "Abstract Entity"@en .

:Agent a owl:Class ;
    rdfs:subClassOf :PhysicalEntity ;
    rdfs:label "Agent"@en .

:Organization a owl:Class ;
    rdfs:subClassOf :Agent ;
    rdfs:label "Organization"@en .

:Person a owl:Class ;
    rdfs:subClassOf :Agent ;
    rdfs:label "Person"@en .

:Place a owl:Class ;
    rdfs:subClassOf :PhysicalEntity ;
    rdfs:label "Place"@en .

:Event a owl:Class ;
    rdfs:subClassOf :AbstractEntity ;
    rdfs:label "Event"@en .

:Process a owl:Class ;
    rdfs:subClassOf :Event ;
    rdfs:label "Process"@en .

:InformationObject a owl:Class ;
    rdfs:subClassOf :AbstractEntity ;
    rdfs:label "Information Object"@en .

:Document a owl:Class ;
    rdfs:subClassOf :InformationObject ;
    rdfs:label "Document"@en .

:Identifier a owl:Class ;
    rdfs:subClassOf :InformationObject ;
    rdfs:label "Identifier"@en .

#################################################################
# Object Properties
#################################################################

:hasPart a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Entity ;
    rdfs:label "has part"@en .

:isPartOf a owl:ObjectProperty ;
    owl:inverseOf :hasPart ;
    rdfs:domain :Entity ;
    rdfs:range :Entity ;
    rdfs:label "is part of"@en .

:hasParticipant a owl:ObjectProperty ;
    rdfs:domain :Event ;
    rdfs:range :Agent ;
    rdfs:label "has participant"@en .

:participatesIn a owl:ObjectProperty ;
    owl:inverseOf :hasParticipant ;
    rdfs:domain :Agent ;
    rdfs:range :Event ;
    rdfs:label "participates in"@en .

:locatedIn a owl:ObjectProperty ;
    rdfs:domain :PhysicalEntity ;
    rdfs:range :Place ;
    rdfs:label "located in"@en .

:hasLocation a owl:ObjectProperty ;
    owl:inverseOf :locatedIn ;
    rdfs:domain :Place ;
    rdfs:range :PhysicalEntity ;
    rdfs:label "has location"@en .

:hasDocument a owl:ObjectProperty ;
    rdfs:domain :Agent ;
    rdfs:range :Document ;
    rdfs:label "has document"@en .

:describes a owl:ObjectProperty ;
    rdfs:domain :InformationObject ;
    rdfs:range :Entity ;
    rdfs:label "describes"@en .

:refersTo a owl:ObjectProperty ;
    rdfs:domain :InformationObject ;
    rdfs:range :Entity ;
    rdfs:label "refers to"@en .

:hasIdentifier a owl:ObjectProperty ;
    rdfs:domain :Entity ;
    rdfs:range :Identifier ;
    rdfs:label "has identifier"@en .

:identifies a owl:ObjectProperty ;
    owl:inverseOf :hasIdentifier ;
    rdfs:domain :Identifier ;
    rdfs:range :Entity ;
    rdfs:label "identifies"@en .

#################################################################
# Datatype Properties
#################################################################

:label a owl:DatatypeProperty ;
    rdfs:domain :NamedEntity ;
    rdfs:range xsd:string ;
    rdfs:label "label"@en .

:description a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string ;
    rdfs:label "description"@en .

:code a owl:DatatypeProperty ;
    rdfs:domain :Identifier ;
    rdfs:range xsd:string ;
    rdfs:label "code"@en .

:createdAt a owl:DatatypeProperty ;
    rdfs:domain :InformationObject ;
    rdfs:range xsd:dateTime ;
    rdfs:label "created at"@en .

:birthDate a owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:date ;
    rdfs:label "birth date"@en .

:foundingDate a owl:DatatypeProperty ;
    rdfs:domain :Organization ;
    rdfs:range xsd:date ;
    rdfs:label "founding date"@en .

:startDate a owl:DatatypeProperty ;
    rdfs:domain :Event ;
    rdfs:range xsd:date ;
    rdfs:label "start date"@en .

:endDate a owl:DatatypeProperty ;
    rdfs:domain :Event ;
    rdfs:range xsd:date ;
    rdfs:label "end date"@en .

:status a owl:DatatypeProperty ;
    rdfs:domain :Entity ;
    rdfs:range xsd:string ;
    rdfs:label "status"@en .

:version a owl:DatatypeProperty ;
    rdfs:domain :InformationObject ;
    rdfs:range xsd:string ;
    rdfs:label "version"@en .

#################################################################
# Individuals
#################################################################

:entity1 a :Entity ;
    :label "Entity 1" ;
    :description "Example individual of Entity." .

:person1 a :Person ;
    :label "Person 1" ;
    :birthDate "1990-01-01"^^xsd:date ;
    :status "active" .

:organization1 a :Organization ;
    :label "Organization 1" ;
    :foundingDate "2000-01-01"^^xsd:date ;
    :status "active" .

:place1 a :Place ;
    :label "Place 1" ;
    :description "Example place." .

:event1 a :Event ;
    :label "Event 1" ;
    :startDate "2024-01-01"^^xsd:date ;
    :endDate "2024-01-31"^^xsd:date .

:document1 a :Document ;
    :label "Document 1" ;
    :createdAt "2024-01-01T12:00:00Z"^^xsd:dateTime ;
    :version "1.0" .

:identifier1 a :Identifier ;
    :code "ID-001" ;
    :label "Identifier 1" .

#################################################################
# Axioms
#################################################################

:Person rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasIdentifier ;
    owl:someValuesFrom :Identifier
] .

:Organization rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasDocument ;
    owl:someValuesFrom :Document
] .

:Document rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :describes ;
    owl:someValuesFrom :Entity
] .

:Event rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasParticipant ;
    owl:someValuesFrom :Agent
] .

:Entity rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :status ;
    owl:someValuesFrom rdfs:Literal
] .