# New transitive object property declarations added for the ontology.
# These triples are intended to be merged with the existing ontology.
# Only new triples are included, in valid Turtle syntax.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://example.org/ontology#> .

:hasAncestor a owl:ObjectProperty, owl:TransitiveProperty .
:isAncestorOf a owl:ObjectProperty, owl:TransitiveProperty .
:partOf a owl:ObjectProperty, owl:TransitiveProperty .
:containsPart a owl:ObjectProperty, owl:TransitiveProperty .
:subClassOfRelation a owl:ObjectProperty, owl:TransitiveProperty .
:broaderThan a owl:ObjectProperty, owl:TransitiveProperty .
:narrowerThan a owl:ObjectProperty, owl:TransitiveProperty .
:locatedIn a owl:ObjectProperty, owl:TransitiveProperty .
:hasLocation a owl:ObjectProperty, owl:TransitiveProperty .
:hasMember a owl:ObjectProperty, owl:TransitiveProperty .
:isMemberOf a owl:ObjectProperty, owl:TransitiveProperty .
:causes a owl:ObjectProperty, owl:TransitiveProperty .
:isCausedBy a owl:ObjectProperty, owl:TransitiveProperty .