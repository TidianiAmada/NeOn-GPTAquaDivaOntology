# Transitive object properties added for the ontology.
# New transitive property axioms only; intended to be merged with the existing ontology.
# All listed properties are declared as owl:TransitiveProperty where appropriate.

@prefix : <http://example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

:hasAncestor a owl:TransitiveProperty .
:isPartOf a owl:TransitiveProperty .
:contains a owl:TransitiveProperty .
:hasSubEvent a owl:TransitiveProperty .
:hasSubProcess a owl:TransitiveProperty .
:hasBroaderTerm a owl:TransitiveProperty .
:hasMember a owl:TransitiveProperty .
:hasComponent a owl:TransitiveProperty .
:hasParent a owl:TransitiveProperty .
:hasPredecessor a owl:TransitiveProperty .