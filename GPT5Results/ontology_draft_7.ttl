# Generated inverse object properties for the ontology.
# Only new triples are included below.
# Ensure these inverses are merged with the existing ontology.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix : <http://example.org/ontology#> .

:isPartOf owl:inverseOf :hasPart .
:isLocatedIn owl:inverseOf :hasLocation .
