:isConnectedTo owl:inverseOf :connectsTo .
:isEnrolledIn owl:inverseOf :enrollsIn .
:isAssignedTo owl:inverseOf :assignsTo .
:isSupervisedBy owl:inverseOf :supervises .
:isReviewedBy owl:inverseOf :reviews .
:isApprovedBy owl:inverseOf :approves .
:isControlledBy owl:inverseOf :controls .
:isDerivedFrom owl:inverseOf :derivesFrom .
:isInfluencedBy owl:inverseOf :influences .
