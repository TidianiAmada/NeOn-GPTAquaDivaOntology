# AquaDiva Ontology (Version 1) - Turtle serialization
# This ontology extends the AquaDiva domain with classes, object properties, datatype properties, and individuals to support the listed competency questions.
# It includes labels for all named classes/individuals to satisfy validation constraints and preserves a large subclass hierarchy to reflect the requested ontology scale.
# The ontology is intentionally modular and domain-focused on aquifers, microbes, fungi, hydrochemistry, geological settings, hydrological processes, contamination, and sampling/analysis methods.

@prefix aq: <http://example.org/aquadiva#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aq:AquaDivaOntology a owl:Ontology ;
    rdfs:label "AquaDiva Ontology"@en ;
    rdfs:comment "Ontology for subsurface aquatic ecosystems, groundwater microbiology, hydrochemistry, geology, and environmental drivers."@en .

aq:Entity a owl:Class ;
    rdfs:label "Entity"@en .

aq:NaturalEntity a owl:Class ;
    rdfs:subClassOf aq:Entity ;
    rdfs:label "Natural Entity"@en .

aq:LivingEntity a owl:Class ;
    rdfs:subClassOf aq:NaturalEntity ;
    rdfs:label "Living Entity"@en .

aq:NonLivingEntity a owl:Class ;
