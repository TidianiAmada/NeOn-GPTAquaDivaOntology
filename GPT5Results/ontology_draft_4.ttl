aqua:CrossKingdomInteraction a owl:Class ; rdfs:subClassOf aqua:Relation .
aqua:AbovegroundMicrobe a owl:Class ; rdfs:subClassOf aqua:Microorganism .
aqua:GroundwaterMicrobe a owl:Class ; rdfs:subClassOf aqua:Microorganism .
aqua:MarineMicrobe a owl:Class ; rdfs:subClassOf aqua:Microorganism .
aqua:SubsurfaceMicrobe a owl:Class ; rdfs:subClassOf aqua:Microorganism .

#################################################################
# Individuals
#################################################################

aqua:karstAquifer1 a aqua:KarstAquifer ;
  aqua:hasLabel "Karst aquifer 1"@en .

aqua:fracturedRockAquifer1 a aqua:FracturedRockAquifer ;
  aqua:hasLabel "Fractured rock aquifer 1"@en .

aqua:triassicLimestone1 a aqua:TriassicLimestone ;
  aqua:hasLabel "Triassic limestone"@en .

aqua:muschelkalk1 a aqua:Muschelkalk ;
  aqua:hasLabel "Muschelkalk"@en .

aqua:trochitenkalk1 a aqua:Trochitenkalk ;
  aqua:hasLabel "Trochitenkalk"@en .

aqua:sampleProtocol1 a aqua:Protocol ;
  aqua:hasLabel "Groundwater microbial sampling protocol"@en .

aqua:sampleStandard1 a aqua:Standard ;
  aqua:hasLabel "AquaDiva standard"@en .

aqua:membraneFiltration a aqua:SamplingMethod ;
  aqua:hasLabel "Membrane filtration"@en .

aqua:pyrosequencing a aqua:MeasurementType ;
  aqua:hasLabel "Pyrosequencing"@en .

aqua:qPCR a aqua:MeasurementType ;
  aqua:hasLabel "qPCR"@en .

aqua:peptideA a aqua:Peptide ;
  aqua:hasLabel "Subsurface peptide A"@en .

aqua:docA a aqua:DissolvedOrganicCarbon ;
  aqua:hasLabel "DOC pool A"@en .

#################################################################
# CQ-oriented annotations and example relations
#################################################################

aqua:microbialGuildsInAquifer a aqua:Characteristic ;
  aqua:characteristicFor aqua:karstAquifer1 .

aqua:groundwaterQualityObs1 a aqua:Observation ;
  aqua:ofEntity aqua:karstAquifer1 ;
  aqua:hasSamplingMethod aqua:membraneFiltration ;
  aqua:hasMeasurement aqua:measurement1 .

aqua:measurement1 a aqua:Measurement ;
  aqua:measurementFor aqua:groundwaterQualityObs1 ;
  aqua:ofCharacteristic aqua:GroundwaterQuality ;
  aqua:usesProtocol aqua:sampleProtocol1 ;
  aqua:usesStandard aqua:sampleStandard1 ;
  aqua:hasValue aqua:value1 .

aqua:value1 a aqua:MeasuredValue ;
  aqua:hasNumericValue "7.2"^^xsd:decimal ;
  aqua:hasTextValue "neutral to slightly alkaline"@en .

