aqua:Observation a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:ObservationCollection a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:Relation a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:ObservedRelation a owl:Class ;
  rdfs:subClassOf aqua:Relation .

aqua:Protocol a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:Standard a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:Unit a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:BaseUnit a owl:Class ;
  rdfs:subClassOf aqua:Unit .

aqua:DerivedUnit a owl:Class ;
  rdfs:subClassOf aqua:Unit .

aqua:PrefixedUnit a owl:Class ;
  rdfs:subClassOf aqua:Unit .

aqua:CompositeUnit a owl:Class ;
  rdfs:subClassOf aqua:Unit .

aqua:UnitConversion a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:SamplingMethod a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:PhysicochemicalParameter a owl:Class ;
  rdfs:subClassOf aqua:Characteristic .

aqua:HydraulicProperty a owl:Class ;
  rdfs:subClassOf aqua:Characteristic .

aqua:GeologicalFormation a owl:Class ;
  rdfs:subClassOf aqua:PhysicalEntity .

aqua:Lithology a owl:Class ;
  rdfs:subClassOf aqua:GeologicalFormation .

aqua:TriassicLimestone a owl:Class ;
  rdfs:subClassOf aqua:Lithology .

aqua:Muschelkalk a owl:Class ;
  rdfs:subClassOf aqua:TriassicLimestone .

aqua:Trochitenkalk a owl:Class ;
  rdfs:subClassOf aqua:TriassicLimestone .

aqua:FracturedRockFormation a owl:Class ;
