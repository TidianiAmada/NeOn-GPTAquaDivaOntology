# AquaDiva Ontology (expanded)
# This Turtle file encodes entities, properties, and competency-question-driven schema elements
# for the AquaDiva domain, including aquifers, groundwater, hydrochemistry, microbes, fungi,
# geology, agriculture, climate, contamination, transport, and biogeochemical processes.
# The ontology is intentionally rich in subclass structure to align with the requested metrics.
# No imports are required for parsing; all terms are locally declared in the AquaDiva namespace.

@prefix : <http://purl.org/aquadiva/ontology#> .
@prefix aqua: <http://purl.org/aquadiva/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aqua:Ontology a owl:Ontology ;
  rdfs:label "AquaDiva Ontology"@en ;
  rdfs:comment "Ontology for groundwater, aquifer microbiology, hydrochemistry, geology, and environmental drivers."@en .

#################################################################
# Core top-level classes
#################################################################

aqua:Entity a owl:Class ;
  rdfs:label "Entity"@en .

aqua:PhysicalEntity a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:MaterialEntity a owl:Class ;
  rdfs:subClassOf aqua:PhysicalEntity .

aqua:Organism a owl:Class ;
  rdfs:subClassOf aqua:PhysicalEntity .

aqua:Microorganism a owl:Class ;
  rdfs:subClassOf aqua:Organism .

aqua:Bacterium a owl:Class ;
  rdfs:subClassOf aqua:Microorganism .

aqua:Archaea a owl:Class ;
  rdfs:subClassOf aqua:Microorganism .

aqua:Fungus a owl:Class ;
  rdfs:subClassOf aqua:Microorganism .

aqua:MicrobialGuild a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:Eukaryote a owl:Class ;
  rdfs:subClassOf aqua:Organism .

aqua:Protist a owl:Class ;
  rdfs:subClassOf aqua:Eukaryote .

aqua:Nematode a owl:Class ;
  rdfs:subClassOf aqua:Eukaryote .

aqua:AquaticFungus a owl:Class ;
  rdfs:subClassOf aqua:Fungus .

aqua:Aquifer a owl:Class ;
  rdfs:subClassOf aqua:PhysicalEntity .

aqua:KarstAquifer a owl:Class ;
  rdfs:subClassOf aqua:Aquifer .

aqua:FracturedRockAquifer a owl:Class ;
  rdfs:subClassOf aqua:Aquifer .

aqua:UpperAquifer a owl:Class ;
  rdfs:subClassOf aqua:Aquifer .

aqua:LowerAquifer a owl:Class ;
  rdfs:subClassOf aqua:Aquifer .

aqua:SubsurfaceHabitat a owl:Class ;
  rdfs:subClassOf aqua:PhysicalEntity .

aqua:Groundwater a owl:Class ;
  rdfs:subClassOf aqua:MaterialEntity .

aqua:WaterBody a owl:Class ;
  rdfs:subClassOf aqua:MaterialEntity .

aqua:Colloid a owl:Class ;
  rdfs:subClassOf aqua:MaterialEntity .

aqua:Biocolloid a owl:Class ;
  rdfs:subClassOf aqua:Colloid .

aqua:AquaticColloid a owl:Class ;
  rdfs:subClassOf aqua:Colloid .

aqua:Mineral a owl:Class ;
  rdfs:subClassOf aqua:MaterialEntity .

aqua:OrganicMatter a owl:Class ;
  rdfs:subClassOf aqua:MaterialEntity .

aqua:DissolvedOrganicCarbon a owl:Class ;
  rdfs:subClassOf aqua:OrganicMatter .

aqua:Peptide a owl:Class ;
  rdfs:subClassOf aqua:OrganicMatter .

aqua:Substrate a owl:Class ;
  rdfs:subClassOf aqua:MaterialEntity .

aqua:ChemicalSignal a owl:Class ;
  rdfs:subClassOf aqua:MaterialEntity .

aqua:SurfaceChemicalSignal a owl:Class ;
  rdfs:subClassOf aqua:ChemicalSignal .

aqua:SubsurfaceChemicalSignal a owl:Class ;
  rdfs:subClassOf aqua:ChemicalSignal .

aqua:EnvironmentalSetting a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:Hydrochemistry a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:Geochemistry a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:BiogeochemicalProcess a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:Process a owl:Class ;
  rdfs:subClassOf aqua:Entity .

aqua:Measurement a owl:Class ;
