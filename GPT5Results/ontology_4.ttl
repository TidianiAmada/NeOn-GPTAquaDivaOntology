ex:karst_aquifer_1 a aq:KarstAquifer ;
    aq:hasBiogeochemicalProcess ex:process_carbon_fixation,
        ex:process_denitrification ;
    aq:hasClimateDriver ex:precipitation_event_1 ;
    aq:hasGeologicalSetting ex:triassic_limestone ;
    aq:hasHydrochemicalParameter ex:param_doc,
        ex:param_oxygen,
        ex:param_ph ;
    aq:hasName "Karst aquifer 1" ;
    aq:hasRechargeProcess ex:recharge_1 ;
    aq:hasSamplingMethod ex:method_metagenomics .

ex:param_doc a aq:DissolvedOrganicCarbon ;
    aq:hasUnit "mg/L" ;
    aq:hasValue 2.3 .

ex:param_oxygen a aq:OxygenContent ;
    aq:hasUnit "mg/L" ;
    aq:hasValue 1.5 .

ex:param_ph a aq:pH ;
    aq:hasUnit "pH" ;
    aq:hasValue 7.2 .

